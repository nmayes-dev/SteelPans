@inherits LayoutComponentBase
@inject KeyboardManagerService KeyboardManager
@inject IJSRuntime JS

<div class="page">
    <main>
        <article class="content">
            @Body
        </article>
    </main>
</div>

<div id="blazor-error-ui" data-nosnippet>
    An unhandled error has occurred.
    <a href="." class="reload">Reload</a>
    <span class="dismiss">🗙</span>
</div>

@code {

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender)
            return;

        await LogInitialConnectionAsync();
        await KeyboardManager.InitializeAsync();
    }

    private async Task LogInitialConnectionAsync()
    {
        var details = await JS.InvokeAsync<ConnectionDetails>(
            "diagnostics.logInitialConnection");

        Console.WriteLine(System.Text.Json.JsonSerializer.Serialize(details));
    }
}