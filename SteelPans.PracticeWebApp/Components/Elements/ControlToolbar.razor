@inject MidiPlaybackService Playback
@inject MidiLoaderService MidiService
@inject NavigationManager Nav
@inject DbService Db
@inject IOptions<Settings> SettingsAccessor
@inject IJSRuntime JS

<Toolbar MenuButtonLabel="Open Tools"
         MenuLabel="Pan Tools"
         Side="Toolbar.ToolbarSide.Right">

    <ToolbarElement Text="Account">
        <SubMenu>
            <AuthorizeView>
                <Authorized>
                    <ToolbarElement Text="Profile"
                                    IconClass="bi-person"
                                    OnClick="NavigateToProfile" />
                    <ToolbarElement Text="Logout"
                                    IconClass="bi-box-arrow-right"
                                    OnClick="() => logoutModal_!.OpenAsync()" />
                    <Logout @ref="logoutModal_" />
                </Authorized>
                <NotAuthorized>
                    <ToolbarElement Text="Login"
                                    IconClass="bi-box-arrow-in-right"
                                    OnClick="NavigateToLogin" />
                    <ToolbarElement Text="Register"
                                    IconClass="bi-person-plus"
                                    OnClick="NavigateToRegister" />
                </NotAuthorized>
            </AuthorizeView>
        </SubMenu>
    </ToolbarElement>

    <ToolbarElement Text="Import">
        <SubMenu>
            <ToolbarElement Text="MIDI File"
                            IconClass="bi-file-earmark-music"
                            LabelFor="midi-file-input" />

            <InputFile id="midi-file-input"
                       class="pans__file-input"
                       OnChange="OnMidiFilesChangedAsync"
                       multiple
                       accept=".mid,.midi,audio/midi,audio/x-midi" />

            <AuthorizeView>
                <Authorized>
                    @if (Groups.Any(x => x.Value.Count > 0))
                    {
                        <ToolbarElement Text="Ensemble"
                                        IconClass="bi-collection">
                            <SubMenu>
                                @foreach (var (group, files) in Groups.Where(x => x.Value.Count > 0))
                                {
                                    <ToolbarElement Text="@group.Name"
                                                    IconClass="bi-people">
                                        <ChildContent>
                                            <div class="pans-page__track-panel">
                                                <div class="pans-page__track-panel-header">
                                                    <span class="pans-page__track-panel-title">Ensemble Files</span>
                                                    <span class="pans-page__track-panel-count">@files.Count file@(files.Count == 1 ? "" : "s")</span>
                                                </div>

                                                <div class="pans-page__track-list">
                                                    @foreach (var file in files)
                                                    {
                                                        <div class="pans-page__track-item">
                                                            <div class="pans-page__track-details">
                                                                <div class="pans-page__track-name">@file.Title</div>
                                                                <div class="pans-page__track-meta">@file.OriginalFileName</div>
                                                            </div>

                                                            <button type="button"
                                                                    class="pans-page__track-button"
                                                                    aria-label="Load File"
                                                                    @onclick="() => LoadLeaderMidiFileAsync(file)">
                                                                <span class="bi bi-download" aria-hidden="true"></span>
                                                            </button>
                                                        </div>
                                                    }
                                                </div>
                                            </div>
                                        </ChildContent>
                                    </ToolbarElement>
                                }
                            </SubMenu>
                        </ToolbarElement>
                    }
                </Authorized>
            </AuthorizeView>

            @if (Playback.IsMidiLoaded)
            {
                <ToolbarElement Text="Tracks"
                                IconClass="bi-music-note-list"
                                Disabled="@(!Playback.Tracks.Any())"
                                CanExpand="true">
                    <ChildContent>
                        <div class="pans-page__track-panel">
                            <div class="pans-page__track-panel-header">
                                <span class="pans-page__track-panel-title">@Playback.IsMidiLoaded</span>
                                <span class="pans-page__track-panel-count">@Playback.Tracks.Count track@(Playback.Tracks.Count == 1 ? "" : "s")</span>
                            </div>

                            <div class="pans-page__track-list">
                                @foreach (var track in Playback.Tracks)
                                {
                                    <div class="pans-page__track-item">
                                        <div class="pans-page__track-details">
                                            <div class="pans-page__track-name">@track.Index) @track.DisplayInfo</div>
                                            <div class="pans-page__track-meta">@GetMetaInfo(track)</div>
                                        </div>

                                        <button type="button"
                                                class="pans-page__track-button @(IsTrackAssigned(track) ? "pans-page__track-button--assigned" : null)"
                                                aria-label="@(IsTrackAssigned(track) ? "Remove Track" : "Add Track")"
                                                @onclick="() => OnTrackButtonPressedAsync(track)">
                                            <span class="bi @(IsTrackAssigned(track) ? "bi-dash-lg" : "bi-plus-lg")" aria-hidden="true"></span>
                                        </button>
                                    </div>
                                }
                            </div>
                        </div>
                    </ChildContent>
                </ToolbarElement>
            }
        </SubMenu>
    </ToolbarElement>

    @if (Playback.IsMidiLoaded)
    {
        <ToolbarElement Text="Layout">
            <SubMenu>
                <ToolbarElement Text="Add Pan"
                                IconClass="bi-plus-lg"
                                OnClick="() => addPanModal_!.Open()" />

                <ToolbarElement Text="Load"
                                IconClass="bi-folder2-open"
                                Disabled="!Playback.IsMidiLoaded"
                                LabelFor="layout-file-input" />

                <InputFile id="layout-file-input"
                           class="pans__file-input"
                           OnChange="OnLoadConfigurationFileAsync"
                           accept=".pans" />

                <ToolbarElement Text="Save"
                                IconClass="bi-floppy"
                                Disabled="@(string.IsNullOrWhiteSpace(lastFileName_) || !Playback.IsMidiLoaded || !Playback.ActivePans.Any())"
                                OnClick="() => SaveConfigurationFileAsync(lastFileName_!)" />

                <ToolbarElement Text="Save As..."
                                IconClass="bi-floppy2"
                                Disabled="@(!Playback.IsMidiLoaded || !Playback.ActivePans.Any())"
                                OnClick="() => saveModal_!.Open()" />
            </SubMenu>
        </ToolbarElement>
    }

    @if (Playback.ActivePans.Any())
    {
        <ToolbarElement Text="Music">
            <SubMenu>
                <ToolbarElement Text="Mixer"
                                IconClass="bi-sliders2-vertical"
                                Disabled="@(!Playback.ActivePans.Any())"
                                CanExpand="true"
                                CanMoveExpanded="true">
                    <ChildContent>
                        <VolumeMixer />
                    </ChildContent>
                </ToolbarElement>
                <ToolbarElement Text="Metronome"
                                IconClass="bi-music-note-beamed">
                    <HeaderActions>
                        <label class="metronome-shell__status-switch">
                            <input class="metronome-shell__status-switch-input"
                                   type="checkbox"
                                   checked="@Playback.ClickTrackEnabled"
                                   @onchange="OnClickTrackEnabledShellChangedAsync"
                                   @onclick:stopPropagation="true"
                                   aria-label="Enable metronome" />

                            <span class="metronome-shell__status-switch-track" aria-hidden="true">
                                <span class="metronome-shell__status-switch-thumb"></span>
                            </span>
                        </label>
                    </HeaderActions>
                    <ChildContent>
                        <Metronome />
                    </ChildContent>
                </ToolbarElement>

                <ToolbarElement Text="Chords"
                                IconClass="bi-music-note-list">
                    <ChildContent>
                        <ChordBuilder />
                    </ChildContent>
                </ToolbarElement>
            </SubMenu>
        </ToolbarElement>
    }
</Toolbar>

<AddPanModal @ref="addPanModal_"
             Pans="@Pans"
             Tracks="@Playback.Tracks" />
             
<Logout @ref="logoutModal_" />


<FileSaveModal @ref="saveModal_"
               LastFileName="@lastFileName_"
               OnSave="SaveConfigurationFileAsync" />

               
<ModalPopup @ref="warningModal_"
            Title="Loading Layout For Different MIDI"
            ShowCloseButton="false"
            OnEnter="ConfirmLoadConfigurationAsync">
    <Actions>
        <button type="button"
                class="btn btn-outline-secondary"
                @onclick="CancelLoadConfigurationAsync">
            Cancel
        </button>

        <button type="button"
                class="btn btn-danger"
                @onclick="ConfirmLoadConfigurationAsync">
            Confirm
        </button>
    </Actions>
</ModalPopup>



<ModalPopup @ref="addMergedTrackModal_"
            Title="Merge MIDI tracks"
            OnClose="CloseMergeMidiModal"
            OnEnter="ConfirmMergeMidiAsync">
    <ChildContent>
        <input class="pans-page__track_name form-control"
               placeholder="Enter merged track name..."
               @bind="mergeMidiFileName_"
               @bind:event="oninput" />
    </ChildContent>

    <Actions>
        <button type="button"
                class="btn btn-outline-secondary"
                @onclick="CloseMergeMidiModal">
            Cancel
        </button>

        <button type="button"
                class="btn btn-primary"
                disabled="@string.IsNullOrWhiteSpace(mergeMidiFileName_)"
                @onclick="ConfirmMergeMidiAsync">
            Merge
        </button>
    </Actions>
</ModalPopup>

@{
    var removeTitle = panPendingRemoval_ is not null
        ? $"Remove {panPendingRemoval_.Pan.Type.ToSpacedPascal()}?"
        : "Remove Pan?";

    <ModalPopup @ref="removePanModal_"
                Title="@removeTitle"
                ShowCloseButton="false"
                OnEnter="ConfirmRemovePanAsync">
        <Actions>
            <button type="button"
                    class="btn btn-outline-secondary"
                    @onclick="CloseRemovePanModal">
                Cancel
            </button>

            <button type="button"
                    class="btn btn-danger"
                    disabled="@(panPendingRemoval_ is null)"
                    @onclick="ConfirmRemovePanAsync">
                Remove
            </button>
        </Actions>
    </ModalPopup>
}


    @code {
    [Parameter]
    public required string MidiFileName { get; set; }

    [Parameter]
    public required IReadOnlyList<SteelPan> Pans { get; set; }

    [Parameter]
    public required IReadOnlyDictionary<GroupSummaryDto, IReadOnlyList<GroupFileDto>> Groups { get; set; }

    [Parameter]
    public required string Error { get; set; }


    private const long MaxMidiFileSize = 64L * 1024L * 1024L;

    private Settings Settings => SettingsAccessor.Value;

    private AddPanModal? addPanModal_;
    private Logout? logoutModal_;

    private string? lastFileName_;
    private FileSaveModal? saveModal_;

    private ModalPopup? warningModal_;
    private Configuration? pendingLoadConfiguration_;

    private ModalPopup? removePanModal_;
    private MidiAssignedPan? panPendingRemoval_;

    private ModalPopup? addMergedTrackModal_;
    private string mergeMidiFileName_ = string.Empty;
    private IReadOnlyList<BrowserDialogFile> pendingMergeMidiFiles_ = [];

    public async Task OpenRemovePanModalAsync(MidiAssignedPan pan)
    {
        if (removePanModal_ is null)
            return;

        panPendingRemoval_ = pan;
        await removePanModal_.OpenAsync();
    }



    private sealed class BrowserDialogFile
    {
        public string Name { get; set; } = string.Empty;
        public long Size { get; set; }
        public IBrowserFile? File { get; set; }
    }



    private void NavigateToLogin()
    {
        Nav.NavigateTo("/account/login", forceLoad: true);
    }
    private void NavigateToRegister()
    {
        Nav.NavigateTo("/account/register", forceLoad: true);
    }
    private void NavigateToProfile()
    {
        Nav.NavigateTo("/account/profile");
    }

    

    private async Task OnLoadConfigurationFileAsync(InputFileChangeEventArgs e)
    {
        try
        {
            Error = string.Empty;

            var file = e.File;

            await using var stream = file.OpenReadStream(
                maxAllowedSize: 1024 * 1024);

            var result = await JsonSerializer.DeserializeAsync<Configuration>(
                stream,
                new JsonSerializerOptions
                {
                    PropertyNameCaseInsensitive = true
                });

            if (result is null)
                return;

            if (result.Version != Settings.LayoutFileVersion)
            {
                Error = "Incompatible layout file version.";
                return;
            }

            if (!string.Equals(result.MidiFile, MidiFileName, StringComparison.OrdinalIgnoreCase))
            {
                pendingLoadConfiguration_ = result;
                await warningModal_!.OpenAsync();
                return;
            }

            await LoadPanLayoutAsync(result.Layout);
        }
        catch (Exception)
        {
            Error = "An error occurred loading this file.";
        }
    }

    private async Task CancelLoadConfigurationAsync()
    {
        pendingLoadConfiguration_ = null;
        await warningModal_!.RequestCloseAsync();
    }

    private async Task ConfirmLoadConfigurationAsync()
    {
        if (pendingLoadConfiguration_ is null)
            return;

        await warningModal_!.RequestCloseAsync();
        await LoadPanLayoutAsync(pendingLoadConfiguration_.Layout);
        pendingLoadConfiguration_ = null;
    }

    private async Task LoadPanLayoutAsync(List<ConfigurationPan> layout)
    {
        await Playback.OnClearAssignmentsAsync();

        foreach (var pan in layout)
        {
            var track = Playback.Tracks.Where(t => t.Index == pan.Track).FirstOrDefault();
            if (track is not null)
            {
                var assignment = new MidiTrackAssignment
                {
                    AssignedPanType = pan.Pan,
                    Track = track,
                };

                await Playback.OnAddAssignmentAsync(assignment, Pans);
            }
        }
    }


    private async Task SaveConfigurationFileAsync(string fileName)
    {
        var configuration = new Configuration
        {
            Version = Settings.Version,
            MidiFile = MidiFileName,
            Layout = Playback.Assignments.Select(a => new ConfigurationPan
            {
                Pan = a.AssignedPanType,
                Track = a.Track?.Index ?? -1,
            }).ToList()
        };

        try
        {
            var json = JsonSerializer.Serialize(configuration, new JsonSerializerOptions
            {
                WriteIndented = true
            });

            await JS.InvokeVoidAsync(
                "fileHandling.submitDownloadForm",
                "/api/download",
                fileName,
                json,
                "application/json;charset=utf-8");

            lastFileName_ = fileName;
        }
        catch (Exception)
        {
            Error = "An error occurred saving this file.";
        }
    }

    

    private async Task CloseRemovePanModal()
    {
        if (removePanModal_ is null)
            return;

        panPendingRemoval_ = null;
        await removePanModal_.RequestCloseAsync();
    }

    private async Task ConfirmRemovePanAsync()
    {
        if (panPendingRemoval_ is null)
            return;

        var index = panPendingRemoval_.Assignment.Track?.Index ?? -1;

        await CloseRemovePanModal();
        await Playback.OnRemoveAssignmentAsync(index);
    }

    private async Task OnTrackButtonPressedAsync(MidiTrackInfo track)
    {
        if (IsTrackAssigned(track))
        {
            if (removePanModal_ is null)
            {
                await Playback.OnRemoveAssignmentAsync(track.Index);
                return;
            }

            panPendingRemoval_ = Playback.ActivePans.First(a => a.Assignment.Track?.Index == track.Index);
            await removePanModal_.OpenAsync(closeOthers: false);
            return;

        }

        if (addPanModal_ is not null)
            await addPanModal_.Open(track.Index);
    }


    private async Task OnMidiFileSelected(Func<Task<MidiFile>> getMidiFile)
    {
        await Playback.OnLoadMidiAsync(getMidiFile);
    }
    
    private async Task OnMidiFilesChangedAsync(InputFileChangeEventArgs e)
    {
        try
        {
            Error = string.Empty;

            var files = e.GetMultipleFiles()
                .Select(file => new BrowserDialogFile
                {
                    Name = file.Name,
                    Size = file.Size,
                    File = file
                })
                .ToList();

            if (files.Count == 0)
                return;

            if (files.Count == 1)
            {
                await OnSingleMidiSelectedAsync(files[0]);
                return;
            }

            await OnMultipleMidiSelectedAsync(files);
        }
        catch (Exception)
        {
            Error = "An error occurred loading this MIDI file.";
        }
    }

    
    private Task CloseMergeMidiModal()
    {
        mergeMidiFileName_ = string.Empty;
        pendingMergeMidiFiles_ = [];
        return Task.CompletedTask;
    }

    private async Task ConfirmMergeMidiAsync()
    {
        if (pendingMergeMidiFiles_.Count == 0 || addMergedTrackModal_ is null)
            return;

        MidiFileName = $"{mergeMidiFileName_.Trim()}.mid";

        var loadTracks = async () =>
        {
            var files = new List<(string Name, Stream Stream)>();

            try
            {
                foreach (var file in pendingMergeMidiFiles_)
                {
                    if (file.File is null)
                        continue;

                    var stream = file.File.OpenReadStream(MaxMidiFileSize);
                    files.Add((file.Name, stream));
                }

                return await MidiService.MergeMidiTracksAsync(MidiFileName, files);
            }
            finally
            {
                foreach (var (_, stream) in files)
                {
                    await stream.DisposeAsync();
                }
            }
        };

        await OnMidiFileSelected(loadTracks);
        await addMergedTrackModal_.RequestCloseAsync();

        pendingMergeMidiFiles_ = [];
        mergeMidiFileName_ = string.Empty;
    }

    private async Task OnMultipleMidiSelectedAsync(IReadOnlyList<BrowserDialogFile> files)
    {
        if (addMergedTrackModal_ is null)
            return;

        pendingMergeMidiFiles_ = files;
        await addMergedTrackModal_.OpenAsync();
    }

    private async Task OnSingleMidiSelectedAsync(BrowserDialogFile file)
    {
        if (file.File is null)
            return;

        MidiFileName = file.Name;
        await OnMidiFileSelected(async () =>
        {
            await using var stream = file.File.OpenReadStream(MaxMidiFileSize);
            return await MidiService.OpenMidiFileAsync(stream);
        });
    }

    private async Task LoadLeaderMidiFileAsync(GroupFileDto file)
    {
        Error = string.Empty;

        try
        {
            var details = await Db.MidiFiles.GetMidiFileDetailsAsync(file.Id);
            var download = await Db.MidiFiles.OpenMidiFileAsync(file.Id);

            if (details is null || download is null)
            {
                Error = "MIDI file was not found.";
                return;
            }

            await using var stream = download.Stream;

            MidiFileName = download.FileName;

            await OnMidiFileSelected(async () =>
            {
                return await MidiService.OpenMidiFileAsync(stream);
            });

            await LoadLeaderAssignmentsAsync(details.Assignments);
        }
        catch (UnauthorizedAccessException)
        {
            Error = "You do not have access to this MIDI file.";
        }
        catch (Exception)
        {
            Error = "An error occurred loading this group MIDI file.";
        }
    }

    private async Task LoadLeaderAssignmentsAsync(
        IReadOnlyList<MidiTrackAssignmentDto> assignments)
    {
        await Playback.OnClearAssignmentsAsync();

        foreach (var savedAssignment in assignments.Where(x => x.PanType != PanType.None))
        {
            var track = Playback.Tracks.FirstOrDefault(
                x => x.Index == savedAssignment.TrackIndex);

            if (track is null)
                continue;

            var assignment = new MidiTrackAssignment
            {
                AssignedPanType = savedAssignment.PanType,
                Track = track
            };

            await Playback.OnAddAssignmentAsync(assignment, Pans);
        }
    }

    

    private async Task OnClickTrackEnabledShellChangedAsync(ChangeEventArgs e)
    {
        var enabled = e.Value switch
        {
            bool value => value,
            string value when bool.TryParse(value, out var parsed) => parsed,
            _ => Playback.ClickTrackEnabled
        };

        if (Playback.ClickTrackEnabled == enabled)
            return;

        await Playback.SetClickTrackEnabledAsync(enabled);
    }


    private string GetMetaInfo(MidiTrackInfo track)
    {
        return $"{track.NoteCount} note{(track.NoteCount == 1 ? "" : "s")}{(IsTrackAssigned(track) ? " - Assigned" : "")}";
    }
    private bool IsTrackAssigned(MidiTrackInfo track)
    {
        return Playback.Assignments.Any(a => a.Track?.Index == track.Index);
    }
}