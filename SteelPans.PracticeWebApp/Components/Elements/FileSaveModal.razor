<ModalPopup @ref="modal_"
            Title="Save"
            OnClose="Close"
            OnEnter="ConfirmSaveAsync">
    <ChildContent>
        <div class="file-save__body">
            <input class="form-control"
                   value="@fileName_"
                   @oninput="OnFileNameChanged"
                   placeholder="settings.pans" />

            @if (!string.IsNullOrWhiteSpace(error_))
            {
                <div class="file-save__error">@error_</div>
            }
        </div>
    </ChildContent>

    <Actions>
        <button type="button"
                class="btn btn-outline-secondary"
                @onclick="Close">
            Cancel
        </button>

        <button type="button"
                class="btn btn-primary"
                disabled="@(!CanSave)"
                @onclick="ConfirmSaveAsync">
            Save
        </button>
    </Actions>
</ModalPopup>

@code {
    private const string DefaultFileName = "layout.pans";
    private const string RequiredExtension = ".pans";

    private ModalPopup? modal_;
    private string fileName_ = DefaultFileName;
    private string? error_;

    [Parameter]
    public string? LastFileName { get; set; }

    [Parameter]
    public EventCallback<string> OnSave { get; set; }

    private bool CanSave =>
        !string.IsNullOrWhiteSpace(fileName_);

    public async Task Open()
    {
        fileName_ = string.IsNullOrWhiteSpace(LastFileName)
            ? DefaultFileName
            : LastFileName;

        error_ = null;

        if (modal_ is not null)
            await modal_.Open();
    }

    private void OnFileNameChanged(ChangeEventArgs e)
    {
        fileName_ = e.Value?.ToString() ?? string.Empty;
        error_ = null;
    }

    private async Task ConfirmSaveAsync()
    {
        var fileName = fileName_.Trim();

        if (string.IsNullOrWhiteSpace(fileName))
        {
            error_ = "Enter a file name.";
            return;
        }

        if (!fileName.EndsWith(RequiredExtension, StringComparison.OrdinalIgnoreCase))
            fileName += RequiredExtension;

        await OnSave.InvokeAsync(fileName);
        await Close();
    }

    private async Task Close()
    {
        error_ = null;

        if (modal_ is not null)
            await modal_.RequestCloseAsync();
    }
}