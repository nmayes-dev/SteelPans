@implements IAsyncDisposable
@inject IJSRuntime JS

<div class="number-input">
    <input @ref="inputRef_"
           id="@Id"
           class="number-input-control"
           type="number"
           inputmode="numeric"
           value="@currentValue_"
           step="@step_"
           @onchange="HandleInput"
           disabled="@Disabled" />

    @if (UseButtons)
    {
        <div class="number-buttons">
            <button class="number-button number-button--up"
                    type="button"
                    @onpointerdown="@(() => BeginRepeatAsync(1))"
                    @onpointerup="EndRepeatAsync"
                    @onpointercancel="EndRepeatAsync"
                    @onpointerleave="EndRepeatAsync"
                    tabindex="-1"
                    disabled="@Disabled"
                    aria-label="Increment"></button>

            <button class="number-button number-button--down"
                    type="button"
                    @onpointerdown="@(() => BeginRepeatAsync(-1))"
                    @onpointerup="EndRepeatAsync"
                    @onpointercancel="EndRepeatAsync"
                    @onpointerleave="EndRepeatAsync"
                    tabindex="-1"
                    disabled="@Disabled"
                    aria-label="Decrement"></button>
        </div>
    }
</div>

@code {
    private const int RepeatInitialDelayMs = 350;
    private const int RepeatIntervalMs = 50;

    [Parameter] public string? Id { get; set; }

    [Parameter] public int Value { get; set; }
    [Parameter] public EventCallback<int> ValueChanged { get; set; }

    [Parameter] public int? Min { get; set; }
    [Parameter] public int? Max { get; set; }
    [Parameter] public int? Step { get; set; }

    [Parameter] public bool UseButtons { get; set; } = true;

    [Parameter] public bool CanRepeat { get; set; }
    [Parameter] public int InitialRepeatDelay { get; set; } = RepeatInitialDelayMs;
    [Parameter] public int RepeatInterval { get; set; } = RepeatIntervalMs;

    [Parameter] public bool Disabled { get; set; }

    private int step_ => Step ?? 1;

    private ElementReference inputRef_;
    private string currentValue_ = string.Empty;
    private CancellationTokenSource? repeatCts_;

    protected override void OnParametersSet()
    {
        currentValue_ = Value.ToString();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
            await JS.InvokeVoidAsync("filters.numeric", inputRef_);
    }

    private async Task HandleInput(ChangeEventArgs e)
    {
        var raw = e.Value?.ToString() ?? string.Empty;

        if (string.IsNullOrWhiteSpace(raw))
        {
            currentValue_ = Value.ToString();
            await JS.InvokeVoidAsync("filters.setValue", inputRef_, currentValue_);
            return;
        }

        if (!int.TryParse(raw, out var value))
        {
            currentValue_ = Value.ToString();
            await JS.InvokeVoidAsync("filters.setValue", inputRef_, currentValue_);
            return;
        }

        value = Clamp(value);
        await UpdateValueAsync(value);
    }

    private async Task BeginRepeatAsync(int delta)
    {
        await EndRepeatAsync();
        await ChangeValueAsync(delta);
        _ = RepeatChangeAsync(delta);
    }

    private async Task EndRepeatAsync()
    {
        if (repeatCts_ is null || !CanRepeat)
            return;

        repeatCts_.Cancel();
        repeatCts_.Dispose();
        repeatCts_ = null;
    }

    private async Task ChangeValueAsync(int delta)
    {
        if (!int.TryParse(currentValue_, out var value))
        {
            await EndRepeatAsync();
            return;
        }

        var nextValue = Clamp(value + (delta * step_));
        if (value == nextValue)
        {
            await EndRepeatAsync();
            return;
        }

        await UpdateValueAsync(nextValue);
    }


    private async Task RepeatChangeAsync(int direction)
    {
        if (!CanRepeat)
            return;

        try
        {
            repeatCts_ = new CancellationTokenSource();
            var token = repeatCts_.Token;

            await Task.Delay(RepeatInterval, token);

            while (!token.IsCancellationRequested)
            {
                await ChangeValueAsync(direction);
                await Task.Delay(RepeatInterval, token);
            }
        }
        catch (OperationCanceledException)
        {
        }
    }

    private async Task UpdateValueAsync(int value)
    {
        currentValue_ = value.ToString();

        if (value != Value)
            await ValueChanged.InvokeAsync(value);

        // ensure DOM reflects clamped value
        await JS.InvokeVoidAsync("filters.setValue", inputRef_, currentValue_);
    }

    private int Clamp(int value)
    {
        if (Min.HasValue)
            value = Math.Max(Min.Value, value);

        if (Max.HasValue)
            value = Math.Min(Max.Value, value);

        return value;
    }

    public ValueTask DisposeAsync() => ValueTask.CompletedTask;
}