@page "/account/register"
@using Microsoft.AspNetCore.Components

<section class="account-page account-page--register">
    <div class="account-card">
        <div class="account-card__header">
            <p class="account-card__eyebrow">Steel Pans</p>
            <h1 class="account-card__title">Create account</h1>
            <p class="account-card__subtitle">Set up access for your practice and ensemble tools.</p>
        </div>

        @if (!string.IsNullOrWhiteSpace(Error))
        {
            <p class="account-error" role="alert">@Error</p>
        }

        <form class="account-form" method="post" action="/account/register">
            <AntiforgeryToken />
            <input type="hidden" name="returnUrl" value="@ReturnUrl" />

            <div class="account-field">
                <label for="display-name">Display name</label>
                <input id="display-name" name="displayName" type="text" autocomplete="name" />
            </div>

            <div class="account-field">
                <label for="email">Email</label>
                <input id="email" name="email" type="email" autocomplete="username" required />
            </div>

            <div class="account-field">
                <label for="password">Password</label>
                <input id="password" name="password" type="password" autocomplete="new-password" required />
            </div>

            <button class="account-button account-button--primary" type="submit">Create account</button>
        </form>

        <p class="account-card__footer">
            Already registered?
            <a href="/account/login">Log in</a>
        </p>
    </div>
</section>

@code {
    [SupplyParameterFromQuery]
    public string? ReturnUrl { get; set; }

    [SupplyParameterFromQuery]
    public string? Error { get; set; }
}
