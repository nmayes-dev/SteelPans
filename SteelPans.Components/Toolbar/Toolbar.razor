@implements IDisposable
@inherits OverlayComponentBase
@inject ModalPopupService Modals

<CascadingValue Value="this" IsFixed="true">
    @ChildContent
</CascadingValue>

<div class="@ToolbarClass">
    <div class="toolbar__surface">
        <button class="toolbar__header"
                role="button"
                aria-label="@MenuButtonLabel"
                aria-expanded="@anyOpen_"
                @onclick="ToggleMenuAsync">
            <div class="toolbar__header-content">
                <span class="toolbar__header-button-icon">
                    <span class="bi @(anyOpen_ ? OpenIconClass : ClosedIconClass)" aria-hidden="true"></span>
                </span>

                <div class="toolbar__header-container">
                    @if (ActiveElement?.HeaderActions is not null)
                    {
                        <div class="toolbar__header-actions"
                             @onclick:stopPropagation="true">
                            @ActiveElement?.HeaderActions
                        </div>
                    }

                    <div class="toolbar__header-title-wrap">
                        <span class="toolbar__header-title">@ActiveElement?.Text</span>

                        @if (ActiveElement is not null && ActiveElement.CanExpand)
                        {
                            <button type="button"
                                    class="toolbar__header-expand-button"
                                    @onclick="@OpenModalElement"
                                    @onclick:stopPropagation="true"
                                    aria-label="Expand @ActiveElement.Text">
                                <span class="bi bi-arrows-fullscreen"></span>
                            </button>
                        }
                    </div>
                </div>
            </div>
        </button>

        <div class="toolbar__menu" role="menu" aria-label="@MenuLabel">
            <ToolbarMenuItems Items="Elements"
                              Owner="this"
                              Depth="0" />
        </div>

        <div class="toolbar__panel">
            @foreach (var element in contentElements_)
            {
                var cssClass = "toolbar__panel-content " + (element == ActiveElement ? "toolbar__panel-content-active" : "");
                <div class="@cssClass">
                    @element?.ChildContent
                </div>
            }
        </div>
    </div>

    <ModalPopup TPayload="object"
                Id="ToolbarContent"
                Title="@ModalElement?.Text"
                Draggable="@(ModalElement?.CanMoveExpanded ?? false)"
                OnClose="() => ModalElement = null">
        <ChildContent>
            @ModalElement?.ChildContent
        </ChildContent>
    </ModalPopup>
</div>