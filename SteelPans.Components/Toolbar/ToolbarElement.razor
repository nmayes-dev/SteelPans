@implements IDisposable

<CascadingValue Value="this" IsFixed="true">
    @SubMenu
</CascadingValue>

@code {
    private readonly List<ToolbarElement> children_ = [];

    [CascadingParameter]
    public Toolbar? Parent { get; set; }

    [CascadingParameter]
    public ToolbarElement? ParentElement { get; set; }

    [Parameter]
    public int? Order { get; set; }

    [Parameter]
    public string Text { get; set; } = "";

    [Parameter] 
    public string? LabelFor { get; set; }

    [Parameter]
    public string? IconClass { get; set; }

    [Parameter]
    public RenderFragment? HeaderActions { get; set; }

    [Parameter]
    public RenderFragment? ChildContent { get; set; }

    [Parameter]
    public RenderFragment? SubMenu { get; set; }

    [Parameter]
    public EventCallback OnClick { get; set; }

    [Parameter]
    public bool CloseOnAction { get; set; } = false;

    [Parameter]
    public bool CanExpand { get; set; } = false;

    [Parameter]
    public bool CanMoveExpanded { get; set; } = false;

    [Parameter]
    public bool Disabled { get; set; } = false;

    internal IReadOnlyList<ToolbarElement> Children => children_.OrderBy(x => x.Order).ToArray();

    internal bool HasBody => ChildContent is not null;

    internal bool HasSubMenu => children_.Count > 0;

    public string IconDisplayCss => "bi " + (HasSubMenu ? "toolbar__submenu-chevron" : IconClass);


    internal void RegisterChild(ToolbarElement element)
    {
        if (!children_.Contains(element))
            children_.Add(element);
    }

    internal void UnregisterChild(ToolbarElement element)
    {
        children_.Remove(element);
    }

    protected override void OnInitialized()
    {
        bool isChild = ParentElement is not null;
        if (isChild)
            ParentElement!.RegisterChild(this);

        Parent?.RegisterElement(this, !isChild);
    }

    public void Dispose()
    {
        bool isChild = ParentElement is not null;
        if (isChild)
            ParentElement!.UnregisterChild(this);

        Parent?.UnregisterElement(this, !isChild);
    }
}
