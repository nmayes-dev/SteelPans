{
  "Logging": {
    "File": {
      "Path": "logs/steelpans-.log",
      "FileSizeLimitBytes": 52428800,
      "RetainedFileCountLimit": 60,
      "RetainedDays": 30
    }
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.EntityFrameworkCore.Database.Command": "Warning",
        "Microsoft.Hosting.Lifetime": "Information",
        "System": "Warning"
      }
    }
  },
  "AllowedHosts": "*"
}
