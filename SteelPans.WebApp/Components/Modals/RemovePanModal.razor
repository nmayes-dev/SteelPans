@inject MidiPlaybackService Playback

<ModalPopup TPayload="MidiAssignedPan"
            Id="RemovePan"
            Title="@title_"
            OnOpen="OnOpen"
            ShowCloseButton="false"
            CloseButton="Cancel"
            ConfirmButton="Remove"
            ConfirmButtonClass="btn-danger"
            OnConfirm="OnConfirmAsync" />

@code {
    private string title_ = "Remove Pan?";

    private void OnOpen(MidiAssignedPan payload)
    {
        title_ = $"Remove {payload.Pan.Type.ToSpacedPascal()}?";
    }

    private async Task<bool> OnConfirmAsync(MidiAssignedPan payload)
    {
        if (payload.Assignment.Track is null)
            return false;

        await Playback.OnRemoveAssignmentAsync(payload.Assignment.Track.Id);
        return true;
    }
}
