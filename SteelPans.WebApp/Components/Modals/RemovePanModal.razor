@inject InstanceStateService State
@inject MidiPlaybackService Playback

<ModalPopup Id="RemovePan"
            Title="@Title"
            ShowCloseButton="false"
            CloseButton="Cancel"
            OnClose="OnClose"
            ConfirmButton="Remove"
            ConfirmButtonClass="btn-danger"
            OnConfirm="OnConfirmAsync" />
@code {
    private string Title => State.Pending.PanRemoval is not null
        ? $"Remove {State.Pending.PanRemoval.Pan.Type.ToSpacedPascal()}?"
        : "Remove Pan?";

    private void OnClose()
    {
        State.Pending.PanRemoval = null;
    }

    private async Task OnConfirmAsync()
    {
        if (State.Pending.PanRemoval is null)
            return;

        var index = State.Pending.PanRemoval.Assignment.Track?.Index ?? -1;

        await Playback.OnRemoveAssignmentAsync(index);
    }

}