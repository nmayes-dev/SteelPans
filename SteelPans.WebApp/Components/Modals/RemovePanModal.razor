@inject MidiPlaybackService Playback

<ModalPopup TPayload="MidiAssignedPan"
            Id="RemovePan"
            Title="@title_"
            OnOpen="OnOpen"
            ShowCloseButton="false"
            CloseButton="Cancel"
            ConfirmButton="Remove"
            ConfirmButtonClass="btn-danger"
            OnConfirm="OnConfirmAsync" />

@code {
    private string title_ = "Remove Pan?";

    private void OnOpen(MidiAssignedPan? payload)
    {
        var assignedPan = payload ?? throw new InvalidOperationException(
            "RemovePan modal requires a payload.");

        title_ = $"Remove {assignedPan.Pan.Type.ToSpacedPascal()}?";
    }

    private async Task OnConfirmAsync(MidiAssignedPan? payload)
    {
        var assignedPan = payload ?? throw new InvalidOperationException(
            "RemovePan modal requires a payload.");

        var index = assignedPan.Assignment.Track?.Index ?? -1;

        await Playback.OnRemoveAssignmentAsync(index);
    }
}
