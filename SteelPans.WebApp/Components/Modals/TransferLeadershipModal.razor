@inject DbService Db
@inject InstanceStateService State

<ModalPopup TPayload="Payload"
            Id="TransferLeadership"
            Title="@title_"
            OnOpen="OnOpen"
            CloseButton="Cancel"
            ConfirmButton="Confirm"
            ConfirmButtonClass="btn-danger"
            OnConfirm="OnConfirmAsync">
    <ChildContent>
        <div class="manage-group-modal">
            <p>
                You will become an admin and this member will become the group leader.
                Only the new leader will be able to delete the group or transfer leadership again.
            </p>
        </div>
    </ChildContent>
</ModalPopup>

@code {
    public sealed record Payload(
        GroupSummaryDto Group,
        GroupMemberSummaryDto Member);

    private string title_ = string.Empty;

    private void OnOpen(Payload? payload)
    {
        var target = payload ?? throw new InvalidOperationException(
            "TransferLeadership modal requires a payload.");

        title_ = $"Transfer Group to {DisplayName(target.Member)}?";
    }

    private async Task OnConfirmAsync(Payload? payload)
    {
        if (payload is null)
            return;

        await State.Task.RunSafe(async () =>
        {
            await Db.Groups.TransferLeadershipAsync(payload.Group.Id, payload.Member.UserId);
            return "Leadership transferred.";
        });
    }

    private static string DisplayName(GroupMemberSummaryDto member) =>
        string.IsNullOrWhiteSpace(member.UserName) ? member.Email : member.UserName;
}
