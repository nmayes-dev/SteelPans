@inject InstanceStateService State
@inject DbService Db
@inject NavigationManager Nav

<ModalPopup TPayload="GroupSummaryDto"
            Id="DeleteGroup"
            Title="@title_"
            OnOpen="OnOpen"
            CloseButton="Cancel"
            ConfirmButton="Delete"
            ConfirmButtonClass="btn-danger"
            OnConfirm="OnConfirmAsync">
    <ChildContent>
        <div class="sp-app-form">
            <p class="sp-app-alert sp-app-alert--error">
                This cannot be undone. Members and invite links for this group will no longer be usable.
            </p>
        </div>
    </ChildContent>
</ModalPopup>

@code {
    private string title_ = string.Empty;

    private void OnOpen(GroupSummaryDto? payload)
    {
        var group = payload ?? throw new InvalidOperationException(
            "DeleteGroup modal requires a group payload.");

        title_ = $"Delete {group.Name}?";
    }

    private async Task OnConfirmAsync(GroupSummaryDto? payload)
    {
        var group = payload ?? throw new InvalidOperationException(
            "DeleteGroup modal requires a group payload.");

        if (group is null)
            return;

        await State.Task.RunSafe(async () =>
        {
            await Db.Groups.DeleteGroupAsync(group.Id);

            await State.User.RefreshAsync();
            Nav.NavigateTo("/groups");
            return "Group deleted.";
        });
    }
}
