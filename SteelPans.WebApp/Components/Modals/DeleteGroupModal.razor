@inject InstanceStateService State
@inject DbService Db
@inject NavigationManager Nav

<ModalPopup Id="DeleteGroup"
            Title="@title_"
            OnOpen="OnOpen"
            CloseButton="Cancel"
            OnClose="OnClose"
            ConfirmButton="Delete"
            ConfirmButtonClass="btn-danger"
            OnConfirm="OnConfirmAsync">
    <ChildContent>
        <div class="sp-app-form">
            <p class="sp-app-alert sp-app-alert--error">
                This cannot be undone. Members and invite links for this group will no longer be usable.
            </p>
        </div>
    </ChildContent>
</ModalPopup>

@code {
    private string title_ = string.Empty;

    private void OnOpen()
    {
        title_ = $"Delete {(State.Pending.Group?.Name ?? "This Group")}?";
    }

    private void OnClose()
    {
        State.Pending.Group = null;
    }

    private async Task OnConfirmAsync()
    {
        if (State.Pending.Group is null)
            return;

        await State.Task.RunSafe(async () =>
        {
            await Db.Groups.DeleteGroupAsync(State.Pending.Group.Id);

            await State.User.RefreshAsync();
            Nav.NavigateTo("/groups");
            return "Group deleted.";
        });

            
    }
}