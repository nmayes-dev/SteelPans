@inject InstanceStateService State
@inject DbService Db
@inject NavigationManager Nav

<ModalPopup TPayload="GroupSummaryDto"
            Id="DeleteGroup"
            Title="@title_"
            OnOpen="OnOpen"
            CloseButton="Cancel"
            ConfirmButton="Delete"
            ConfirmButtonClass="btn-danger"
            OnConfirm="OnConfirmAsync">
    <ChildContent>
        <div class="sp-app-form">
            @switch (stage_)
            {
                case ConfirmationStage.One:
                    <p class="sp-app-alert sp-app-alert--error">
                        This cannot be undone. Members and invite links for this group will no longer be usable.
                    </p>
                    break;
                case ConfirmationStage.Two:
                    <p class="sp-app-alert sp-app-alert--error">
                        Are you absolutely sure that you want to continue? This action is irreversible.
                    </p>
                    break;
            }
        </div>
    </ChildContent>
</ModalPopup>

@code {
    private enum ConfirmationStage
    {
        One,
        Two
    }

    private string title_ = string.Empty;
    private ConfirmationStage stage_;

    private void OnOpen(GroupSummaryDto payload)
    {
        title_ = $"Delete {payload.Name}?";
        stage_ = ConfirmationStage.One;
    }

    private async Task DeleteAccountAsync(GroupSummaryDto group)
    {
        await State.Task.RunSafe(async () =>
        {
            await Db.Groups.DeleteGroupAsync(group.Id);

            Nav.NavigateTo("/groups");
            return "Group deleted.";
        });
    }

    private async Task<bool> OnConfirmAsync(GroupSummaryDto payload)
    {
        switch (stage_)
        {
            case ConfirmationStage.One:
                stage_ = ConfirmationStage.Two;
                return false;
            case ConfirmationStage.Two:
                await DeleteAccountAsync(payload);
                return true;
        }

        return true;
    }
}
