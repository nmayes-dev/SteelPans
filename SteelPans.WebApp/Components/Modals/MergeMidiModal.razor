@inject MidiLoaderService MidiService
@inject MidiPlaybackService Playback
@inject InstanceStateService State

<ModalPopup TPayload="IReadOnlyList<DialogFile>"
            Id="MergeMidiFiles"
            Title="Merge MIDI tracks"
            OnOpen="OnOpen"
            CloseButton="Cancel"
            OnClose="OnClose"
            ConfirmButton="Merge"
            OnConfirm="OnConfirmAsync">
    <ChildContent>
        <input class="pans-page__track_name form-control"
               placeholder="Enter merged track name..."
               @bind="mergeMidiFileName_"
               @bind:event="oninput" />
    </ChildContent>
</ModalPopup>

@code {
    private IReadOnlyList<DialogFile> files_ = [];
    private string mergeMidiFileName_ = string.Empty;

    private void OnOpen(IReadOnlyList<DialogFile>? files)
    {
        files_ = files ?? [];
    }

    private void OnClose(IReadOnlyList<DialogFile>? _)
    {
        mergeMidiFileName_ = string.Empty;
        files_ = [];
    }

    private async Task<bool> OnConfirmAsync(IReadOnlyList<DialogFile>? files)
    {
        files ??= files_;

        if (files.Count == 0)
            return true;

        var midiFileName = $"{mergeMidiFileName_.Trim()}.mid";

        var loadTracks = async () =>
        {
            var streamFiles = new List<(string Name, Stream Stream)>();

            try
            {
                foreach (var file in files)
                {
                    if (file.File is null)
                        continue;

                    var stream = file.File.OpenReadStream(State.MaxMidiFileSize);
                    streamFiles.Add((file.Name, stream));
                }

                return (midiFileName, await MidiService.MergeMidiTracksAsync(midiFileName, streamFiles));
            }
            finally
            {
                foreach (var (_, stream) in streamFiles)
                {
                    await stream.DisposeAsync();
                }
            }
        };
        
        await Playback.OnLoadMidiAsync(loadTracks);
        return true;
    }
}
