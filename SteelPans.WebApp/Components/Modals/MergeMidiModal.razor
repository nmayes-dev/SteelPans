@inject MidiFileService MidiService
@inject MidiPlaybackService Playback
@inject UserStateService UserState

<ModalPopup TPayload="IReadOnlyList<IBrowserFile>"
            Id="MergeMidiFiles"
            Title="Merge MIDI tracks"
            OnOpen="OnOpen"
            CloseButton="Cancel"
            ConfirmButton="Merge"
            OnConfirm="OnConfirmAsync">
    <ChildContent>
        <input class="pans-page__track_name form-control"
               placeholder="Enter merged track name..."
               @bind="mergeMidiFileName_"
               @bind:event="oninput" />
    </ChildContent>
</ModalPopup>

@code {
    private string mergeMidiFileName_ = string.Empty;

    private void OnOpen(IReadOnlyList<IBrowserFile> files)
    {
        if (files.Count == 0)
            throw new InvalidOperationException("Must provide at least one file");
    }

    private async Task<bool> OnConfirmAsync(IReadOnlyList<IBrowserFile> files)
    {
        if (files.Count == 0)
            return true;

        var midiFileName = $"{mergeMidiFileName_.Trim()}.mid";

        var loadTracks = async () =>
        {
            var streamFiles = new List<(string Name, Stream Stream)>();

            try
            {
                foreach (var file in files)
                {
                    var stream = file.OpenReadStream(UserState.MaxMidiFileSize);
                    streamFiles.Add((file.Name, stream));
                }

                return (midiFileName, await MidiService.MergeMidiTracksAsync(midiFileName, streamFiles));
            }
            finally
            {
                foreach (var (_, stream) in streamFiles)
                {
                    await stream.DisposeAsync();
                }
            }
        };
        
        await Playback.OnLoadMidiAsync(loadTracks);
        return true;
    }
}
