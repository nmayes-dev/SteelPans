@using SteelPans.WebApp.Services
@inject MidiManagerService MidiService

<ModalPopup TPayload="Guid?"
            Id="AddPan"
            Title="Add Pan"
            OnOpen="OnOpen"
            CloseButton="Cancel"
            OnClose="OnClose"
            ConfirmButton="Add"
            OnConfirm="_ => OnAddAsync()">
    <ChildContent>
        <div class="add__body">
            @if (addModalType_ == AddModalType.Track)
            {
                <select id="midi-track-select-modal"
                        class="form-select"
                        disabled="@(UnassignedTracks.Count == 0)"
                        @bind="selectedTrackIdString_">
                    @if (UnassignedTracks.Count == 0)
                    {
                        <option value="">All tracks already assigned</option>
                    }
                    else
                    {
                        @foreach (var track in UnassignedTracks)
                        {
                            <option value="@track.Id.ToString()">@track.DisplayInfo</option>
                        }
                    }
                </select>
            }

            <select id="pan-type-select"
                    class="form-select"
                    @bind="selectedPanTypeString_">
                @if (AvailablePanTypes.Count == 0)
                {
                    <option value="">No pans available</option>
                }
                else
                {
                    @foreach (var panType in AvailablePanTypes)
                    {
                        <option value="@panType.ToString()">@panType.ToSpacedPascal()</option>
                    }
                }
            </select>
        </div>
    </ChildContent>
</ModalPopup>

@code {
    private IReadOnlyList<PanType> AvailablePanTypes => MidiService.Playback.AvailablePans.Select(x => x.Type).ToList();

    private enum AddModalType
    {
        None,
        Pan,
        Track
    }

    private AddModalType addModalType_;
    private string? selectedTrackIdString_;
    private string? selectedPanTypeString_;

    private bool HasTracks => MidiService.Playback.Tracks.Count > 0;

    private string selectedTrackLabel_
    {
        get
        {
            if (!Guid.TryParse(selectedTrackIdString_, out var trackId))
                return string.Empty;

            var track = MidiService.Playback.Tracks.FirstOrDefault(x => x.Id == trackId);
            if (track is null)
                return string.Empty;

            return track.DisplayInfo;
        }
    }

    private List<MidiTrackInfo> UnassignedTracks =>
        MidiService.Playback.Tracks
            .Where(t => MidiService.Playback.Assignments.All(a => a.TrackId != t.Id))
            .OrderBy(t => t.Index)
            .ToList();

    private bool CanOpenTrackAddModal =>
        HasTracks &&
        AvailablePanTypes.Count > 0 &&
        UnassignedTracks.Count > 0 &&
        Guid.TryParse(selectedTrackIdString_, out _);

    private bool CanOpenPanAddModal =>
        AvailablePanTypes.Count > 0;

    private bool CanConfirmAddTrack =>
        addModalType_ == AddModalType.Track &&
        Guid.TryParse(selectedTrackIdString_, out var trackId) &&
        UnassignedTracks.Any(x => x.Id == trackId) &&
        Enum.TryParse<PanType>(selectedPanTypeString_, out var panType) &&
        AvailablePanTypes.Contains(panType);

    private bool CanConfirmAddPan =>
        addModalType_ == AddModalType.Pan &&
        Enum.TryParse<PanType>(selectedPanTypeString_, out var panType) &&
        AvailablePanTypes.Contains(panType);

    private bool CanOpen => CanOpenTrackAddModal || CanOpenPanAddModal;
    private bool CanConfirmAdd => CanConfirmAddPan || CanConfirmAddTrack;

    private void GetInitialParameters(Guid? initialTrack = null)
    {
        selectedPanTypeString_ = AvailablePanTypes.FirstOrDefault().ToString();

        if (UnassignedTracks.Count == 0)
        {
            selectedTrackIdString_ = string.Empty;
            return;
        }

        if (string.IsNullOrWhiteSpace(selectedTrackIdString_) || initialTrack is not null)
            selectedTrackIdString_ = initialTrack?.ToString() ?? string.Empty;

        if (!Guid.TryParse(selectedTrackIdString_, out var selectedTrackId) ||
            UnassignedTracks.All(x => x.Id != selectedTrackId))
        {
            selectedTrackId = UnassignedTracks[0].Id;
            selectedTrackIdString_ = selectedTrackId.ToString();
        }

        var selectedTrack = UnassignedTracks.First(x => x.Id == selectedTrackId);
        var matchingPanType = FindMatchingPanType(selectedTrack.Name);
        if (matchingPanType is not null)
            selectedPanTypeString_ = matchingPanType.Value.ToString();
    }

    private PanType? FindMatchingPanType(string? trackName)
    {
        if (string.IsNullOrWhiteSpace(trackName))
            return null;

        var normalisedTrackName = NormaliseName(trackName);
        if (normalisedTrackName.Length == 0)
            return null;

        return AvailablePanTypes
            .Select(panType => new
            {
                PanType = panType,
                Score = GetPanNameMatchScore(normalisedTrackName, panType),
            })
            .Where(x => x.Score > 0)
            .OrderByDescending(x => x.Score)
            .Select(x => (PanType?)x.PanType)
            .FirstOrDefault();
    }

    private static int GetPanNameMatchScore(string normalisedTrackName, PanType panType)
    {
        var aliases = panType switch
        {
            PanType.LeadTenor => new[] { "leadtenor", "tenor", "lead" },
            PanType.DoubleGuitar => new[] { "doubleguitar", "guitar" },
            PanType.DoubleSecond => new[] { "doublesecond", "seconds", "second" },
            PanType.TripleCello => new[] { "triplecello", "cello" },
            PanType.Bass => new[] { "bass" },
            _ => Array.Empty<string>(),
        };

        return aliases
            .Where(normalisedTrackName.Contains)
            .Select(alias => alias.Length)
            .DefaultIfEmpty(0)
            .Max();
    }

    private static string NormaliseName(string name)
    {
        return new string(name
            .Where(char.IsLetterOrDigit)
            .Select(char.ToLowerInvariant)
            .ToArray());
    }

    protected override void OnParametersSet()
    {
        GetInitialParameters(initialTrack: null);
    }

    public void OnOpen(Guid? initialTrack)
    {
        if (!(CanOpenTrackAddModal || CanOpenPanAddModal))
            return;

        GetInitialParameters(initialTrack);
        if (HasTracks)
            addModalType_ = AddModalType.Track;
        else
            addModalType_ = AddModalType.Pan;
    }

    private void OnClose(Guid? _)
    {
        addModalType_ = AddModalType.None;
    }

    private async Task<bool> OnAddAsync()
    {
        if (!Enum.TryParse<PanType>(selectedPanTypeString_, out var panType))
            return false;

        switch (addModalType_)
        {
            case AddModalType.Pan:
                await ConfirmAddPanAsync(panType);
                break;

            case AddModalType.Track:
                await ConfirmAddTrackAsync(panType);
                break;
        }

        return true;
    }

    private async Task ConfirmAddPanAsync(PanType panType)
    {
        var assignment = new MidiTrackAssignment
        {
            AssignedPanType = panType,
        };
        await MidiService.Playback.AddAssignmentAsync(assignment);
    }

    private async Task ConfirmAddTrackAsync(PanType panType)
    {
        if (!Guid.TryParse(selectedTrackIdString_, out var trackId))
            return;

        var track = MidiService.Playback.Tracks.FirstOrDefault(x => x.Id == trackId);
        if (track is null)
            return;

        var assignment = new MidiTrackAssignment
        {
            AssignedPanType = panType,
            TrackId = track.Id,
        };

        await MidiService.Playback.AddAssignmentAsync(assignment);
    }
}
