@inject InstanceStateService State
@inject DbService Db

<ModalPopup TPayload="GroupFileDto"
            Id="DeleteMidi"
            Title="@title_"
            OnOpen="OnOpen"
            CloseButton="Cancel"
            ConfirmButton="Delete"
            ConfirmButtonClass="btn-danger"
            OnConfirm="OnConfirmAsync">
    <ChildContent>
        <div class="sp-app-form">
            <p class="sp-app-alert sp-app-alert--error">
                This cannot be undone. Members will no longer be able to use this file.
            </p>
        </div>
    </ChildContent>
</ModalPopup>

@code {
    private string title_ = string.Empty;

    private void OnOpen(GroupFileDto payload)
    {
        title_ = $"Delete {payload.OriginalFileName}?";
    }

    private async Task<bool> OnConfirmAsync(GroupFileDto payload)
    {
        await State.Task.RunSafe(async () =>
        {
            var deletedFileId = payload.Id;
            await Db.MidiFiles.DeleteMidiFileAsync(deletedFileId);

            await State.User.RefreshAsync();

            return "MIDI file deleted.";
        });

        return true;
    }
}
