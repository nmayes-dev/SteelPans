@inject MidiPlaybackService Playback
               
<ModalPopup TPayload="Configuration"
            Id="ConfigConflict"
            Title="Loading Layout For Different MIDI"
            ShowCloseButton="false"
            CloseButton="Cancel"
            ConfirmButton="Confirm"
            ConfirmButtonClass="btn-danger"
            OnConfirm="OnConfirmAsync" />

@code {
    private async Task<bool> OnConfirmAsync(Configuration? payload)
    {
        var config = payload ?? throw new InvalidOperationException(
            "ConfigConflict modal requires a payload.");

        await Playback.LoadPanLayoutAsync(config.Layout);
        return true;
    }
}
