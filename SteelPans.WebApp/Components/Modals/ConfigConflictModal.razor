@inject InstanceStateService State
@inject MidiPlaybackService Playback
               
<ModalPopup Id="ConfigConflict"
            Title="Loading Layout For Different MIDI"
            ShowCloseButton="false"
            CloseButton="Cancel"
            OnClose="OnCancel"
            ConfirmButton="Confirm"
            ConfirmButtonClass="btn-danger"
            OnConfirm="OnConfirmAsync" />

@code {
    private void OnCancel()
    {
        State.Pending.Configuration = null;
    }

    private async Task OnConfirmAsync()
    {
        if (State.Pending.Configuration is null)
            return;

        await Playback.LoadPanLayoutAsync(State.Pending.Configuration.Layout);
    }
}