@inject InstanceStateService State
@inject DbService Db
@inject NavigationManager Nav

<ModalPopup Id="LeaveGroup"
            Title="@title_"
            OnOpen="OnOpen"
            CloseButton="Cancel"
            OnClose="OnClose"
            ConfirmButton="Leave"
            ConfirmButtonClass="btn-danger"
            OnConfirm="OnConfirmAsync">
    <ChildContent>
        <div class="sp-app-form">
            <p class="sp-app-alert sp-app-alert--error">
                If you leave this group you will have to be invited again. If you are the last member this group will be deleted
            </p>
        </div>
    </ChildContent>
</ModalPopup>

@code {
    private string title_ = string.Empty;

    private void OnOpen()
    {
        title_ = $"Leave {(State.Pending.Group?.Name ?? "This Group")}?";
    }

    private void OnClose()
    {
        State.Pending.Group = null;
    }

    private async Task OnConfirmAsync()
    {
        if (State.Pending.Group is null)
            return;

        await State.Task.RunSafe(async () =>
        {
            await Db.Groups.LeaveGroupAsync(State.Pending.Group.Id);

            await State.User.RefreshAsync();
            Nav.NavigateTo("/groups");
            return "Left group.";
        });
    }
}