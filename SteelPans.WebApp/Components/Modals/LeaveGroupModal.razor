@inject InstanceStateService State
@inject DbService Db
@inject NavigationManager Nav

<ModalPopup TPayload="GroupSummaryDto"
            Id="LeaveGroup"
            Title="@title_"
            OnOpen="OnOpen"
            CloseButton="Cancel"
            ConfirmButton="Leave"
            ConfirmButtonClass="btn-danger"
            OnConfirm="OnConfirmAsync">
    <ChildContent>
        <div class="sp-app-form">
            <p class="sp-app-alert sp-app-alert--error">
                If you leave this group you will have to be invited again. If you are the last member this group will be deleted
            </p>
        </div>
    </ChildContent>
</ModalPopup>

@code {
    private string title_ = string.Empty;

    private void OnOpen(GroupSummaryDto? payload)
    {
        var group = payload ?? throw new InvalidOperationException(
            "LeaveGroup modal requires a group payload.");

        title_ = $"Leave {group.Name}?";
    }

    private async Task<bool> OnConfirmAsync(GroupSummaryDto? payload)
    {
        var group = payload ?? throw new InvalidOperationException(
            "LeaveGroup modal requires a group payload.");

        bool success = await State.Task.RunSafe(async () =>
        {
            await Db.Groups.LeaveGroupAsync(group.Id);
            return "Left group.";
        });

        if (success)
        {
            Nav.NavigateTo("/groups");
        }

        return true;
    }
}
