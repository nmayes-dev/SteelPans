@inject TaskRunnerService Tasks
@inject UserStateService UserState
@inject DbService Db
@inject NavigationManager Nav

<ModalPopup TPayload="GroupSummaryDto"
            Id="LeaveGroup"
            Title="@title_"
            OnOpen="OnOpen"
            CloseButton="Cancel"
            ConfirmButton="Leave"
            ConfirmButtonClass="btn-danger"
            OnConfirm="OnConfirmAsync">
    <ChildContent>
        <div class="sp-app-form">
            <p class="sp-app-alert sp-app-alert--error">
                If you leave this group you will have to be invited again. If you are the last member this group will be deleted
            </p>
        </div>
    </ChildContent>
</ModalPopup>

@code {
    private string title_ = string.Empty;

    private void OnOpen(GroupSummaryDto payload)
    {
        title_ = $"Leave {payload.Name}?";
    }

    private async Task<bool> OnConfirmAsync(GroupSummaryDto payload)
    {
        bool success = await Tasks.RunSafe(async () =>
        {
            await Db.Groups.LeaveGroupAsync(payload.Id);
            return "Left group.";
        });

        if (success)
        {
            Nav.NavigateTo("/groups");
        }

        return true;
    }
}
