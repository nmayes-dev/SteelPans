@inject IJSRuntime JS

<ModalPopup TPayload="object"
                     Title="Delete account"
                     Subtitle="This action cannot be undone."
                     CloseButton="Cancel"
                     ConfirmButton="Delete Account"
                     ConfirmButtonClass="btn-danger"
                     OnConfirm="SubmitAsync">
    <ChildContent>
        <div class="delete-account-modal">
            <p class="sp-app-alert sp-app-alert--error delete-account-modal__warning">
                This will permanently delete your account, remove you from every group, delete groups where you are the only member,
                and delete MIDI files uploaded by this account.
            </p>

            <form class="delete-account-modal__form"
                  @ref="form_"
                  method="post"
                  action="/account/delete">
                <AntiforgeryToken />
            </form>
        </div>
    </ChildContent>
</ModalPopup>

@code {
    private ElementReference form_;

    private async Task SubmitAsync()
    {
        try
        {
            await JS.InvokeVoidAsync("modalPopup.submitForm", form_);
        }
        catch (JSDisconnectedException)
        {
            // Expected if the form submission causes navigation.
        }
    }
}
