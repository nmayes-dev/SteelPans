@inject DbService Db
@inject InstanceStateService State

<ModalPopup TPayload="Payload"
            Id="RemoveGroupMember"
            Title="@title_"
            OnOpen="OnOpen"
            CloseButton="Cancel"
            ConfirmButton="Confirm"
            ConfirmButtonClass="btn-danger"
            OnConfirm="OnConfirmAsync">
    <ChildContent>
        <div class="manage-group-modal">
            <p>
                This member will lose access to group MIDI files and will need a new invite to rejoin.
            </p>
        </div>
    </ChildContent>
</ModalPopup>

@code {
    public sealed record Payload(
        GroupSummaryDto Group,
        GroupMemberSummaryDto Member);

    private string title_ = string.Empty;

    private void OnOpen(Payload? payload)
    {
        var midiFile = payload ?? throw new InvalidOperationException(
            "RemoveGroupMember modal requires a payload.");

        title_ = $"Remove {DisplayName(payload.Member)}?";
    }

    private async Task<bool> OnConfirmAsync(Payload? payload)
    {
        var data = payload ?? throw new InvalidOperationException(
            "LeaveGroup modal requires a group payload.");

        await State.Task.RunSafe(async () =>
        {
            await Db.Groups.RemoveMemberAsync(data.Group.Id, data.Member.UserId);
            return "Member removed.";
        });

        return true;
    }

    private static string DisplayName(GroupMemberSummaryDto member) =>
        string.IsNullOrWhiteSpace(member.UserName) ? member.Email : member.UserName;
}
