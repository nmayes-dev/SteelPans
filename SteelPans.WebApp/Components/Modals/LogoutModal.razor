@inject IJSRuntime JS
@inject NavigationManager Nav

<ModalPopup TPayload="object"
            Id="Logout"
            Title="Logout"
            OnConfirm="SubmitAsync">
    <ChildContent>
        <div class="account-card__header">
            <p class="account-card__subtitle">End this session on the current device.</p>
        </div>

        <form class="account-form"
              @ref="form_"
              method="post"
              action="/account/logout">
            <AntiforgeryToken />
            <input type="hidden" name="returnUrl" value="@CurrentPath" />

            <button class="account-button account-button--danger"
                    type="submit">
                Logout
            </button>
        </form>
    </ChildContent>
</ModalPopup>

@code {
    private ElementReference form_;

    private string CurrentPath
    {
        get
        {
            var path = Nav.ToBaseRelativePath(Nav.Uri);

            return string.IsNullOrWhiteSpace(path)
                ? "/"
                : "/" + path;
        }
    }

    public async Task SubmitAsync()
    {
        try
        {
            await JS.InvokeVoidAsync("modalPopup.submitForm", form_);
        }
        catch (JSDisconnectedException)
        {
            // Expected if the form submission causes navigation.
        }
    }
}
