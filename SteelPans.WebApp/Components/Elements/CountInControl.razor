@inject MidiPlaybackService Playback
@implements IDisposable

<div class="count-in-control" aria-label="Metronome Count In">
    <div class="count-in-control__control">
        <div class="count-in-control__number-input">
            <NumericInput Class="count-in-control__input count-in-control__number-input-control"
                          Value="@Playback.CountInBeats"
                          ValueChanged="SetCountInBeatsAsync"
                          Min="0"
                          Max="32"
                          Disabled="@Playback.IsPlaying" />

            <div class="count-in-control__number-buttons">
                <button class="count-in-control__number-button count-in-control__number-button--up"
                        type="button"
                        title="Increase Count In"
                        aria-label="Increase Count In"
                        disabled="@(!CanIncrement)"
                        tabindex="-1"
                        @onclick="IncrementAsync"></button>

                <button class="count-in-control__number-button count-in-control__number-button--down"
                        type="button"
                        title="Decrease Count In"
                        aria-label="Decrease Count In"
                        disabled="@(!CanDecrement)"
                        tabindex="-1"
                        @onclick="DecrementAsync"></button>
            </div>
        </div>

        <select class="count-in-control__select"
                aria-label="Note Division"
                title="Note Division"
                value="@Playback.CountInNoteDivision"
                disabled="@Playback.IsPlaying"
                @onchange="SetCountInNoteDivisionAsync">
            @foreach (var option in NoteDivisionOptions)
            {
                <option value="@option.Value">@option.Label</option>
            }
        </select>
    </div>

    <span class="count-in-control__label">Count In</span>
</div>

@code {
    private static readonly IReadOnlyList<(int Value, string Label)> NoteDivisionOptions =
    [
        (2, "𝅗𝅥"),
        (4, "𝅘𝅥"),
        (8, "𝅘𝅥𝅮"),
        (16, "𝅘𝅥𝅯"),
    ];

    private bool CanDecrement => !Playback.IsPlaying && Playback.CountInBeats > 0;
    private bool CanIncrement => !Playback.IsPlaying && Playback.CountInBeats < 32;

    protected override void OnInitialized()
    {
        Playback.CountInChanged += OnPlaybackStateChangedAsync;
        Playback.PlaybackStatusChanged += OnPlaybackStateChangedAsync;
    }

    private async Task IncrementAsync()
    {
        if (CanIncrement)
            await SetCountInBeatsAsync(Playback.CountInBeats + 1);
    }

    private async Task DecrementAsync()
    {
        if (CanDecrement)
            await SetCountInBeatsAsync(Playback.CountInBeats - 1);
    }

    private async Task SetCountInBeatsAsync(int beats)
    {
        if (!Playback.IsPlaying)
            await Playback.SetCountInBeatsAsync(beats);
    }

    private async Task SetCountInNoteDivisionAsync(ChangeEventArgs args)
    {
        if (Playback.IsPlaying)
            return;

        if (!int.TryParse(args.Value?.ToString(), out var noteDivision))
            return;

        var scale = (double)noteDivision / Playback.CountInNoteDivision;
        var newBeats = (int)Math.Ceiling(Playback.CountInBeats * scale);

        await Playback.SetCountInNoteDivisionAsync(noteDivision);
        await Playback.SetCountInBeatsAsync(newBeats);
    }

    private async Task OnPlaybackStateChangedAsync<TArgs>(TArgs _)
    {
        await InvokeAsync(StateHasChanged);
    }

    public void Dispose()
    {
        Playback.CountInChanged -= OnPlaybackStateChangedAsync;
        Playback.PlaybackStatusChanged -= OnPlaybackStateChangedAsync;
    }
}
