@inject MidiManagerService MidiService

<div class="count-in-control" aria-label="Metronome Count In">
    <div class="count-in-control__control">
        <NumericInput Value="@MidiService.Playback.CountInBeats"
                      ValueChanged="SetCountInBeatsAsync"
                      Min="0"
                      Max="32"
                      Disabled="@MidiService.Playback.IsPlaying" />

        <NoteDivisionDropdown Value="@MidiService.Playback.CountInNoteDivision"
                              Disabled="@MidiService.Playback.IsPlaying" 
                              ValueChanged="SetCountInNoteDivisionAsync"
                              NoteDivisions="@([2, 4, 8, 16])"/>
    </div>

    <span class="count-in-control__label">Count In</span>
</div>

@code {
    private async Task SetCountInBeatsAsync(int beats)
    {
        if (!MidiService.Playback.IsPlaying)
            await MidiService.Playback.SetCountInBeatsAsync(beats);
    }

    private async Task SetCountInNoteDivisionAsync(int noteDivision)
    {
        if (MidiService.Playback.IsPlaying)
            return;

        var scale = (double)noteDivision / MidiService.Playback.CountInNoteDivision;
        var newBeats = (int)Math.Ceiling(MidiService.Playback.CountInBeats * scale);

        await MidiService.Playback.SetCountInNoteDivisionAsync(noteDivision);
        await MidiService.Playback.SetCountInBeatsAsync(newBeats);
    }
}
