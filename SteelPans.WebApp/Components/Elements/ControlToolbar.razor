@inject MidiPlaybackService Playback
@inject MidiLoaderService MidiService
@inject NavigationManager Nav
@inject ModalPopupService Modals
@inject DbService Db
@inject InstanceStateService State
@inject IOptions<Settings> SettingsAccessor
@inject IJSRuntime JS

<Toolbar @ref="toolbar_"
         ClosedIconClass="bi-gear-fill"
         MenuButtonLabel="Open Tools"
         MenuLabel="Pan Tools"
         Side="Toolbar.ToolbarSide.Left">

    <ToolbarElement Order="1"
                    Text="Import">
        <SubMenu>
            <AuthorizeView>
                <Authorized>
                    @if (Groups is not null && Groups.Any(x => x.Value.Count > 0))
                    {
                        <ToolbarElement Order="1"
                                        Text="From Group"
                                        IconClass="bi-collection">
                            <SubMenu>
                                @foreach (var (group, files) in Groups.Where(x => x.Value.Count > 0))
                                {
                                    <ToolbarElement Text="@group.Name"
                                                    IconClass="bi-people">
                                        <ChildContent>
                                            <div class="pans-page__track-panel">
                                                <div class="pans-page__track-panel-header">
                                                    <span class="pans-page__track-panel-title">Ensemble Files</span>
                                                    <span class="pans-page__track-panel-count">@files.Count file@(files.Count == 1 ? "" : "s")</span>
                                                </div>

                                                <div class="pans-page__track-list">
                                                    @foreach (var file in files)
                                                    {
                                                        <div class="pans-page__track-item">
                                                            <div class="pans-page__track-details">
                                                                <div class="pans-page__track-name">@file.Title</div>
                                                                <div class="pans-page__track-meta">@file.OriginalFileName</div>
                                                            </div>

                                                            <button type="button"
                                                                    class="pans-page__track-button"
                                                                    aria-label="Load File"
                                                                    @onclick="() => LoadGroupMidiFileAsync(file)">
                                                                <span class="bi bi-download" aria-hidden="true"></span>
                                                            </button>
                                                        </div>
                                                    }
                                                </div>
                                            </div>
                                        </ChildContent>
                                    </ToolbarElement>
                                }
                            </SubMenu>
                        </ToolbarElement>
                    }
                </Authorized>
            </AuthorizeView>

            <ToolbarElement Order="2"
                            Text="MIDI File"
                            IconClass="bi-file-earmark-music"
                            LabelFor="midi-file-input" />

            <InputFile id="midi-file-input"
                       class="pans__file-input"
                       OnChange="OnMidiFilesChangedAsync"
                       multiple
                       accept=".mid,.midi,audio/midi,audio/x-midi" />

            @if (Playback.IsMidiLoaded)
            {
                <ToolbarElement Order="3"
                                Text="Tracks"
                                IconClass="bi-music-note-list"
                                Disabled="@(!Playback.Tracks.Any())"
                                CanExpand="true">
                    <ChildContent>
                        <div class="pans-page__track-panel">
                            <div class="pans-page__track-panel-header">
                                <span class="pans-page__track-panel-title">@Playback.IsMidiLoaded</span>
                                <span class="pans-page__track-panel-count">@Playback.Tracks.Count track@(Playback.Tracks.Count == 1 ? "" : "s")</span>
                            </div>

                            <div class="pans-page__track-list">
                                @foreach (var track in Playback.Tracks)
                                {
                                    <div class="pans-page__track-item">
                                        <div class="pans-page__track-details">
                                            <div class="pans-page__track-name">@track.Index) @track.DisplayInfo</div>
                                            <div class="pans-page__track-meta">@GetMetaInfo(track)</div>
                                        </div>

                                        <button type="button"
                                                class="pans-page__track-button @(IsTrackAssigned(track) ? "pans-page__track-button--assigned" : null)"
                                                aria-label="@(IsTrackAssigned(track) ? "Remove Track" : "Add Track")"
                                                @onclick="() => OnTrackButtonPressedAsync(track)">
                                            <span class="bi @(IsTrackAssigned(track) ? "bi-dash-lg" : "bi-plus-lg")" aria-hidden="true"></span>
                                        </button>
                                    </div>
                                }
                            </div>
                        </div>
                    </ChildContent>
                </ToolbarElement>
            }
        </SubMenu>
    </ToolbarElement>

    <ToolbarElement Order="2"
                    Text="Layout">
        <SubMenu>
            <ToolbarElement Order="1"
                            Text="Add Pan"
                            IconClass="bi-plus-lg"
                            OnClick="() => OpenAddPanAsync(closeOthers: true)" />

            @if (Playback.IsMidiLoaded)
            {
                <ToolbarElement Order="2"
                                Text="Load"
                                IconClass="bi-folder2-open"
                                Disabled="!Playback.IsMidiLoaded"
                                LabelFor="layout-file-input" />

                <InputFile id="layout-file-input"
                           class="pans__file-input"
                           OnChange="OnLoadConfigurationFileAsync"
                           accept=".pans" />

                <ToolbarElement Order="3"
                                Text="Save"
                                IconClass="bi-floppy"
                                Disabled="@(string.IsNullOrWhiteSpace(State.User.CurrentLayout) || !Playback.IsMidiLoaded || !Playback.ActivePans.Any())"
                                OnClick="() => SaveConfigurationFileAsync()" />

                <ToolbarElement Order="4"
                                Text="Save As..."
                                IconClass="bi-floppy2"
                                Disabled="@(!Playback.IsMidiLoaded || !Playback.ActivePans.Any())"
                                OnClick="OpenSaveLayoutAsync" />
            }
        </SubMenu>
    </ToolbarElement>

    @if (Playback.ActivePans.Any())
    {
        <ToolbarElement Order="3"
                        Text="Music">
            <SubMenu>
                <ToolbarElement Order="1"
                                Text="Mixer"
                                IconClass="bi-sliders2-vertical"
                                Disabled="@(!Playback.ActivePans.Any())"
                                CanExpand="true"
                                CanMoveExpanded="true">
                    <ChildContent>
                        <VolumeMixer />
                    </ChildContent>
                </ToolbarElement>
                <ToolbarElement Order="2"
                                Text="Metronome"
                                IconClass="bi-music-note-beamed">
                    <HeaderActions>
                        <ToggleSwitch Value="@Playback.ClickTrackEnabled"
                                      ValueChanged="OnClickTrackEnabledShellChangedAsync"
                                      AriaLabel="Enable Metronome" />
                    </HeaderActions>
                    <ChildContent>
                        <Metronome />
                    </ChildContent>
                </ToolbarElement>

                <ToolbarElement Order="3"
                                Text="Chords"
                                IconClass="bi-music-note-list">
                    <ChildContent>
                        <ChordBuilder />
                    </ChildContent>
                </ToolbarElement>
            </SubMenu>
        </ToolbarElement>
    }
</Toolbar>

@code {
    private Toolbar? toolbar_;

    private Settings Settings => SettingsAccessor.Value;

    private IReadOnlyDictionary<GroupSummaryDto, IReadOnlyList<GroupFileDto>> Groups => State.User.Groups?
        .ToDictionary(
            x => x,
            x => State.User.GroupFiles[x.Id]
        ) ?? new Dictionary<GroupSummaryDto, IReadOnlyList<GroupFileDto>>();

    private async Task OpenLogoutAsync()
    {
        await Modals.OpenAsync("Logout");
    }

    private async Task OpenAddPanAsync(bool closeOthers)
    {
        await Modals.OpenAsync("AddPan", new ModalOptions { CloseOthers = closeOthers });
    }

    private async Task OpenSaveLayoutAsync()
    {
        await Modals.OpenAsync("SaveLayout");
    }

    private async Task OpenConfigConflictAsync(Configuration config)
    {
        await Modals.OpenAsync("ConfigConflict", config);
    }

    private async Task OpenRemovePanAsync(MidiTrackInfo track)
    {
        var pan = Playback.ActivePans.First(a => a.Assignment.Track?.Index == track.Index);
        await Modals.OpenAsync("RemovePan", pan);
    }




    private void NavigateToLogin()
    {
        Nav.NavigateTo("/account/login", forceLoad: true);
    }
    private void NavigateToRegister()
    {
        Nav.NavigateTo("/account/register", forceLoad: true);
    }
    private void NavigateToProfile()
    {
        Nav.NavigateTo("/account/profile");
    }




    private async Task OnLoadConfigurationFileAsync(InputFileChangeEventArgs e)
    {
        await State.Task.RunUnsafe(async () =>
        {
            var file = e.File;

            await using var stream = file.OpenReadStream(
                maxAllowedSize: 1024 * 1024);

            var result = await JsonSerializer.DeserializeAsync<Configuration>(
                stream,
                new JsonSerializerOptions
                {
                    PropertyNameCaseInsensitive = true
                });

            if (result is null)
                return;

            if (result.Version != Settings.LayoutFileVersion)
                throw new InvalidOperationException("Incompatible layout file version.");

            if (!string.Equals(result.MidiFile, Playback.MidiFileName, StringComparison.OrdinalIgnoreCase))
            {
                await OpenConfigConflictAsync(result);
                return;
            }

            await Playback.LoadPanLayoutAsync(result.Layout);
        });
    }


    private async Task SaveConfigurationFileAsync()
    {
        var configuration = new Configuration
        {
            Version = Settings.Version,
            MidiFile = Playback.MidiFileName,
            Layout = Playback.Assignments.Select(a => new ConfigurationPan
            {
                Pan = a.AssignedPanType,
                Track = a.Track?.Index ?? -1,
            }).ToList()
        };

        await State.Task.RunUnsafe(async () =>
        {
            var json = JsonSerializer.Serialize(configuration, new JsonSerializerOptions
            {
                WriteIndented = true
            });

            await JS.InvokeVoidAsync(
                "fileHandling.submitDownloadForm",
                "/api/download",
                State.User.CurrentLayout,
                json,
                "application/json;charset=utf-8");
        });
    }



    private async Task OnTrackButtonPressedAsync(MidiTrackInfo track)
    {
        if (IsTrackAssigned(track))
        {
            await OpenRemovePanAsync(track);
            return;

        }

        await OpenAddPanAsync(closeOthers: false);
    }


    private async Task OnMidiFilesChangedAsync(InputFileChangeEventArgs e)
    {
        await State.Task.RunUnsafe(async () =>
        {
            var files = e.GetMultipleFiles()
                .Select(file => new DialogFile
                {
                    Name = file.Name,
                    Size = file.Size,
                    File = file
                })
                .ToList();

            if (files.Count == 0)
                return;

            if (files.Count == 1)
            {
                await OnSingleMidiSelectedAsync(files[0]);
                return;
            }

            await OnMultipleMidiSelectedAsync(files);
        });
    }


    private async Task OnMultipleMidiSelectedAsync(IReadOnlyList<DialogFile> files)
    {
        await Modals.OpenAsync("MergeMidiFiles", files);
    }

    private async Task OnSingleMidiSelectedAsync(DialogFile file)
    {
        if (file.File is null)
            return;

        await Playback.OnLoadMidiAsync(async () =>
        {
            await using var stream = file.File.OpenReadStream(State.MaxMidiFileSize);
            return (file.Name, await MidiService.OpenMidiFileAsync(stream));
        });
    }

    private async Task LoadGroupMidiFileAsync(GroupFileDto file)
    {
        await toolbar_!.RequestCloseAsync();
        await Task.Delay(50); // Wait for toolbar to close

        await Playback.LoadGroupMidiFile(file.Id);
    }

    

    private async Task OnClickTrackEnabledShellChangedAsync(bool enabled)
    {
        if (Playback.ClickTrackEnabled == enabled)
            return;

        await Playback.SetClickTrackEnabledAsync(enabled);
    }


    private string GetMetaInfo(MidiTrackInfo track)
    {
        return $"{track.NoteCount} note{(track.NoteCount == 1 ? "" : "s")}{(IsTrackAssigned(track) ? " - Assigned" : "")}";
    }
    private bool IsTrackAssigned(MidiTrackInfo track)
    {
        return Playback.Assignments.Any(a => a.Track?.Index == track.Index);
    }
}