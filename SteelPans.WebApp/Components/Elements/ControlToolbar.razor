@inject MidiPlaybackService Playback
@inject MidiLoaderService MidiService
@inject NavigationManager Nav
@inject ModalPopupService Modals
@inject DbService Db
@inject InstanceStateService State
@inject IJSRuntime JS
@implements IDisposable

<Toolbar @ref="toolbar_"
         ClosedIconClass="bi-gear-fill"
         MenuButtonLabel="Open Tools"
         MenuLabel="Pan Tools"
         Side="Toolbar.ToolbarSide.Left">

    <ToolbarElement Order="1"
                    Text="Import">
        <SubMenu>
            <AuthorizeView>
                <Authorized>
                    @if (groups_ is not null && groups_.Any(x => x.Value.Count > 0))
                    {
                        <ToolbarElement Order="1"
                                        Text="From Group"
                                        IconClass="bi-collection">
                            <SubMenu>
                                @foreach (var (group, files) in groups_.Where(x => x.Value.Count > 0))
                                {
                                    <ToolbarElement Text="@group.Name"
                                                    IconClass="bi-people">
                                        <ChildContent>
                                            <div class="pans-page__track-panel">
                                                <div class="pans-page__track-panel-header">
                                                    <span class="pans-page__track-panel-title">Ensemble Files</span>
                                                    <span class="pans-page__track-panel-count">@files.Count file@(files.Count == 1 ? "" : "s")</span>
                                                </div>

                                                <div class="pans-page__track-list">
                                                    @foreach (var file in files)
                                                    {
                                                        <div class="pans-page__track-item">
                                                            <div class="pans-page__track-details">
                                                                <div class="pans-page__track-name">@file.Title</div>
                                                                <div class="pans-page__track-meta">@file.OriginalFileName</div>
                                                            </div>

                                                            <button type="button"
                                                                    class="pans-page__track-button"
                                                                    aria-label="Load File"
                                                                    @onclick="() => LoadGroupMidiFileAsync(file)">
                                                                <span class="bi bi-download" aria-hidden="true"></span>
                                                            </button>
                                                        </div>
                                                    }
                                                </div>
                                            </div>
                                        </ChildContent>
                                    </ToolbarElement>
                                }
                            </SubMenu>
                        </ToolbarElement>
                    }
                </Authorized>
            </AuthorizeView>

            <ToolbarElement Order="2"
                            Text="MIDI File"
                            IconClass="bi-file-earmark-music"
                            LabelFor="midi-file-input" />

            <FileInput Id="midi-file-input"
                       OnSingleFileLoad="OnSingleMidiSelectedAsync"
                       OnMultipleFileLoad="OnMultipleMidiSelectedAsync"
                       Extensions="Midi.Extensions" />
        </SubMenu>
    </ToolbarElement>

    <ToolbarElement Order="2"
                    Text="Pans">
        <SubMenu>
            <ToolbarElement Order="1"
                            Text="Add"
                            IconClass="bi-plus-lg"
                            OnClick="() => OpenAddPanAsync(closeOthers: true)" />

                            
            @if (Playback.IsMidiLoaded)
            {
                <ToolbarElement Order="2"
                                Text="Tracks"
                                IconClass="bi-music-note-list"
                                Disabled="@(!Playback.Tracks.Any())"
                                CanExpand="true">
                    <ChildContent>
                        <div class="pans-page__track-panel">
                            <div class="pans-page__track-panel-header">
                                <span class="pans-page__track-panel-title">@Playback.IsMidiLoaded</span>
                                <span class="pans-page__track-panel-count">@Playback.Tracks.Count track@(Playback.Tracks.Count == 1 ? "" : "s")</span>
                            </div>

                            <div class="pans-page__track-list">
                                @foreach (var track in Playback.Tracks)
                                {
                                    <div class="pans-page__track-item">
                                        <div class="pans-page__track-details">
                                            <div class="pans-page__track-name">@track.Index) @track.DisplayInfo</div>
                                            <div class="pans-page__track-meta">@GetMetaInfo(track)</div>
                                        </div>

                                        <button type="button"
                                                class="pans-page__track-button @(IsTrackAssigned(track) ? "pans-page__track-button--assigned" : null)"
                                                aria-label="@(IsTrackAssigned(track) ? "Remove Track" : "Add Track")"
                                                @onclick="() => OnTrackButtonPressedAsync(track)">
                                            <span class="bi @(IsTrackAssigned(track) ? "bi-dash-lg" : "bi-plus-lg")" aria-hidden="true"></span>
                                        </button>
                                    </div>
                                }
                            </div>
                        </div>
                    </ChildContent>
                </ToolbarElement>
            }
        </SubMenu>
    </ToolbarElement>

    @if (Playback.ActivePans.Any())
    {
        <ToolbarElement Order="3"
                        Text="Music">
            <SubMenu>
                <ToolbarElement Order="1"
                                Text="Mixer"
                                IconClass="bi-sliders2-vertical"
                                Disabled="@(!Playback.ActivePans.Any())"
                                CanExpand="true"
                                CanMoveExpanded="true">
                    <ChildContent>
                        <VolumeMixer />
                    </ChildContent>
                </ToolbarElement>
                <ToolbarElement Order="2"
                                Text="Metronome"
                                IconClass="bi-music-note-beamed">
                    <HeaderActions>
                        <ToggleSwitch Value="@Playback.ClickTrackEnabled"
                                      ValueChanged="OnClickTrackEnabledShellChangedAsync"
                                      AriaLabel="Enable Metronome" />
                    </HeaderActions>
                    <ChildContent>
                        <Metronome />
                    </ChildContent>
                </ToolbarElement>

                <ToolbarElement Order="3"
                                Text="Chords"
                                IconClass="bi-music-note-list">
                    <ChildContent>
                        <ChordBuilder />
                    </ChildContent>
                </ToolbarElement>
            </SubMenu>
        </ToolbarElement>
    }
</Toolbar>

@code {
    private Toolbar? toolbar_;

    private bool anyPans_;

    private IReadOnlyDictionary<GroupSummaryDto, IReadOnlyList<GroupFileDto>>? groups_;

    protected override async Task OnInitializedAsync()
    {
        State.User.OnRefresh += OnUserRefreshAsync;
        Playback.AssignmentsChanged += OnAssignmentsChangedAsync;

        anyPans_ = Playback.ActivePans.Any();
        await OnUserRefreshAsync();
    }

    private async Task OnUserRefreshAsync()
    {
        groups_ = State.User.Groups?.ToDictionary(
            group => group,
            group => State.User.GroupFiles.TryGetValue(group.Id, out var files)
                ? files
                : []);
    }

    private async Task OnAssignmentsChangedAsync(PlaybackAssignmentsChangedEventArgs args)
    {
        if (anyPans_ && !Playback.ActivePans.Any())
        {
            anyPans_ = false;
            await InvokeAsync(StateHasChanged);
        }
        else if (!anyPans_ && Playback.ActivePans.Any())
        {
            anyPans_ = true;
            await InvokeAsync(StateHasChanged);
        }
    }

    private async Task OpenLogoutAsync()
    {
        await Modals.OpenAsync("Logout");
    }

    private async Task OpenAddPanAsync(bool closeOthers)
    {
        await Modals.OpenAsync("AddPan", new ModalOptions { CloseOthers = closeOthers });
    }

    private async Task OpenSaveLayoutAsync()
    {
        await Modals.OpenAsync("SaveLayout");
    }

    private async Task OpenRemovePanAsync(MidiTrackInfo track)
    {
        var pan = Playback.ActivePans.First(a => a.Assignment.Track?.Index == track.Index);
        await Modals.OpenAsync("RemovePan", pan);
    }




    private void NavigateToLogin()
    {
        Nav.NavigateTo("/account/login", forceLoad: true);
    }
    private void NavigateToRegister()
    {
        Nav.NavigateTo("/account/register", forceLoad: true);
    }
    private void NavigateToProfile()
    {
        Nav.NavigateTo("/account/profile");
    }



    private async Task OnTrackButtonPressedAsync(MidiTrackInfo track)
    {
        if (IsTrackAssigned(track))
        {
            await OpenRemovePanAsync(track);
            return;

        }

        await OpenAddPanAsync(closeOthers: false);
    }


    private async Task OnMultipleMidiSelectedAsync(IReadOnlyList<IBrowserFile> files)
    {
        await Modals.OpenAsync("MergeMidiFiles", files);
    }

    private async Task OnSingleMidiSelectedAsync(IBrowserFile file)
    {
        await Playback.OnLoadMidiAsync(async () =>
        {
            await using var stream = file.OpenReadStream(State.MaxMidiFileSize);
            return (file.Name, await MidiService.OpenMidiFileAsync(stream));
        });
    }

    private async Task LoadGroupMidiFileAsync(GroupFileDto file)
    {
        await toolbar_!.RequestCloseAsync();
        await Task.Delay(250); // Wait for toolbar to close

        await Playback.LoadGroupMidiFile(file.Id);
    }



    private async Task OnClickTrackEnabledShellChangedAsync(bool enabled)
    {
        if (Playback.ClickTrackEnabled == enabled)
            return;

        await Playback.SetClickTrackEnabledAsync(enabled);
    }


    private string GetMetaInfo(MidiTrackInfo track)
    {
        return $"{track.NoteCount} note{(track.NoteCount == 1 ? "" : "s")}{(IsTrackAssigned(track) ? " - Assigned" : "")}";
    }
    private bool IsTrackAssigned(MidiTrackInfo track)
    {
        return Playback.Assignments.Any(a => a.Track?.Index == track.Index);
    }


    public void Dispose()
    {
        State.User.OnRefresh -= OnUserRefreshAsync;
        Playback.AssignmentsChanged -= OnAssignmentsChangedAsync;
    }
}