@inject InstanceStateService State
@inject DbService Db

<div class="sp-app-card sp-app-card--wide midi-file-preview @(isPreviewOpen_ ? "" : "midi-file-preview--closed")">
    <div class="midi-file-preview-header">
        <h2>Track Assignments</h2>
        <button class="midi-file-preview-close"
                @onclick="ClosePreviewAsync">
            <span class="bi bi-x-lg"></span>
        </button>
    </div>
    <p class="midi-file-preview__meta"><strong>@State.Preview.File?.Title</strong> <span>@State.Preview.File?.OriginalFileName</span></p>

    <div class="midi-files-preview-files">
        <div class="sp-app-table-wrap">
            <table class="sp-app-table">
                <thead>
                    <tr>
                        <th>Track</th>
                        <th>Name</th>
                        <th>Pan</th>
                        <th>Label</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var track in State.Preview.File?.Tracks ?? [])
                    {
                        var assignment = State.Preview.Assigments.GetValueOrDefault(track.TrackIndex);

                        <tr>
                            <td>@(track.TrackIndex)</td>
                            <td>@(track.TrackName ?? "Unnamed")</td>
                            <td>
                                <select value="@(assignment?.PanType ?? PanType.LeadTenor)"
                                        @onchange="e => SetPanType(track.TrackIndex, e.Value?.ToString())">
                                    @foreach (var panType in panTypes_)
                                    {
                                        <option value="@panType">@panType.ToSpacedPascal()</option>
                                    }
                                </select>
                            </td>
                            <td>
                                <input value="@(assignment?.Label ?? track.TrackName ?? $"Track {track.TrackIndex}")"
                                       @onchange="e => SetLabel(track.TrackIndex, e.Value?.ToString())" />
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>

    <button class="sp-app-button sp-app-button--primary"
            type="button"
            @onclick="SaveAssignmentsAsync"
            disabled="@State.Task.Busy">
        Save
    </button>
</div>

@code {
    private readonly PanType[] panTypes_ = Enum.GetValues<PanType>();

    private bool isPreviewOpen_;
    private CancellationTokenSource? closeCts_;

    public async Task OpenPreviewAsync(Guid fileId)
    {
        await State.Preview.LoadAsync(fileId);

        closeCts_?.Cancel();
        isPreviewOpen_ = true;

        await InvokeAsync(StateHasChanged);
    }

    public async Task ClosePreviewAsync()
    {
        isPreviewOpen_ = false;

        closeCts_?.Cancel();
        closeCts_ = new();

        await InvokeAsync(StateHasChanged);
    }

    private void SetPanType(int trackIndex, string? value)
    {
        if (!Enum.TryParse<PanType>(value, out var panType))
            return;

        var current = State.Preview.Assigments[trackIndex];
        State.Preview.Assigments[trackIndex] = current with { PanType = panType };
    }

    private void SetLabel(int trackIndex, string? value)
    {
        var current = State.Preview.Assigments[trackIndex];
        State.Preview.Assigments[trackIndex] = current with
        {
            Label = string.IsNullOrWhiteSpace(value)
                ? $"Track {trackIndex + 1}"
                : value.Trim()
        };
    }

    private async Task SaveAssignmentsAsync()
    {
        if (State.Preview.File is null)
            return;

        await State.Task.RunSafe(async () =>
        {
            await Db.MidiFiles.SaveMidiAssignmentsAsync(
                State.Preview.File.Id,
                new SaveMidiAssignmentsRequest(
                    State.Preview.Assigments.Values
                        .OrderBy(x => x.TrackIndex)
                        .ToList()));

            return "Assignments saved.";
        });

        await InvokeAsync(StateHasChanged);
    }

    private async Task LoadFileDetailsAsync(Guid fileId)
    {
        await State.Preview.LoadAsync(fileId);

        closeCts_?.Cancel();
        isPreviewOpen_ = true;
    }
}