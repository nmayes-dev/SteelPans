@inject InstanceStateService State
@inject DbService Db

<div class="sp-app-card sp-app-card--wide midi-file-preview @(isPreviewOpen_ ? "" : "midi-file-preview--closed")">
    <div class="midi-file-preview-header">
        <h2>Track Assignments</h2>
        <button class="midi-file-preview-close"
                @onclick="ClosePreviewAsync">
            <span class="bi bi-x-lg"></span>
        </button>
    </div>
    <p class="midi-file-preview__meta"><strong>@file_?.OriginalFileName</strong></p>

    <div class="midi-files-preview-files">
        <div class="sp-app-table-wrap">
            <table class="sp-app-table">
                <thead>
                    <tr>
                        <th>Track</th>
                        <th>Name</th>
                        <th>Pan</th>
                        <th>Label</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var track in file_?.Tracks ?? [])
                    {
                        var assignment = assignments_.GetValueOrDefault(track.TrackIndex);

                        <tr>
                            <td>@(track.TrackIndex)</td>
                            <td>@(track.TrackName ?? "Unnamed")</td>
                            <td>
                                <select value="@(assignment?.PanType ?? PanType.LeadTenor)"
                                        disabled="@disabled_"
                                        @onchange="e => SetPanType(track.TrackIndex, e.Value?.ToString())">
                                    @foreach (var panType in panTypes_)
                                    {
                                        <option value="@panType">@panType.ToSpacedPascal()</option>
                                    }
                                </select>
                            </td>
                            <td>
                                <input value="@(assignment?.Label ?? track.TrackName ?? $"Track {track.TrackIndex}")"
                                       disabled="@disabled_"
                                       @onchange="e => SetLabel(track.TrackIndex, e.Value?.ToString())" />
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>

    @if (!disabled_)
    {
        <button class="sp-app-button sp-app-button--primary"
                type="button"
                @onclick="SaveAssignmentsAsync"
                disabled="@State.Task.Busy">
            Save
        </button>
    }
</div>

@code {
    private readonly PanType[] panTypes_ = Enum.GetValues<PanType>();

    [Parameter]
    public EventCallback OnSave { get; set; }

    [Parameter]
    public bool AllowEdit { get; set; }


    private bool disabled_ => file_?.OwnerId != State.User.Id && !AllowEdit;

    private bool isPreviewOpen_;
    private CancellationTokenSource? closeCts_;

    private MidiFileDetailsDto? file_;
    private Dictionary<int, MidiTrackAssignmentDto> assignments_ = [];

    public async Task TogglePreviewAsync(Guid fileId)
    {
        if (isPreviewOpen_ && file_?.Id == fileId)
            await ClosePreviewIfAsync(fileId);
        else
            await OpenPreviewAsync(fileId);
    }

    public async Task OpenPreviewAsync(Guid fileId)
    {
        await LoadFileDetailsAsync(fileId);
        await InvokeAsync(StateHasChanged);
    }

    public async Task ClosePreviewIfAsync(Guid fileId)
    {
        if (fileId != file_?.Id)
            return;

        await ClosePreviewAsync();
    }

    public async Task ClosePreviewAsync()
    {
        isPreviewOpen_ = false;

        closeCts_?.Cancel();
        closeCts_ = new();

        await InvokeAsync(StateHasChanged);
    }

    private void SetPanType(int trackIndex, string? value)
    {
        if (!Enum.TryParse<PanType>(value, out var panType))
            return;

        var current = assignments_[trackIndex];
        assignments_[trackIndex] = current with { PanType = panType };
    }

    private void SetLabel(int trackIndex, string? value)
    {
        var current = assignments_[trackIndex];
        assignments_[trackIndex] = current with
        {
            Label = string.IsNullOrWhiteSpace(value)
                ? $"Track {trackIndex + 1}"
                : value.Trim()
        };
    }

    private async Task SaveAssignmentsAsync()
    {
        if (file_ is null)
            return;

        await State.Task.RunSafe(async () =>
        {
            await Db.MidiFiles.SaveMidiAssignmentsAsync(
                file_.Id,
                new SaveMidiAssignmentsRequest(
                    assignments_.Values
                        .OrderBy(x => x.TrackIndex)
                        .ToList()));

            return "Assignments saved.";
        });

        await OnSave.InvokeAsync();
    }
        
    private async Task LoadFileDetailsAsync(Guid fileId)
    {
        var preview = await Db.MidiFiles.GetMidiFileDetailsAsync(fileId);

        if (preview is null)
            return;

        file_ = preview;
        assignments_ = preview.Tracks.ToDictionary(
            x => x.TrackIndex,
            x => preview.Assignments.FirstOrDefault(a => a.TrackIndex == x.TrackIndex)
                ?? new MidiTrackAssignmentDto(
                    x.TrackIndex,
                    x.SuggestedPanType ?? PanType.None,
                    x.TrackName ?? $"Track {x.TrackIndex + 1}"));

        closeCts_?.Cancel();
        isPreviewOpen_ = true;
    }
}