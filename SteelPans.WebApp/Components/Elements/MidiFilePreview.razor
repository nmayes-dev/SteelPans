@inject TaskRunnerService Tasks
@inject UserStateService UserState
@inject DbService Db
@inject AppUpdatesService Updates
@inject NavigationManager Nav
@implements IAsyncDisposable

<div class="sp-app-card sp-app-card--wide midi-file-preview @(IsPreviewOpen ? "" : "midi-file-preview--closed")">
    <div class="midi-file-preview-header">
        <span><strong>Tracks</strong> - @file_?.OriginalFileName</span>
        <button class="midi-file-preview-close"
                @onclick="ClosePreviewAsync">
            <span class="bi bi-x-lg"></span>
        </button>
    </div>
    <div class="midi-file-preview-files">
        <div class="sp-app-table-wrap">
            <table class="sp-app-table">
                <thead>
                    <tr>
                        <th>Track</th>
                        <th>Name</th>
                        <th>Pan</th>
                        <th>Label</th>
                        <th>Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var track in file_?.Tracks ?? [])
                    {
                        var assignment = assignments_.GetValueOrDefault(track.Id);

                        <tr>
                            <td>@(track.TrackIndex)</td>
                            <td>@(track.TrackName ?? "Unnamed")</td>
                            <td>
                                <select value="@(assignment?.PanType ?? PanType.LeadTenor)"
                                        disabled="@disabled_"
                                        @onchange="e => SetPanType(track.Id, e.Value?.ToString())">
                                    @foreach (var panType in panTypes_)
                                    {
                                        <option value="@panType">@panType.ToSpacedPascal()</option>
                                    }
                                </select>
                            </td>
                            <td>
                                <input value="@(assignment?.Label ?? track.TrackName ?? $"Track {track.TrackIndex}")"
                                       disabled="@disabled_"
                                       @onchange="e => SetLabel(track.Id, e.Value?.ToString())" />
                            </td>
                            <td>
                                @if (file_ is not null)
                                {
                                    <div class="midi-file-preview--actions">
                                        @if (AllowPractice)
                                        {
                                            <a class="sp-app-button sp-app-button--small" href="/play/solo?file=@file_.Id&track=@track.Id">Practice</a>
                                        }
                                        @if (CanEditTrack)
                                        {
                                            <a class="sp-app-button sp-app-button--small" href="@GetEditTrackHref(track.Id)">Edit</a>
                                        }
                                    </div>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>

    @if (!disabled_)
    {
        <button class="sp-app-button sp-app-button--primary"
                type="button"
                @onclick="SaveAssignmentsAsync"
                disabled="@Tasks.Busy">
            Save
        </button>
    }
</div>

@code {
    protected override void OnInitialized()
    {
        Updates.MidiAssignmentsChanged += OnRealtimeMidiAssignmentsChangedAsync;
    }

    private readonly PanType[] panTypes_ = Enum.GetValues<PanType>();

    [Parameter]
    public EventCallback OnSave { get; set; }

    [Parameter]
    public bool CloseOnSave { get; set; }

    [Parameter]
    public bool AllowPractice { get; set; }

    [Parameter]
    public bool AllowEdit { get; set; }


    private bool disabled_ => file_?.OwnerId != UserState.Id && !AllowEdit;
    private bool CanEditTrack => file_?.OwnerId == UserState.Id && AllowEdit;

    [Parameter]
    public string EditReturnTo { get; set; } = "create";

    public bool IsPreviewOpen { get; private set; }

    private MidiFileDetailsDto? file_;
    private Dictionary<Guid, MidiTrackAssignmentDto> assignments_ = [];

    public async Task TogglePreviewAsync(Guid fileId)
    {
        if (IsPreviewOpen && file_?.Id == fileId)
            await ClosePreviewIfAsync(fileId);
        else
            await OpenPreviewAsync(fileId);
    }

    public async Task OpenPreviewAsync(Guid fileId)
    {
        await LoadFileDetailsAsync(fileId);
        await InvokeAsync(StateHasChanged);
    }

    public async Task ClosePreviewIfAsync(Guid fileId)
    {
        if (fileId != file_?.Id)
            return;

        await ClosePreviewAsync();
    }

    public async Task ClosePreviewAsync()
    {
        IsPreviewOpen = false;
        await InvokeAsync(StateHasChanged);
    }


    private string GetEditTrackHref(Guid trackId)
    {
        if (file_ is null)
            return $"/arrangements/tracks/edit/{trackId}";

        var returnTo = Uri.EscapeDataString(EditReturnTo);
        return $"/arrangements/tracks/edit/{trackId}?file={file_.Id}&returnTo={returnTo}";
    }

    private void SetPanType(Guid trackId, string? value)
    {
        if (!Enum.TryParse<PanType>(value, out var panType))
            return;

        var current = assignments_[trackId];
        assignments_[trackId] = current with { PanType = panType };
    }

    private void SetLabel(Guid trackId, string? value)
    {
        var current = assignments_[trackId];
        assignments_[trackId] = current with
        {
            Label = string.IsNullOrWhiteSpace(value)
                ? $"Track {current.TrackIndex}"
                : value.Trim()
        };
    }

    private async Task SaveAssignmentsAsync()
    {
        if (file_ is null)
            return;

        await Tasks.RunSafe(async () =>
        {
            await Db.MidiFiles.SaveMidiAssignmentsAsync(
                file_.Id,
                new SaveMidiAssignmentsRequest(
                    assignments_.Values
                        .Where(x => x.PanType != PanType.None)
                        .OrderBy(x => x.TrackIndex)
                        .ToList()));

            return "Assignments saved.";
        });

        await OnSave.InvokeAsync();

        if (CloseOnSave)
            await ClosePreviewAsync();

    }

    private async Task LoadFileDetailsAsync(Guid fileId)
    {
        var preview = await Db.MidiFiles.GetMidiFileDetailsAsync(fileId);

        if (preview is null)
            return;

        file_ = preview;
        assignments_ = preview.Tracks.ToDictionary(
            x => x.Id,
            x => preview.Assignments.FirstOrDefault(a => a.TrackId == x.Id)
                ?? new MidiTrackAssignmentDto(
                    x.Id,
                    x.TrackIndex,
                    PanType.None,
                    x.TrackName ?? $"Track {x.TrackIndex}"));

        IsPreviewOpen = true;
    }

    private async Task OnRealtimeMidiAssignmentsChangedAsync(Guid fileId)
    {
        if (!IsPreviewOpen || file_?.Id != fileId)
            return;

        await LoadFileDetailsAsync(fileId);
        await InvokeAsync(StateHasChanged);
    }

    public ValueTask DisposeAsync()
    {
        Updates.MidiAssignmentsChanged -= OnRealtimeMidiAssignmentsChangedAsync;
        return ValueTask.CompletedTask;
    }

}