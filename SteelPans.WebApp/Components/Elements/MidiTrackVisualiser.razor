@inject IJSRuntime JS
@inject MidiPlaybackService Playback
@implements IAsyncDisposable

<div class="midi-track-visualiser midi-track-visualiser--@Mode.ToString().ToLowerInvariant()" @ref="root_" tabindex="0" @onkeydown="OnKeyDownAsync" @onkeydown:preventDefault="ShouldPreventKeyDefault">
    <div class="midi-track-visualiser__labels">
        <div class="midi-track-visualiser__corner" />
        <div class="midi-track-visualiser__track-label">
            <strong>@PanLabel</strong>
            @if (!string.IsNullOrWhiteSpace(TrackLabel))
            {
                <span>@TrackLabel</span>
            }
            <small>@VisualNoteCount note@(VisualNoteCount == 1 ? string.Empty : "s")</small>
        </div>
    </div>

    <div class="midi-track-visualiser__viewport" data-midi-track-visualiser-viewport>
        <div class="midi-track-visualiser__timeline" data-midi-track-visualiser-timeline>
            <div class="midi-track-visualiser__ruler" data-midi-track-visualiser-ruler></div>
            <div class="midi-track-visualiser__tracks" data-midi-track-visualiser-tracks></div>
        </div>
    </div>
</div>
