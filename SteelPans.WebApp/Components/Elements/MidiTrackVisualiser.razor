@inject IJSRuntime JS
@inject MidiManagerService MidiService
@implements IAsyncDisposable

<div class="midi-track-visualiser midi-track-visualiser--@Mode.ToString().ToLowerInvariant()" @ref="root_" tabindex="0">
    <div class="midi-track-visualiser__labels">
        <div class="midi-track-visualiser__corner">
            @if (HeaderContent is not null)
            {
                @HeaderContent
            }
            else
            {
                <strong>@PanLabel</strong>
            }
        </div>
        <div class="midi-track-visualiser__track-label">
            @if (TrackControls is not null)
            {
                <div class="midi-track-visualiser__track-controls">
                    @TrackControls
                </div>
            }
        </div>
    </div>

    
    <div class="midi-track-visualiser__display">
        <div class="midi-track-visualiser__slider">
            <TrackPlaybackSlider />
        </div>
        <div class="midi-track-visualiser__viewport" data-midi-track-visualiser-viewport>
            <div class="midi-track-visualiser__timeline" data-midi-track-visualiser-timeline>
                <div class="midi-track-visualiser__ruler" data-midi-track-visualiser-ruler />
                <div class="midi-track-visualiser__tracks" data-midi-track-visualiser-tracks />
            </div>
        </div>
    </div>

</div>
