@inject NavigationHistoryService NavigationHistory

<button type="button" class="@Class" disabled="@Disabled" @onclick="GoBack">@Text</button>

@code {
    [Parameter]
    public string FallbackUrl { get; set; } = "/";

    [Parameter]
    public string Class { get; set; } = "sp-app-button";

    [Parameter]
    public string Text { get; set; } = "Back";

    [Parameter]
    public bool Disabled { get; set; }

    private void GoBack() => NavigationHistory.Back(FallbackUrl);
}
