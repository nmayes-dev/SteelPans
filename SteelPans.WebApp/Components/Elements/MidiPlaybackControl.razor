@inject OverlayManagerService Overlays
@inject KeyboardManagerService Keyboard

<div class="midi-playback-control">
    <div>
        <TrackPlaybackSlider />
    </div>
    <div>
        <TrackPlaybackButtons Enabled=@Enabled
                              OnSeekStart="@OnSeekStart"
                              OnTogglePlayback="@OnTogglePlayback"
                              OnSkipToEnd="@OnSkipToEnd" />
    </div>
</div>

@code {
    [Parameter]
    public bool Enabled { get; set; } = false;

    [Parameter]
    public EventCallback OnSeekStart { get; set; }

    [Parameter]
    public EventCallback OnTogglePlayback { get; set; }

    [Parameter]
    public EventCallback OnSkipToEnd { get; set; }
}