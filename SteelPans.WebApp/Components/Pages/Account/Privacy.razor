@page "/account/privacy"
@inject IConfiguration Configuration

<PageTitle>Privacy Policy</PageTitle>

<article class="sp-app-page privacy-page">
    <div class="sp-app-section privacy-page-content">
        <header class="privacy-page-header">
            <h1>Privacy Policy</h1>
        </header>

        <section class="privacy-page-details">
            <div class="sp-app-card">
                <h2>Data We Collect</h2>
                <p>When you create an account, we collect your email address and a securely hashed password.</p>
            </div>
        
            <div class="sp-app-card">
                <h2>Why We Collect This Data</h2>
                <p>We use this information to:</p>
                <ul>
                    <li>Authenticate your account.</li>
                    <li>Provide password reset functionality.</li>
                    <li>Maintain the security of your account.</li>
                </ul>
            </div>

            <div class="sp-app-card">
                <h2>Legal Basis</h2>
                <p>We process this information because it is necessary to provide the account services you request.</p>
            </div>

            <div class="sp-app-card">
                <h2>Data Retention</h2>
                <p>Your account data is retained while your account remains active. You may request deletion of your account at any time.</p>
            </div>

            <div class="sp-app-card">
                <h2>Data Sharing</h2>
                <p>We do not sell or share your personal data with any third-parties.</p>
            </div>

            <div class="sp-app-card">
                <h2>Your Rights</h2>
                <p>You may request access to, correction of, or deletion of your personal data by contacting us.</p>
            </div>

            <div class="sp-app-card">
                <h2>Contact</h2>
                <p>For privacy-related questions, please contact <a href="@EmailLink" target="_blank">@Email</a></p>
            </div>
        </section>
    </div>
</article>

@code {
    private string Email => Configuration["Email:Username"] ?? throw new InvalidOperationException("Missing Email:Username");
    private string EmailLink => $"mailto:{Email}";
}