@page "/account/reset-password"
@using Microsoft.AspNetCore.Identity
@using Microsoft.AspNetCore.WebUtilities
@using System.Text
@using SteelPans.Shared.Auth
@inject UserManager<ApplicationUser> UserManager
@inject NavigationManager Nav

<PageTitle>Reset Password</PageTitle>

<section class="account-page">
    <div class="account-card">
        <div class="account-card__header">
            <p class="account-card__eyebrow">Steel Pans</p>
            <h1 class="account-card__title">Choose New Password</h1>
            <p class="account-card__subtitle">Enter a new password for your account.</p>
        </div>

        @if (!string.IsNullOrWhiteSpace(error_))
        {
            <p class="account-error">@error_</p>
        }

        @if (success_)
        {
            <p class="account-success">
                Password reset. You can now log in.
            </p>

            <a class="account-button account-button--primary" href="/account/login">
                Log in
            </a>
        }
        else
        {
            <form class="account-form" @onsubmit="SubmitAsync">
                <div class="account-field">
                    <label for="password">New password</label>
                    <input id="password"
                           @bind="password_"
                           type="password"
                           autocomplete="new-password"
                           required />
                </div>

                <div class="account-field">
                    <label for="confirm-password">Confirm password</label>
                    <input id="confirm-password"
                           @bind="confirmPassword_"
                           type="password"
                           autocomplete="new-password"
                           required />
                </div>

                <button class="account-button account-button--primary" type="submit">
                    Reset password
                </button>
            </form>
        }
    </div>
</section>

@code {
    [SupplyParameterFromQuery(Name = "userId")]
    public string? UserId { get; set; }

    [SupplyParameterFromQuery(Name = "token")]
    public string? Token { get; set; }

    private string? password_;
    private string? confirmPassword_;
    private string? error_;
    private bool success_;

    private async Task SubmitAsync()
    {
        error_ = null;

        if (string.IsNullOrWhiteSpace(UserId) ||
            string.IsNullOrWhiteSpace(Token))
        {
            error_ = "Invalid reset link.";
            return;
        }

        if (password_ != confirmPassword_)
        {
            error_ = "Passwords do not match.";
            return;
        }

        var user = await UserManager.FindByIdAsync(UserId);

        if (user is null)
        {
            error_ = "Invalid reset link.";
            return;
        }

        string token;

        try
        {
            token = Encoding.UTF8.GetString(WebEncoders.Base64UrlDecode(Token));
        }
        catch
        {
            error_ = "Invalid reset link.";
            return;
        }

        var result = await UserManager.ResetPasswordAsync(user, token, password_!);

        if (!result.Succeeded)
        {
            error_ = string.Join(" ", result.Errors.Select(x => x.Description));
            return;
        }

        success_ = true;
    }
}