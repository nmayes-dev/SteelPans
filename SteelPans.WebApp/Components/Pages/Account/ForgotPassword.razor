@page "/account/forgot-password"

@inject UserManager<ApplicationUser> UserManager
@inject NavigationManager Nav
@inject Microsoft.AspNetCore.Identity.UI.Services.IEmailSender EmailSender

<PageTitle>Forgot Password</PageTitle>

<section class="account-page">
    <div class="account-card">
        <div class="account-card__header">
            <h1 class="account-card__title">Reset password</h1>
            <p class="account-card__subtitle">Enter your email and we’ll send a reset link.</p>
        </div>

        @if (sent_)
        {
            <p class="account-success">
                If an account exists for that email, a reset link has been sent.
            </p>
        }
        else
        {
            <form class="account-form" @onsubmit="SubmitAsync">
                <div class="account-field">
                    <label for="email">Email</label>
                    <input id="email" @bind="email_" type="email" autocomplete="email" required />
                </div>

                <button class="account-button account-button--primary" type="submit">
                    Send reset link
                </button>
            </form>
        }
    </div>
</section>

@code {
    private string? email_;
    private bool sent_;

    private async Task SubmitAsync()
    {
        sent_ = true;

        if (string.IsNullOrWhiteSpace(email_))
        {
            return;
        }

        var user = await UserManager.FindByEmailAsync(email_);

        // Do not reveal whether the account exists.
        if (user is null)
        {
            return;
        }

        var token = await UserManager.GeneratePasswordResetTokenAsync(user);

        var encodedToken = WebEncoders.Base64UrlEncode(Encoding.UTF8.GetBytes(token));

        var resetPath = Nav.GetUriWithQueryParameters(
            "/account/reset-password",
            new Dictionary<string, object?>
            {
                ["userId"] = user.Id,
                ["token"] = encodedToken
            });

        var resetUrl = Nav.ToAbsoluteUri(resetPath).ToString();

        await EmailSender.SendEmailAsync(
            user.Email!,
            "Reset your Steel Pans password",
            $"""
            <p>Use the link below to reset your password:</p>
            <p><a href="{resetUrl}">Reset password</a></p>
            """);
    }
}