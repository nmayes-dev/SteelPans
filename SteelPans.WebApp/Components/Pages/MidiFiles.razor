@page "/midi-files"
@attribute [Authorize]
@inject DbService Db
@inject MidiInspectionService MidiInspection
@inject InstanceStateService State
@inject ModalPopupService Modals
@implements IDisposable

<PageTitle>MIDI Files</PageTitle>

<section class="sp-app-page midi-files">
    <div class="sp-app-page__header">
        <p class="sp-app-page__eyebrow">Ensemble Tools</p>
        <h1>MIDI Files</h1>
        <p>Preview a MIDI file locally, upload it, then share it with a group.</p>
    </div>

    <p class="sp-app-alert sp-app-alert--error @(string.IsNullOrWhiteSpace(State.Task.Error) ? "sp-app-alert--hidden" : "")">@State.Task.Error</p>
    <p class="sp-app-alert sp-app-alert--success @(string.IsNullOrWhiteSpace(State.Task.Message) ? "sp-app-alert--hidden" : "")">@State.Task.Message</p>

    <div class="sp-app-grid sp-app-grid--two midi-files__forms">
        <div class="sp-app-card sp-app-form midi-files__upload-card">
            <div class="midi-files__section-header">
                <h2>Preview and Upload</h2>
            </div>

            <div class="sp-app-form__row">
                <div class="sp-app-field">
                    <label for="midi-file">MIDI File</label>
                    <div class="midi-file-picker">
                        <label for="midi-file" class="midi-file-button">
                            Browse
                        </label>

                        <label for="midi-file"
                               class="midi-file-name @(string.IsNullOrWhiteSpace(selectedFile_?.Name) ? "midi-file-name--placeholder" : null)">
                            <span class="midi-file-name-text">@(selectedFile_?.Name ?? "No file selected")</span>
                        </label>
                        <InputFile id="midi-file"
                                   class="midi-file-input"
                                   OnChange="PreviewFileAsync"
                                   accept=".mid,.midi" />
                    </div>
                </div>
            </div>

            @if (localPreview_ is not null)
            {
                <div class="midi-files__preview">
                    <h3>Preview</h3>
                    <p><strong>@localFileName_</strong> - Tracks</p>
                    @RenderTracks(localPreview_)
                </div>
            }

            <button class="sp-app-button sp-app-button--primary"
                    type="button"
                    @onclick="UploadAsync"
                    disabled="@(selectedFile_ is null)">
                Upload
            </button>
        </div>

        <div class="sp-app-card midi-files__group-card">
            <div class="midi-files__section-header">
                <h2>Group Files</h2>
                <a class="sp-app-button" href="/groups">Manage Groups</a>
            </div>

            <div class="sp-app-field">
                <label for="group-file-select">Group</label>
                <select id="group-file-select" @bind="selectedGroupId_">
                    <option value="">Choose a group...</option>
                    @foreach (var group in State.User.Groups ?? [])
                    {
                        <option value="@group.Id">@group.Name</option>
                    }
                </select>
            </div>

            @if (selectedGroupId_ is null)
            {
                <p>Choose a group to show shared files.</p>
            }
            else if (SelectedFiles is null)
            {
                <p>Loading files...</p>
            }
            else if (SelectedFiles.Count == 0)
            {
                <p>No MIDI files have been shared with this group.</p>
            }
            else
            {
                <div class="sp-app-list">
                    @foreach (var file in SelectedFiles)
                    {
                        <article class="sp-app-list-item midi-files__list-item">
                            <div class="midi-files__item-copy">
                                <strong>@file.Title</strong>
                                <small>@file.OriginalFileName · @FormatSize(file.SizeBytes)</small>
                            </div>
                            
                            <div class="sp-app-list-item__actions">
                                @if (file.OwnerId == State.User.Id)
                                {
                                    <button class="sp-app-button sp-app-button--danger"
                                            type="button"
                                            @onclick="() => UnshareFileAsync(file.Id)">
                                        Unshare
                                    </button>
                                }
                                <button class="sp-app-button"
                                        type="button"
                                        @onclick="() => filePreview_!.TogglePreviewAsync(file.Id)">
                                    Preview
                                </button>
                            </div>
                        </article>
                    }
                </div>
            }
        </div>
    </div>

    <div class="sp-app-card sp-app-card--wide midi-file-list">
        <h2>My Files</h2>

        @if (State.User.Files is null)
        {
            <p>Loading files...</p>
        }
        else if (State.User.Files.Count == 0)
        {
            <p>You have not uploaded any MIDI files yet.</p>
        }
        else
        {
            <div class="sp-app-list">
                @foreach (var file in State.User.Files)
                {
                    var fileId = file.Id;
                    <article class="sp-app-list-item midi-files__list-item">
                        <div class="midi-files__item-copy">
                            <strong>@file.Title</strong>
                            <small>
                                @file.OriginalFileName · @FormatSize(file.SizeBytes) · @GetFileAccessLabel(file)
                            </small>
                        </div>

                        <div class="sp-app-list-item__actions">
                            <button class="sp-app-button"
                                    type="button"
                                    @onclick="() => filePreview_!.OpenPreviewAsync(fileId)">
                                Edit
                            </button>
                            <button class="sp-app-button sp-app-button--danger"
                                    type="button"
                                    @onclick="() => OpenDeleteFileModal(file)">
                                Delete
                            </button>

                            @{
                                var groups = State.User.Groups?
                                    .Where(DtoExtensions.CanManage)
                                    .Where(g => !file.SharedGroupIds.Contains(g.Id))
                                    .ToList() ?? [];
                            }

                            <select class="sp-app-button sp-app-select @(string.IsNullOrEmpty(GetTargetShareGroup(fileId)) ? "sp-app-select--placeholder" : "")"
                                    value="@GetTargetShareGroup(fileId)"
                                    @onchange="e => SetShareGroupId(fileId, e.Value?.ToString())"
                                    disabled="@(groups.Count == 0)">
                                <option disabled hidden value="">Share with...</option>

                                @foreach (var group in groups)
                                {
                                    <option value="@group.Id">@group.Name</option>
                                }
                            </select>

                            <button class="sp-app-button sp-app-button--primary"
                                    type="button"
                                    disabled="@(string.IsNullOrEmpty(GetTargetShareGroup(fileId)))"
                                    @onclick="() => ShareFileAsync(fileId)">
                                Share
                            </button>
                        </div>
                    </article>
                }
            </div>
        }
    </div>

    <MidiFilePreview @ref="filePreview_"
                     AllowEdit="@(SelectedGroup.CanManage())"
                     OnSave="StateHasChanged" />
</section>

@code {
    private Guid? selectedGroupId_;

    private IEnumerable<GroupSummaryDto> EditableGroups => State.User.Groups?.Where(DtoExtensions.CanManage) ?? [];
    private GroupSummaryDto? SelectedGroup => State.User.Groups?.FirstOrDefault(g => g.Id == selectedGroupId_);
    private IReadOnlyList<GroupFileDto>? SelectedFiles => State.User.GroupFiles.GetValueOrDefault(selectedGroupId_ ?? Guid.Empty);

    private IBrowserFile? selectedFile_;
    private byte[]? selectedFileBytes_;
    private string? localFileName_;
    private IReadOnlyList<MidiTrackInfo>? localPreview_;

    private Dictionary<Guid, string> targetShareGroups_ = new();
    private MidiFilePreview? filePreview_;

    protected override async Task OnInitializedAsync()
    {
        State.User.OnRefresh += OnUserStateRefreshAsync;
    }

    public void Dispose()
    {
        State.User.OnRefresh -= OnUserStateRefreshAsync;
    }

    private Task OnUserStateRefreshAsync()
    {
        foreach (var file in State.User.Files?.Where(x => !targetShareGroups_.ContainsKey(x.Id)) ?? [])
        {
            targetShareGroups_[file.Id] = string.Empty;
        }

        return InvokeAsync(StateHasChanged);
    }

    private string GetTargetShareGroup(Guid fileId)
    {
        return targetShareGroups_.GetValueOrDefault(fileId) ?? string.Empty;
    }

    private async Task PreviewFileAsync(InputFileChangeEventArgs args)
    {
        await filePreview_!.ClosePreviewAsync();

        selectedFile_ = args.File;
        localFileName_ = selectedFile_.Name;

        await State.Task.RunUnsafe(async () =>
        {
            await using var input = selectedFile_.OpenReadStream(maxAllowedSize: 25 * 1024 * 1024);
            using var buffer = new MemoryStream();
            await input.CopyToAsync(buffer);

            selectedFileBytes_ = buffer.ToArray();

            buffer.Position = 0;
            var midiFile = await MidiInspection.ReadAsync(buffer);
            localPreview_ = MidiInspection.GetTrackInfos(midiFile);
        });
    }

    private async Task UploadAsync()
    {
        if (selectedFile_ is null || selectedFileBytes_ is null)
            return;

        await State.Task.RunSafe(async () =>
        {
            await using var stream = new MemoryStream(selectedFileBytes_);

            var uploaded = await Db.MidiFiles.UploadMidiFileAsync(
                selectedFile_.Name,
                selectedFile_.ContentType,
                stream.Length,
                stream);

            await State.User.RefreshAsync();

            selectedFile_ = null;
            selectedFileBytes_ = null;
            localPreview_ = null;

            await filePreview_!.ClosePreviewAsync();

            return "MIDI file uploaded.";
        });
    }

    private async Task OpenDeleteFileModal(GroupFileDto file)
    {
        await Modals.OpenAsync("DeleteMidi", file, new ModalOptions { OnSuccess = () => filePreview_!.ClosePreviewIfAsync(file.Id) });
    }

    private async Task UnshareFileAsync(Guid fileId)
    {
        if (selectedGroupId_ is null)
        {
            return;
        }

        await State.Task.RunSafe(async () =>
        {
            await Db.MidiFiles.UnshareMidiFileWithGroupAsync(fileId, selectedGroupId_.Value);
            await State.User.RefreshAsync();

            return "MIDI file unshared from group.";

        });
    }

    private async Task ShareFileAsync(Guid fileId)
    {
        await State.Task.RunSafe(async () =>
        {
            if (!Guid.TryParse(targetShareGroups_[fileId], out var group))
                throw new InvalidOperationException("Target group id was not valid");

            await Db.MidiFiles.ShareMidiFileWithGroupAsync(fileId, group);
            await State.User.RefreshAsync();

            targetShareGroups_[fileId] = string.Empty;

            return "MIDI file shared with group.";
        });
    }

    private void SetShareGroupId(Guid fileId, string? value)
    {
        if (!Guid.TryParse(value, out var groupId))
            return;

        targetShareGroups_[fileId] = value;
    }

    private string GetFileAccessLabel(GroupFileDto file)
    {
        if (file.SharedGroupIds.Count == 0)
        {
            return "Private";
        }

        var groupNames = (State.User.Groups ?? [])
            .Where(x => file.SharedGroupIds.Contains(x.Id))
            .Select(x => x.Name)
            .ToList();

        return groupNames.Count switch
        {
            0 => $"Shared with {file.SharedGroupIds.Count} group(s)",
            1 => $"Shared with {groupNames[0]}",
            _ => $"Shared with {string.Join(", ", groupNames)}"
        };
    }

    private RenderFragment RenderTracks(IReadOnlyList<MidiTrackInfo> tracks) => @<div class="midi-track-list">
        @foreach (var track in tracks.Where(x => x.NoteCount > 0))
        {
            <div class="midi-track-list__item">
                <strong>@(track.Name ?? $"Track {track.Index + 1}")</strong>
                <span>@track.NoteCount notes</span>
            </div>
        }
    </div>;

    private static string FormatSize(long bytes)
    {
        if (bytes < 1024) return $"{bytes} B";
        if (bytes < 1024 * 1024) return $"{bytes / 1024d:0.#} KB";
        return $"{bytes / 1024d / 1024d:0.#} MB";
    }
}