@page "/midi-files"
@attribute [Authorize]
@inject DbService Db
@inject MidiInspectionService MidiInspection
@inject InstanceStateService State
@inject ModalPopupService Modals

<PageTitle>MIDI Files</PageTitle>

<section class="sp-app-page midi-files">
    <div class="sp-app-page__header">
        <p class="sp-app-page__eyebrow">Ensemble Tools</p>
        <h1>MIDI Files</h1>
        <p>Preview a MIDI file locally, upload it privately, then optionally share it with a group.</p>
    </div>

    <p class="sp-app-alert sp-app-alert--error @(string.IsNullOrWhiteSpace(State.Task.Error) ? "sp-app-alert--hidden" : "")">@State.Task.Error</p>
    <p class="sp-app-alert sp-app-alert--success @(string.IsNullOrWhiteSpace(State.Task.Message) ? "sp-app-alert--hidden" : "")">@State.Task.Message</p>

    <div class="sp-app-grid sp-app-grid--two midi-files-forms">
        <div class="sp-app-card sp-app-form">
            <h2>Preview and Upload</h2>

            <div class="sp-app-form__row">
                <div class="sp-app-field">
                    <label for="group-select">Upload Access</label>
                    <select id="group-select"
                            @bind="selectedGroupId_">
                        <option value="">No group yet</option>
                        @foreach (var group in State.User.Groups)
                        {
                            <option value="@group.Id">@group.Name</option>
                        }
                    </select>
                    <small>Leave this empty to upload the file privately.</small>
                </div>

                <div class="sp-app-field">
                    <label for="midi-file">MIDI file</label>
                    <div class="midi-file-picker">
                        <label for="midi-file" class="midi-file-button">
                            Browse
                        </label>

                        <label for="midi-file"
                               class="midi-file-name @(string.IsNullOrWhiteSpace(selectedFile_?.Name) ? "midi-file-name--placeholder" : null)">
                            <span class="midi-file-name-text">@(selectedFile_?.Name ?? "No file selected")</span>
                        </label>
                        <InputFile id="midi-file"
                                   class="midi-file-input"
                                   OnChange="PreviewFileAsync"
                                   accept=".mid,.midi" />
                    </div>
                </div>
            </div>

            @if (localPreview_ is not null)
            {
                <div class="midi-files__preview">
                    <h3>Preview</h3>
                    <p><strong>@localFileName_</strong> - Tracks</p>
                    @RenderTracks(localPreview_)
                </div>
            }

            <button class="sp-app-button sp-app-button--primary"
                    type="button"
                    @onclick="UploadAsync"
                    disabled="@(selectedFile_ is null || State.Task.Busy)">
                Upload
            </button>
        </div>

        <div class="sp-app-card">
            <h2>Group Files</h2>

            <div class="sp-app-field">
                <label for="group-file-select">Group</label>
                <select id="group-file-select" @bind="selectedGroupId_">
                    <option value="">Choose a group...</option>
                    @foreach (var group in State.User.Groups)
                    {
                        <option value="@group.Id">@group.Name</option>
                    }
                </select>
            </div>

            @if (selectedGroupId_ is null)
            {
                <p>Choose a group to show shared files.</p>
            }
            else if (SelectedFiles is null)
            {
                <p>Loading files...</p>
            }
            else if (SelectedFiles.Count == 0)
            {
                <p>No MIDI files have been shared with this group.</p>
            }
            else
            {
                <div class="sp-app-list">
                    @foreach (var file in SelectedFiles)
                    {
                        <article class="sp-app-list-item">
                            <div>
                                <strong>@file.Title</strong>
                                <small>@file.OriginalFileName · @FormatSize(file.SizeBytes)</small>
                            </div>
                            
                            <div class="sp-app-list-item__actions">
                                <button class="sp-app-button"
                                        type="button"
                                        @onclick="() => UnshareFileAsync(file.Id)">
                                    Unshare
                                </button>
                                <button class="sp-app-button"
                                        type="button"
                                        @onclick="() => LoadFileDetailsAsync(file.Id)">
                                    Preview
                                </button>
                            </div>
                        </article>
                    }
                </div>
            }
        </div>
    </div>

    <div class="sp-app-card sp-app-card--wide midi-file-list">
        <h2>My MIDI files</h2>

        @if (State.User.Files is null)
        {
            <p>Loading files...</p>
        }
        else if (State.User.Files.Count == 0)
        {
            <p>You have not uploaded any MIDI files yet.</p>
        }
        else
        {
            <div class="sp-app-list">
                @foreach (var file in State.User.Files)
                {
                    <article class="sp-app-list-item">
                        <div>
                            <strong>@file.Title</strong>
                            <small>
                                @file.OriginalFileName · @FormatSize(file.SizeBytes) · @GetFileAccessLabel(file)
                            </small>
                        </div>

                        <div class="sp-app-list-item__actions">
                            <button class="sp-app-button"
                                    type="button"
                                    @onclick="() => LoadFileDetailsAsync(file.Id)">
                                Preview
                            </button>
                            <button class="sp-app-button sp-app-button--danger"
                                    type="button"
                                    @onclick="() => OpenDeleteFileModal(file)">
                                Delete
                            </button>

                            @{
                                var groups = State.User.Groups
                                    .Where(g => !file.SharedGroupIds.Contains(g.Id))
                                    .ToList();
                            }

                            <select class="sp-app-button sp-app-select @(string.IsNullOrEmpty(targetShareGroup_) ? "sp-app-select--placeholder" : "")"
                                    value="@targetShareGroup_"
                                    @onchange="e => SetShareGroupId(e.Value?.ToString())"
                                    disabled="@(State.Task.Busy || groups.Count == 0)">
                                <option disabled hidden value="">Share with...</option>

                                @foreach (var group in groups)
                                {
                                    <option value="@group.Id">@group.Name</option>
                                }
                            </select>

                            <button class="sp-app-button sp-app-button--primary"
                                    type="button"
                                    disabled="@(!string.IsNullOrEmpty(targetShareGroup_) || State.Task.Busy)"
                                    @onclick="() => ShareFileAsync(file.Id)">
                                Share
                            </button>
                        </div>
                    </article>
                }
            </div>
        }
    </div>

    <div class="sp-app-card sp-app-card--wide midi-files-upload-preview @(isPreviewOpen_ ? "" : "midi-files-upload-preview-closed")">
        <div class="midi-files-upload-preview-header">
            <h2>Track Assignments</h2>
            <button class="midi-files-upload-preview-close"
                    @onclick="ClosePreviewAsync">
                <span class="bi bi-x-lg"></span>
            </button>
        </div>
        <p><strong>@State.Preview.File?.Title</strong> <span>@State.Preview.File?.OriginalFileName</span></p>

        <div class="sp-app-table-wrap">
            <table class="sp-app-table">
                <thead>
                    <tr>
                        <th>Track</th>
                        <th>Name</th>
                        <th>Pan</th>
                        <th>Label</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var track in State.Preview.File?.Tracks ?? [])
                    {
                        var assignment = State.Preview.Assigments.GetValueOrDefault(track.TrackIndex);

                        <tr>
                            <td>@(track.TrackIndex)</td>
                            <td>@(track.TrackName ?? "Unnamed")</td>
                            <td>
                                <select value="@(assignment?.PanType ?? PanType.LeadTenor)"
                                        @onchange="e => SetPanType(track.TrackIndex, e.Value?.ToString())">
                                    @foreach (var panType in panTypes_)
                                    {
                                        <option value="@panType">@panType.ToSpacedPascal()</option>
                                    }
                                </select>
                            </td>
                            <td>
                                <input value="@(assignment?.Label ?? track.TrackName ?? $"Track {track.TrackIndex}")"
                                       @onchange="e => SetLabel(track.TrackIndex, e.Value?.ToString())" />
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>

        <button class="sp-app-button sp-app-button--primary"
                type="button"
                @onclick="SaveAssignmentsAsync"
                disabled="@State.Task.Busy">
            Save Assignments
        </button>
    </div>
</section>

@code {
    private readonly PanType[] panTypes_ = Enum.GetValues<PanType>();

    private Guid? selectedGroupId_;
    private IReadOnlyList<GroupFileDto>? SelectedFiles => State.User.GroupFiles.GetValueOrDefault(selectedGroupId_ ?? Guid.Empty);

    private IBrowserFile? selectedFile_;
    private byte[]? selectedFileBytes_;
    private string? localFileName_;
    private IReadOnlyList<MidiTrackInfo>? localPreview_;

    private string targetShareGroup_ = string.Empty;

    private bool isPreviewOpen_;

    private CancellationTokenSource? closeCts_;

    protected override async Task OnInitializedAsync()
    {
        await State.User.RefreshAsync();
    }

    private async Task PreviewFileAsync(InputFileChangeEventArgs args)
    {
        isPreviewOpen_ = false;
        selectedFile_ = args.File;
        localFileName_ = selectedFile_.Name;

        await State.Task.RunUnsafe(async () =>
        {
            await using var input = selectedFile_.OpenReadStream(maxAllowedSize: 25 * 1024 * 1024);
            using var buffer = new MemoryStream();
            await input.CopyToAsync(buffer);

            selectedFileBytes_ = buffer.ToArray();

            buffer.Position = 0;
            var midiFile = await MidiInspection.ReadAsync(buffer);
            localPreview_ = MidiInspection.GetTrackInfos(midiFile);
        });
        
        selectedFile_ = null;
        selectedFileBytes_ = null;
        localPreview_ = null;
    }

    private async Task UploadAsync()
    {
        if (selectedFile_ is null || selectedFileBytes_ is null)
            return;

        await State.Task.RunSafe(async () =>
        {
            await using var stream = new MemoryStream(selectedFileBytes_);

            var uploaded = await Db.MidiFiles.UploadMidiFileAsync(
                selectedGroupId_,
                selectedFile_.Name,
                selectedFile_.ContentType,
                stream.Length,
                stream);

            await State.User.RefreshAsync();
            await LoadFileDetailsAsync(uploaded.Id);

            selectedFile_ = null;
            selectedFileBytes_ = null;
            localPreview_ = null;
            isPreviewOpen_ = false;

            return selectedGroupId_ is null
                ? "MIDI file uploaded privately."
                : "MIDI file uploaded and shared with group.";
        });
    }

    private async Task LoadFileDetailsAsync(Guid fileId)
    {
        await State.Preview.LoadAsync(fileId);

        closeCts_?.Cancel();
        isPreviewOpen_ = true;
    }

    private async Task OpenDeleteFileModal(GroupFileDto file)
    {
        State.Pending.DeleteMidi = file;
        await Modals.OpenAsync("DeleteMidi");
    }

    private async Task UnshareFileAsync(Guid fileId)
    {
        if (selectedGroupId_ is null)
        {
            return;
        }

        await State.Task.RunSafe(async () =>
        {
            await Db.MidiFiles.UnshareMidiFileWithGroupAsync(fileId, selectedGroupId_.Value);
            await State.User.RefreshAsync();

            return "MIDI file unshared from group.";

        });
    }

    private async Task ShareFileAsync(Guid fileId)
    {
        await State.Task.RunSafe(async () =>
        {
            if (!Guid.TryParse(targetShareGroup_, out var group))
                throw new InvalidOperationException("Target group id was not valid");

            await Db.MidiFiles.ShareMidiFileWithGroupAsync(fileId, group);            
            await State.User.RefreshAsync();

            return "MIDI file shared with group.";
        });
    }

    private void SetShareGroupId(string? value)
    {
        if (!Guid.TryParse(value, out var groupId))
            return;

        targetShareGroup_ = value;
    }

    private string GetFileAccessLabel(GroupFileDto file)
    {
        if (file.SharedGroupIds.Count == 0)
        {
            return "Private";
        }

        var groupNames = State.User.Groups
            .Where(x => file.SharedGroupIds.Contains(x.Id))
            .Select(x => x.Name)
            .ToList();

        return groupNames.Count switch
        {
            0 => $"Shared with {file.SharedGroupIds.Count} group(s)",
            1 => $"Shared with {groupNames[0]}",
            _ => $"Shared with {string.Join(", ", groupNames)}"
        };
    }

    private void SetPanType(int trackIndex, string? value)
    {
        if (!Enum.TryParse<PanType>(value, out var panType))
        {
            return;
        }

        var current = State.Preview.Assigments[trackIndex];
        State.Preview.Assigments[trackIndex] = current with { PanType = panType };
    }

    private void SetLabel(int trackIndex, string? value)
    {
        var current = State.Preview.Assigments[trackIndex];
        State.Preview.Assigments[trackIndex] = current with
        {
            Label = string.IsNullOrWhiteSpace(value)
                ? $"Track {trackIndex + 1}"
                : value.Trim()
        };
    }

    private async Task SaveAssignmentsAsync()
    {
        if (State.Preview.File is null)
            return;

        await State.Task.RunSafe(async () =>
        {
            await Db.MidiFiles.SaveMidiAssignmentsAsync(
                State.Preview.File.Id,
                new SaveMidiAssignmentsRequest(
                    State.Preview.Assigments.Values
                        .OrderBy(x => x.TrackIndex)
                        .ToList()));

            await LoadFileDetailsAsync(State.Preview.File.Id);

            return "Assignments saved.";
        });
    }

    private async Task ClosePreviewAsync()
    {
        isPreviewOpen_ = false;

        closeCts_?.Cancel();
        closeCts_ = new();
    }

    private RenderFragment RenderTracks(IReadOnlyList<MidiTrackInfo> tracks) => @<div class="midi-track-list">
        @foreach (var track in tracks.Where(x => x.NoteCount > 0))
        {
            <div class="midi-track-list__item">
                <strong>@(track.Name ?? $"Track {track.Index + 1}")</strong>
                <span>@track.NoteCount notes</span>
            </div>
        }
    </div>;

    private static string FormatSize(long bytes)
    {
        if (bytes < 1024) return $"{bytes} B";
        if (bytes < 1024 * 1024) return $"{bytes / 1024d:0.#} KB";
        return $"{bytes / 1024d / 1024d:0.#} MB";
    }
}