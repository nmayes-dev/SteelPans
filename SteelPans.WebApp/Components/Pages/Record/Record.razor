@page "/record"
@attribute [Authorize]
@inject RecordDraftService Draft

<PageTitle>Record</PageTitle>

<section class="sp-app-page record-home-page">
    <div class="sp-app-page__header record-home-page__header">
        <p class="sp-app-page__eyebrow">Steel Pans</p>
        <h1>Record</h1>
        <p>Create recorded pan tracks, assemble them into MIDI files, then save them to your file store.</p>
    </div>

    <div class="sp-app-grid sp-app-grid--two record-home-page__grid">
        <a class="sp-app-card record-home-page__card" href="/record/tracks/create">
            <span class="record-home-page__icon bi bi-record-circle" aria-hidden="true"></span>
            <div>
                <h2>Create Track</h2>
                <p>Record one pan part with a visualiser, then edit note positions and lengths.</p>
                <small>@Draft.Tracks.Count draft track@(Draft.Tracks.Count == 1 ? "" : "s")</small>
            </div>
        </a>

        <a class="sp-app-card record-home-page__card" href="/record/files/create">
            <span class="record-home-page__icon bi bi-file-earmark-music" aria-hidden="true"></span>
            <div>
                <h2>Create File</h2>
                <p>Combine recorded tracks and save them as a MIDI file.</p>
                <small>Save to database and file store</small>
            </div>
        </a>
    </div>
</section>
