@page "/manage/groups/join/{Token}"
@attribute [Authorize]
@inject DbService Db
@inject NavigationManager Nav
@inject InstanceStateService State

<PageTitle>Join Group</PageTitle>

<section class="sp-app-page sp-app-page--join join-group">
    <div class="sp-app-card sp-app-card--centered">
        <p class="sp-app-page__eyebrow">Group Invite</p>

        @if (State.Task.Busy)
        {
            <p>Checking invite link...</p>
        }
        else if (!string.IsNullOrWhiteSpace(State.Task.Error))
        {
            <p class="sp-app-alert sp-app-alert--error">@State.Task.Error</p>
            <a class="sp-app-button" href="/manage/groups">Go to groups</a>
        }
        else
        {
            <p>@State.Task.Message</p>
        }
    </div>
</section>

@code {
    [Parameter]
    public string Token { get; set; } = "";

    private const int DelayMilliseconds = 2000;

    private GroupSummaryDto? joinedGroup_;

    protected override async Task OnInitializedAsync()
    {
        var findSuccess = await State.Task.RunSafe(GetGroupAsync);
        await InvokeAsync(StateHasChanged);

        if (!findSuccess)
            return;

        await Task.Delay(DelayMilliseconds);

        var joinSuccess = await State.Task.RunSafe(JoinGroupAsync);
        await InvokeAsync(StateHasChanged);

        if (joinSuccess)
            _ = Task.Delay(DelayMilliseconds).ContinueWith(_ => Nav.NavigateTo($"/manage/groups/{joinedGroup_!.Id}"));
    }

    private async Task<string> GetGroupAsync()
    {
        var group = await Db.Groups.GetGroupAsync(Token);
        if (group is null)
            throw new ApplicationException("Failed to find group, invalid or expire link.");

        return $"Joining {group.Name}...";
    }

    private async Task<string> JoinGroupAsync()
    {
        joinedGroup_ = await Db.Groups.JoinGroupAsync(Token);
        if (joinedGroup_ is null)
            throw new ApplicationException("Failed to join group, please contact system admin.");

        return $"Successfully joined {joinedGroup_.Name}, redirecting...";
    }
}
