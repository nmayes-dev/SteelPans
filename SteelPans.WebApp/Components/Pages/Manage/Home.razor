@page "/groups"
@attribute [Authorize]
@inject InstanceStateService State
@implements IDisposable

<PageTitle>Groups</PageTitle>

<section class="sp-app-page groups-page groups-home">
    <div class="sp-app-page__header groups-home__header">
        <p class="sp-app-page__eyebrow">Ensemble Tools</p>
        <h1>Groups</h1>
        <p>Manage ensemble groups, invite members, and control shared MIDI access.</p>

        <p class="sp-app-alert sp-app-alert--error @(string.IsNullOrWhiteSpace(State.Task.Error) ? "sp-app-alert--hidden" : "")">@State.Task.Error</p>
        <p class="sp-app-alert sp-app-alert--success @(string.IsNullOrWhiteSpace(State.Task.Message) ? "sp-app-alert--hidden" : "")">@State.Task.Message</p>
    </div>

    <div class="groups-home__actions">
        <a class="sp-app-button sp-app-button--primary" href="/groups/create">Create Group</a>
        <a class="sp-app-button" href="/midi-files">My MIDI files</a>
    </div>

    <div class="sp-app-card groups-home__card">
        <div class="groups-home__card-header">
            <h2>Your Groups</h2>
            <small>@(State.User.Groups?.Count ?? 0) group@((State.User.Groups?.Count ?? 0) == 1 ? "" : "s")</small>
        </div>

        @if (State.User.Groups is null)
        {
            <p>Loading groups...</p>
        }
        else if (State.User.Groups.Count == 0)
        {
            <p>No groups yet. Create a group to start sharing MIDI files with members.</p>
        }
        else
        {
            <div class="sp-app-list groups-home__list">
                @foreach (var group in State.User.Groups)
                {
                    <article class="sp-app-list-item groups-home__group">
                        <div class="groups-home__copy">
                            <strong>@group.Name</strong>
                            <small>@group.Role</small>
                        </div>

                        <div class="sp-app-list-item__actions">
                            <a class="sp-app-button sp-app-button--primary" href="/groups/@group.Id">@(group.CanManage() ? "Manage" : "View")</a>
                        </div>
                    </article>
                }
            </div>
        }
    </div>
</section>

@code {
    private Task OnRefreshAsync()
    {
        return InvokeAsync(StateHasChanged);
    }

    protected override void OnInitialized()
    {
        State.User.OnRefresh += OnRefreshAsync;
    }

    public void Dispose()
    {
        State.User.OnRefresh -= OnRefreshAsync;
    }
}