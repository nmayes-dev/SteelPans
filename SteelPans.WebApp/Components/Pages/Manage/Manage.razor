@page "/manage"
@attribute [Authorize]
@inject InstanceStateService State
@implements IDisposable

<PageTitle>Manage</PageTitle>

<section class="sp-app-page manage-home-page">
    <div class="sp-app-page__header manage-home-page__header">
        <p class="sp-app-page__eyebrow">Steel Pans</p>
        <h1>Manage</h1>
        <p>Manage groups, MIDI files, uploads, assignments, and sharing.</p>

        <p class="sp-app-alert sp-app-alert--error @(!string.IsNullOrWhiteSpace(State.Task.Error) ? "sp-app-alert--visible" : "")">@State.Task.Error</p>
        <p class="sp-app-alert sp-app-alert--success @(!string.IsNullOrWhiteSpace(State.Task.Message) ? "sp-app-alert--visible" : "")">@State.Task.Message</p>
        <a class="sp-app-button" href="/">Back</a>
    </div>

    <div class="sp-app-grid sp-app-grid--two manage-home-page__grid">
        <a class="sp-app-card manage-home-page__card" href="/manage/groups">
            <span class="manage-home-page__icon bi bi-people" aria-hidden="true"></span>
            <div class="manage-home-page__copy">
                <h2>Groups</h2>
                <p>Manage ensemble groups, members, invites, and shared MIDI access.</p>
                <small>@(State.User.Groups?.Count ?? 0) group@((State.User.Groups?.Count ?? 0) == 1 ? "" : "s")</small>
            </div>
        </a>

        <a class="sp-app-card manage-home-page__card" href="/manage/midi">
            <span class="manage-home-page__icon bi bi-music-note-list" aria-hidden="true"></span>
            <div class="manage-home-page__copy">
                <h2>MIDI Files</h2>
                <p>Upload files, edit track assignments, and share files with groups.</p>
                <small>@(State.User.Files?.Count ?? 0) file@((State.User.Files?.Count ?? 0) == 1 ? "" : "s")</small>
            </div>
        </a>
    </div>
</section>

@code {
    protected override void OnInitialized()
    {
        State.User.OnRefresh += OnRefreshAsync;
    }

    private Task OnRefreshAsync()
    {
        return InvokeAsync(StateHasChanged);
    }

    public void Dispose()
    {
        State.User.OnRefresh -= OnRefreshAsync;
    }
}
