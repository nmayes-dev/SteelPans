@page "/play/ensemble"
@inject SteelPanLoaderService PanLoader
@inject MidiManagerService MidiService
@inject DbService Db
@inject NavigationManager Nav
@inject ModalPopupService Modals
@inject TaskRunnerService Tasks
@inject IJSRuntime JS

<PageTitle>Band</PageTitle>

@if (loadingFile_)
{
    <section class="sp-app-page band-page__loading">
        <LoadingSpinner Text="Loading ensemble..." />
    </section>
}
else
{
    <div class="band-page">
        @if (MidiService.Playback.AvailablePans.Count > 0)
        {
            <PracticeHeader />

            <p class="sp-app-alert sp-app-alert--error @(!string.IsNullOrWhiteSpace(Tasks.Error) ? "sp-app-alert--visible" : "sp-app-alert--hidden")">@Tasks.Error</p>

            <section class="band-page__content">
                <PansLayout Pans="@MidiService.Playback.ActivePans" >
                    <TopRightContent Context="assignedPan">
                        <button type="button"
                                class="band-page__remove-button"
                                title="Remove"
                                aria-label="Remove"
                                data-pan-layout-no-drag
                                @onclick="() => OnRemovePan(assignedPan)">
                            <span class="bi bi-trash3"></span>
                        </button>
                    </TopRightContent>
                </PansLayout>
            </section>
        }
    </div>
}
