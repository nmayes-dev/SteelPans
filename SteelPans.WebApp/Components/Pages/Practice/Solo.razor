@page "/play/solo"
@inject MidiPlaybackService Playback
@inject UserStateService UserState
@inject ModalPopupService Modals
@inject MidiFileService MidiService
@implements IAsyncDisposable

<PageTitle>Practice</PageTitle>

@if (!Playback.IsMidiLoaded)
{
    <section class="sp-app-page">
        <div class="sp-app-card practice-page__empty-card">
            <h2>No MIDI file loaded</h2>
            <p>Open a MIDI file, or use a practice link from an assigned file.</p>
            <AuthorizeView>
                <Authorized Context="auth">
                    <div class="practice-page__actions">
                        <a class="sp-app-button" href="/play/ensemble@(FileId is null ? string.Empty : $"?file={FileId}")">Band</a>
                        <a class="sp-app-button" href="/arrangements">MIDI Files</a>
                    </div>
                </Authorized>
                <NotAuthorized>
                    <div class="practice-page__load">
                        <a class="sp-app-button sp-app-button--secondary" href="/play">Back</a>
                        <label for="practice-page-file-input" class="sp-app-button sp-app-button--primary">Load</label>
                        <FileInput Id="practice-page-file-input"
                                   OnSingleFileLoad="OnSingleMidiSelectedAsync"
                                   OnMultipleFileLoad="OnMultipleMidiSelectedAsync"
                                   Extensions="Midi.Extensions" />
                    </div>
                </NotAuthorized>
            </AuthorizeView>
        </div>
    </section>
}
else if (Playback.Tracks.Count == 0)
{
    <section class="sp-app-page">
        <div class="sp-app-card practice-page__empty-card">
            <h2>No Playable MIDI tracks</h2>
            <p>@Playback.MidiFileName is loaded, but no tracks containing notes were found.</p>
            <AuthorizeView>
                <Authorized Context="auth">
                    <a class="sp-app-button sp-app-button--primary" href="/arrangements@(FileId is null ? string.Empty : $"/{FileId}")">View File</a>
                </Authorized>
                <NotAuthorized>
                    <div class="practice-page__load">
                        <a class="sp-app-button sp-app-button--secondary" href="/play">Back</a>
                        <label for="practice-page-file-input" class="sp-app-button sp-app-button--primary">Load</label>
                        <FileInput Id="practice-page-file-input"
                                   OnSingleFileLoad="OnSingleMidiSelectedAsync"
                                   OnMultipleFileLoad="OnMultipleMidiSelectedAsync"
                                   Extensions="Midi.Extensions" />
                    </div>
                </NotAuthorized>
            </AuthorizeView>
        </div>
    </section>
}
else if (Playback.Assignments.Count == 0)
{
    <section class="sp-app-page">
        <div class="sp-app-card practice-page__empty-card">
            <h2>No Assigned Tracks</h2>
            <p>@Playback.MidiFileName is loaded, but no pans were assigned to any tracks.</p>
            <AuthorizeView>
                <Authorized Context="auth">
                    @if (FileId is not null)
                    {
                        <button class="sp-app-button sp-app-button--primary" @onclick="() => TogglePreviewAsync(FileId.Value)">Tracks</button>
                        <MidiFilePreview @ref="filePreview_"/>
                    }
                    else
                    {
                        <a class="sp-app-button sp-app-button--primary" href="/arrangements@(FileId is null ? string.Empty : $"/{FileId}")">Arrangements</a>
                    }
                </Authorized>
                <NotAuthorized>
                    <div class="practice-page__load">
                        <a class="sp-app-button sp-app-button--secondary" href="/play">Back</a>
                        <ExpandingOverlay Title="Add Pans" Text="Tracks" ExpandDirection="ExpandingOverlay.Direction.Right" ClosedIconClass="x-lg">
                            <MidiTrackList Tracks="Playback.Tracks" />
                         </ExpandingOverlay>
                    </div>
                </NotAuthorized>
            </AuthorizeView>
        </div>
    </section>
}
else
{
    <section class="sp-app-page practice-page">
        <div class="practice-page__control">
            <div class="sp-app-card practice-page__track">
                <div class="practice-page__field">
                    <span>Track</span>
                    <select class="sp-min-content" value="@SelectedTrackId" @onchange="OnSelectedTrackChangedAsync">
                        @foreach (var assignment in Playback.Assignments.Where(x => x.TrackId is not null))
                        {
                            var track = Playback.GetTrackForAssignment(assignment);
                            <option value="@assignment.TrackId">@track?.DisplayInfo</option>
                        }
                    </select>
                </div>
                <div class="practice-page__field practice-page__field-controls">
                    <label class="practice-page__assign">
                        <span>Assign</span>
                        <ExpandingOverlay Title="Add Assignments" ExpandDirection="ExpandingOverlay.Direction.Right" ClosedIconClass="plus-lg">
                            <MidiTrackList Tracks="Playback.Tracks" />
                        </ExpandingOverlay>
                    </label>
                    <label class="practice-page__checkbox">
                        <span>Solo</span>
                        <ToggleSwitch Value="@soloTrack_" ValueChanged="OnAllowOtherTrackAudioChangedAsync" />
                    </label>
                </div>
            </div>
            <PracticeHeader />
        </div>

        
        @if (SelectedAssignedPan is not null)
        {
            <MidiTrackVisualiser TrackIndex="@(SelectedTrack?.Index ?? 0)"
                                 PanLabel="@AssignedPanLabel"
                                 TrackLabel="@SelectedTrackLabel"
                                 Notes="@SelectedTrackEvents"
                                 MinSemitone="SelectedPanMinSemitone"
                                 MaxSemitone="SelectedPanMaxSemitone"
                                 Duration="@VisualDuration"
                                 TempoBpm="@Playback.TempoBpm"
                                 InitialMidiBpm="@Playback.InitialMidiBpm"
                                 BeatsPerBar="@Playback.BeatsPerBar"
                                 BeatUnit="@Playback.BeatUnit" />

            <PansLayout Pans="@SelectedPanList"
                        Locked="true" />
        }
    </section>
}

@code {
    [SupplyParameterFromQuery(Name = "file")]
    public Guid? FileId { get; set; }

    [SupplyParameterFromQuery(Name = "track")]
    public Guid? Track { get; set; }

    private MidiFilePreview? filePreview_;

    private bool loadedFileFromQuery_;
    private bool soloTrack_ = true;
    private Guid? selectedTrackId_;

    private Guid? SelectedTrackId => selectedTrackId_ ?? Track ?? Playback.Assignments.FirstOrDefault()?.TrackId;
    private MidiTrackInfo? SelectedTrack => SelectedTrackId is Guid trackId ? Playback.Tracks.FirstOrDefault(x => x.Id == trackId) : null;
    private MidiAssignedPan? SelectedAssignedPan => SelectedTrackId is Guid trackId ? Playback.GetAssignedPanForTrack(trackId) : null;
    private IReadOnlyList<MidiAssignedPan> SelectedPanList => SelectedAssignedPan is null ? [] : [SelectedAssignedPan];
    private int? SelectedPanMinSemitone => SelectedAssignedPan?.Pan.Notes.Select(x => x.Note.SemitoneNumber).DefaultIfEmpty().Min();
    private int? SelectedPanMaxSemitone => SelectedAssignedPan?.Pan.Notes.Select(x => x.Note.SemitoneNumber).DefaultIfEmpty().Max();

    private IReadOnlyList<MidiPanEvent> SelectedTrackEvents => (SelectedTrackId is Guid trackId ? Playback.GetMidiTrackEvents(trackId) : [])
        .OrderBy(x => x.Start)
        .ThenBy(x => x.Note.SemitoneNumber)
        .ToList();

    private int AssignedTrackCount => Playback.ActivePans.Count;
    private string AssignedPanLabel => SelectedAssignedPan?.Pan.Type.ToSpacedPascal() ?? "Unassigned";
    private string? SelectedTrackLabel => SelectedTrack?.TrackLabel ?? SelectedTrack?.Name;

    private TimeSpan VisualDuration
    {
        get
        {
            var selectedEnd = SelectedTrackEvents
                .DefaultIfEmpty()
                .Max(x => x is null ? TimeSpan.Zero : x.End);

            return selectedEnd > Playback.Duration ? selectedEnd : Playback.Duration;
        }
    }

    protected override async Task OnInitializedAsync()
    {
        Playback.MidiFileUnloaded += OnPlaybackStateChangedAsync;
        Playback.AssignmentsChanged += OnPlaybackStateChangedAsync;

        if (loadedFileFromQuery_ || FileId is null)
            return;

        loadedFileFromQuery_ = true;
        await Playback.LoadGroupMidiFile(FileId.Value);
        EnsureSelectedTrack();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender)
            return;

        await ApplySelectedTrackSoloAsync();
    }

    private async Task TogglePreviewAsync(Guid file)
    {
        if (filePreview_ is null)
            return;

        await filePreview_.TogglePreviewAsync(file);
        await InvokeAsync(StateHasChanged);
    }

    private async Task OnSelectedTrackChangedAsync(ChangeEventArgs args)
    {
        if (Guid.TryParse(args.Value?.ToString(), out var trackId))
            selectedTrackId_ = trackId;

        await ApplySelectedTrackSoloAsync();
        await InvokeAsync(StateHasChanged);
    }

    private async Task OnAllowOtherTrackAudioChangedAsync(bool solo)
    {
        soloTrack_ = solo;
        await ApplySelectedTrackSoloAsync();
    }

    private async Task ApplySelectedTrackSoloAsync()
    {
        if (SelectedAssignedPan is null)
            return;

        await Playback.SetPanSoloingAsync(SelectedAssignedPan, soloTrack_);
    }

    private async Task OnPlaybackStateChangedAsync<TArgs>(TArgs _)
    {
        EnsureSelectedTrack();
        await ApplySelectedTrackSoloAsync();
        await InvokeAsync(StateHasChanged);
    }

    private async Task OnMultipleMidiSelectedAsync(IReadOnlyList<IBrowserFile> files)
    {
        await Modals.OpenAsync("MergeMidiFiles", files);
    }

    private async Task OnSingleMidiSelectedAsync(IBrowserFile file)
    {
        await Playback.OnLoadMidiAsync(async () =>
        {
            await using var stream = file.OpenReadStream(UserState.MaxMidiFileSize);
            return (Guid.NewGuid(), file.Name, await MidiService.OpenMidiFileAsync(stream));
        });
    }

    private void EnsureSelectedTrack()
    {
        if (Playback.Tracks.Count == 0)
        {
            selectedTrackId_ = null;
            return;
        }

        if (selectedTrackId_ is null && Track is not null && Playback.Tracks.Any(x => x.Id == Track.Value))
        {
            selectedTrackId_ = Track.Value;
            return;
        }

        if (selectedTrackId_ is null || Playback.Tracks.All(x => x.Id != selectedTrackId_))
            selectedTrackId_ = Playback.Tracks[0].Id;
    }

    private static string FormatTime(TimeSpan time)
    {
        return time.TotalHours >= 1
            ? $"{(int)time.TotalHours}:{time.Minutes:00}:{time.Seconds:00}"
            : $"{time.Minutes}:{time.Seconds:00}.{time.Milliseconds:000}";
    }

    private static string Plural(int count) => count == 1 ? string.Empty : "s";

    public ValueTask DisposeAsync()
    {
        Playback.MidiFileUnloaded -= OnPlaybackStateChangedAsync;
        Playback.AssignmentsChanged -= OnPlaybackStateChangedAsync;
        return ValueTask.CompletedTask;
    }
}
