@page "/play"
@inject TaskRunnerService Tasks

<PageTitle>Play</PageTitle>

<section class="sp-app-page practice-home-page">
    <div class="sp-app-page__header practice-home-page__header">
        <p class="sp-app-page__eyebrow">Steel Pans</p>
        <h1>Play</h1>
        <p>Play full ensemble demos, or practise an individual assigned track.</p>

        <p class="sp-app-alert sp-app-alert--error @(string.IsNullOrWhiteSpace(Tasks.Error) ? "sp-app-alert--hidden" : "")">@Tasks.Error</p>
        <p class="sp-app-alert sp-app-alert--success @(string.IsNullOrWhiteSpace(Tasks.Message) ? "sp-app-alert--hidden" : "")">@Tasks.Message</p>
        <BackButton FallbackUrl="/" />
    </div>

    <div class="sp-app-grid sp-app-grid--two practice-home-page__grid">

        <a class="sp-app-card practice-home-page__card" href="/play/ensemble">
            <span class="practice-home-page__icon bi bi-soundwave" aria-hidden="true"></span>
            <div class="practice-home-page__copy">
                <h2>Band</h2>
                <p>Load a MIDI file and play all assigned pans together.</p>
            </div>
        </a>

        <a class="sp-app-card practice-home-page__card" href="/play/solo">
            <span class="practice-home-page__icon bi bi-vinyl" aria-hidden="true"></span>
            <div class="practice-home-page__copy">
                <h2>Practice</h2>
                <p>Work on one assigned track with playback, a visualiser, and a single pan.</p>
            </div>
        </a>
    </div>
</section>

