@page "/groups/{GroupId:guid}"
@attribute [Authorize]
@implements IDisposable
@inject DbService Db
@inject TaskRunnerService Tasks
@inject UserStateService UserState
@inject ModalPopupService Modals
@inject NavigationManager Nav
@inject IJSRuntime JS

<PageTitle>@pageTitle_</PageTitle>

<section class="sp-app-page groups-page manage-group-page">
    <div class="sp-app-page__header manage-group-page__header">
        <div class="manage-group-page__header-copy">
            <p class="sp-app-page__eyebrow">Group Tools</p>
            <h1>@(group_?.Name ?? "Manage Group")</h1>
            <p>@(group_ is null ? "Loading group..." : $"Your role: {group_.Role}")</p>

            <p class="sp-app-alert sp-app-alert--error @(!string.IsNullOrWhiteSpace(Tasks.Error) ? "sp-app-alert--visible" : "sp-app-alert--hidden")">@Tasks.Error</p>
            <p class="sp-app-alert sp-app-alert--success @(!string.IsNullOrWhiteSpace(Tasks.Message) ? "sp-app-alert--visible" : "sp-app-alert--hidden")">@Tasks.Message</p>
        </div>

        @if (group_ is not null)
        {
            <div class="manage-group-page__header-tools">
                @if (CanManageFiles && inviteLink_ is not null)
                {
                    <div class="manage-group-page__invite">
                        <div class="manage-group-page__invite-details">
                            <code>@inviteLink_</code>
                            <small>Expires @inviteExpiresAt_?.ToLocalTime().ToString("g")</small>
                        </div>
                        <button class="sp-app-button" type="button" @onclick="CopyInviteAsync">Copy</button>
                    </div>
                }

                <div class="manage-group-page__header-actions">
                    <a class="sp-app-button" href="/groups">Back</a>

                    @if (CanManageFiles)
                    {
                        <button class="sp-app-button sp-app-button--primary"
                                type="button"
                                disabled="@Tasks.Busy"
                                @onclick="CreateInviteAsync">
                            Create Invite
                        </button>
                    }

                    <button class="sp-app-button sp-app-button--danger"
                            type="button"
                            disabled="@Tasks.Busy"
                            @onclick="OpenLeaveGroupModalAsync">
                        Leave
                    </button>

                    @if (IsLeader)
                    {
                        <button class="sp-app-button sp-app-button--danger"
                                type="button"
                                disabled="@Tasks.Busy"
                                @onclick="OpenDeleteGroupModalAsync">
                            Delete
                        </button>
                    }
                </div>
            </div>
        }
    </div>

    @if (group_ is null)
    {
        <div class="sp-app-card"><p>Loading group...</p></div>
    }
    else
    {
        <div class="sp-app-grid sp-app-grid--two manage-group-page__grid">
            <section class="sp-app-card manage-group-page__card">
                <div class="manage-group-page__section-header">
                    <h2>Member Management</h2>
                    <small>@members_.Count member@(members_.Count == 1 ? "" : "s")</small>
                </div>

                <div class="sp-app-list manage-group-page__members">
                    @foreach (var member in members_)
                    {
                        <article class="sp-app-list-item manage-group-page__member">
                            <div class="manage-group-page__copy">
                                <strong>@DisplayName(member)</strong>
                                <small>@member.Role · joined @member.JoinedAt.ToLocalTime().ToString("d")</small>
                            </div>

                            <div class="sp-app-list-item__actions">
                                @if (IsLeader && member.UserId != UserState.Id)
                                {
                                    <select class="sp-app-button sp-app-select"
                                            @bind="roles_[member.UserId]"
                                            @bind:after="() => OnRoleEditChange(member, roles_[member.UserId].ToString())">
                                        @foreach (var role in Enum.GetValues<GroupRole>())
                                        {
                                            <option value="@role">@role</option>
                                        }
                                    </select>
                                }

                                @if (CanRemove(member))
                                {
                                    <button class="sp-app-button sp-app-button--danger" type="button" disabled="@Tasks.Busy" @onclick="() => OpenRemoveMemberModalAsync(member)">Remove</button>
                                }
                            </div>
                        </article>
                    }
                </div>
            </section>

            <section class="sp-app-card manage-group-page__card">
                <div class="manage-group-page__section-header">
                    <div>
                        <h2>MIDI Files</h2>
                        <small>@files_.Count file@(files_.Count == 1 ? "" : "s")</small>
                    </div>
                    <a class="sp-app-button" href="/arrangements">Manage MIDI Files</a>
                </div>

                @if (files_.Count == 0)
                {
                    <p>No MIDI files have been shared with this group.</p>
                }
                else
                {
                    <div class="sp-app-list manage-group-page__files">
                        @foreach (var file in files_)
                        {
                            <article class="sp-app-list-item manage-group-page__file">
                                <div class="manage-group-page__copy">
                                    <strong>@file.Title</strong>
                                    <small>@file.OriginalFileName · @file.SizeBytes.ToFileSize()</small>
                                </div>
                                <div class="sp-app-list-item__actions">
                                    @if (IsLeader || file.OwnerId == UserState.Id)
                                    {
                                        <button class="sp-app-button sp-app-button--danger" type="button" disabled="@Tasks.Busy" @onclick="() => UnshareFileAsync(file.Id)">Unshare</button>
                                    }
                                    <button class="sp-app-button" type="button" @onclick="() => filePreview_!.TogglePreviewAsync(file.Id)">@(CanManageFiles ? "Edit" : "View")</button>
                                    <button class="sp-app-button"
                                            type="button"
                                            disabled="@Tasks.Busy"
                                            @onclick="() => OpenInPans(file.Id)">
                                        Ensemble
                                    </button>
                                </div>
                            </article>
                        }
                    </div>
                }
            </section>
        </div>

        <MidiFilePreview @ref="filePreview_"
                         AllowEdit="CanManageFiles"
                         OnSave="StateHasChanged" />
    }
</section>

@code {
    [Parameter] public Guid GroupId { get; set; }

    private GroupSummaryDto? group_;
    private List<GroupMemberSummaryDto> members_ = [];
    private IReadOnlyList<GroupFileDto> files_ = [];
    private Dictionary<Guid, GroupRole> roles_ = [];

    private string? inviteLink_;
    private DateTimeOffset? inviteExpiresAt_;

    private MidiFilePreview? filePreview_;

    private string pageTitle_ => group_?.Name ?? "Manage";

    private bool IsLeader => group_?.Role == GroupRole.Leader;
    private bool IsAdmin => group_?.Role == GroupRole.Admin;
    private bool CanManageFiles => IsLeader || IsAdmin;

    protected override async Task OnInitializedAsync()
    {
        await LoadAsync(refresh: false);
        UserState.OnRefresh += OnUserStateRefreshAsync;
    }

    public void Dispose()
    {
        UserState.OnRefresh -= OnUserStateRefreshAsync;
    }

    private async Task OnUserStateRefreshAsync(StateUpdate updateFlag)
    {
        if (!updateFlag.HasAny(StateUpdate.Id | StateUpdate.Groups))
            return;

        // If the user's groups have changed we may need to update the current group info or navigate away if they lost access
        await LoadAsync(refresh: true);
    }

    private async Task LoadAsync(bool refresh)
    {
        var success = await Tasks.RunUnsafe(async () =>
        {
            group_ = await Db.Groups.GetGroupAsync(GroupId);
            if (group_ is null)
                throw new ApplicationException("Failed to load group, are you a member?");

            members_ = await Db.Groups.GetGroupMembersAsync(GroupId);
            files_ = await Db.Groups.GetGroupFilesAsync(GroupId);
            roles_ = members_.ToDictionary(x => x.UserId, x => x.Role);
        });

        if (!success)
        {
            // If we failed to load the group, navigate back to the groups page (maybe they were removed from the group?)
            Nav.NavigateTo("/groups");
            return;
        }

        if (refresh)
            await InvokeAsync(StateHasChanged);
    }

    private async Task CreateInviteAsync()
    {
        await Tasks.RunSafe(async () =>
        {
            var invite = await Db.Groups.CreateInviteAsync(GroupId);
            inviteLink_ = Nav.ToAbsoluteUri($"/groups/join/{Uri.EscapeDataString(invite.Token)}").ToString();
            inviteExpiresAt_ = invite.ExpiresAt;
            return "Invite link created.";
        });
    }

    private async Task CopyInviteAsync()
    {
        if (inviteLink_ is null)
            return;

        await Tasks.RunUnsafe(async () =>
        {
            await JS.InvokeVoidAsync("navigator.clipboard.writeText", inviteLink_);
            return "Invite link copied to clipboard";
        });
    }

    private async Task UnshareFileAsync(Guid fileId)
    {
        await Tasks.RunSafe(async () =>
        {
            await Db.MidiFiles.UnshareMidiFileWithGroupAsync(fileId, GroupId);
            await LoadAsync(refresh: false);

            await filePreview_!.ClosePreviewIfAsync(fileId);

            return "MIDI file removed from group.";
        });
    }    private async Task OnRoleEditChange(GroupMemberSummaryDto member, string? role)
    {
        if (!Enum.TryParse<GroupRole>(role, out var newRole))
            return;

        switch (newRole)
        {
            case GroupRole.Member:
                await SetRoleAsync(member, newRole);
                break;

            case GroupRole.Leader:
            case GroupRole.Admin:
                await OpenRoleChangeConfirmationAsync(member, newRole);
                break;
        }
    }

    private async Task SetRoleAsync(GroupMemberSummaryDto member, GroupRole role)
    {
        await Tasks.RunSafe(async () =>
        {
            await Db.Groups.SetMemberRoleAsync(GroupId, new UpdateGroupMemberRoleRequest(member.UserId, role));
            roles_[member.UserId] = role;
            await LoadAsync(refresh: false);
            return "Member role updated.";
        });
    }

    private void OpenInPans(Guid fileId)
    {
        Nav.NavigateTo($"/play/ensemble?file={fileId}");
    }

    private async Task OpenRoleChangeConfirmationAsync(GroupMemberSummaryDto member, GroupRole newRole)
    {
        if (group_ is null)
            return;

        await Modals.OpenAsync("ChangeRole",
            new ChangeGroupRoleModal.Payload(group_, member, newRole),
            new ModalOptions { 
                OnFailure = async () => roles_[member.UserId] = member.Role,
                OnComplete = () => InvokeAsync(StateHasChanged)
            }
        );
    }

    private async Task OpenRemoveMemberModalAsync(GroupMemberSummaryDto member)
    {
        if (group_ is null)
            return;

        await Modals.OpenAsync("RemoveGroupMember", new RemoveGroupMemberModal.Payload(group_, member));
    }

    private async Task OpenLeaveGroupModalAsync()
    {
        if (group_ is null)
            return;

        await Modals.OpenAsync("LeaveGroup", group_);
    }

    private async Task OpenDeleteGroupModalAsync()
    {
        if (group_ is null)
            return;

        await Modals.OpenAsync("DeleteGroup", group_);
    }

    private bool CanRemove(GroupMemberSummaryDto member)
    {
        if (group_ is null)
            return false;

        return member.UserId != UserState.Id &&
               (IsLeader && member.Role != GroupRole.Leader || IsAdmin && member.Role == GroupRole.Member);
    }

    private static string DisplayName(GroupMemberSummaryDto member) =>
        string.IsNullOrWhiteSpace(member.UserName) ? member.Email : member.UserName;
}
