@page "/arrangements/tracks/create"
@page "/arrangements/tracks/edit/{TrackId:guid}"
@attribute [Authorize]
@inject DbService Db
@inject SteelPanLoaderService PanLoader
@inject MidiManagerService MidiService
@inject UserStateService UserState
@inject Microsoft.AspNetCore.Hosting.IWebHostEnvironment Env
@inject IJSRuntime JS
@inject Microsoft.Extensions.Logging.ILogger<EditTrack> Logger
@inject NavigationManager Nav
@inject ModalPopupService Modals
@implements IAsyncDisposable


<PageTitle>@PageTitleText</PageTitle>

<section class="sp-app-page record-track-page">
    <div class="sp-app-page__header record-track-page__header">
        <p class="sp-app-page__eyebrow">Record</p>
        <h1>@PageTitleText</h1>
        <p>Set up the track, then press record to open the recording view.</p>
        <p class="sp-app-alert sp-app-alert--error @(!string.IsNullOrWhiteSpace(error_) ? "sp-app-alert--visible" : "sp-app-alert--hidden")">@error_</p>
    </div>

    <div class="sp-app-card record-track-page__setup">
        <ExpandingOverlay Title="Settings"
            ClosedIconClass="sliders"
                          ExpandDirection="ExpandingOverlay.Direction.Right">
            <div class="record-track-page__settings">

                <div class="record-track-page__settings-control">
                    <label>
                        <span>Pan</span>
                        <select @bind="panType_">
                            @foreach (var pan in AvailablePans)
                            {
                                <option value="@pan.Type">@pan.Type.ToSpacedPascal()</option>
                            }
                        </select>
                    </label>

                    <label>
                        <span>Mode</span>
                        <select @bind="recordingMode_">
                            @foreach (var option in Enum.GetValues<RecordingMode>())
                            {
                                <option value="@option">@option.ToString()</option>
                            }
                        </select>
                    </label>

                    <label>
                        <span>Snapping</span>
                        <select @bind="noteSnapDivision_">
                            @foreach (var option in Enum.GetValues<NoteSnapDivision>())
                            {
                                <option value="@option">@option.ToSpacedPascal()</option>
                            }
                        </select>
                    </label>

                    <label class="record-track-page__settings-toggle">
                        <span>Click Track</span>
                        <ToggleSwitch Value="@clickTrackDuringRecording_"
                                      ValueChanged="value => clickTrackDuringRecording_ = value"
                                      AriaLabel="Enable click track while recording" />
                    </label>
                </div>
                <div class="record-track-page__settings-beat">
                    <label>
                        <span>Bars</span>
                        <NumericInput Min="1"
                                      Max="1800"
                                      CanRepeat="true"
                                      @bind-Value="durationBars_" />
                    </label>

                    <label>
                        <span>Tempo</span>
                        <NumericInput Min="1"
                                      Max="200"
                                      CanRepeat="true"
                                      @bind-Value="tempoBpm_" />
                    </label>

                    <label>
                        <span>Time Signature</span>
                        <span class="record-track-page__signature">
                            <NumericInput Min=" 1"
                                          Max="32"
                                          @bind-Value="beatsPerBar_" />
                            <span>/</span>
                            <NoteDivisionDropdown @bind-Value="beatUnit_"
                                                  NoteDivisions="@([2, 4, 8, 16])" />
                        </span>
                    </label>

                    <label>
                        <span>Note Length</span>
                        <NoteDivisionDropdown @bind-Value="defaultNoteDivision_"
                                              NoteDivisions="@([1, 2, 4, 8, 16])" />
                    </label>
                </div>
            </div>
        </ExpandingOverlay>

        <input @bind="trackName_" placeholder="Track Name..." />

        <MidiPlaybackControl Enabled="@notes_.Any()"
                             OnTogglePlayback="OnPlaybackToggledAsync" />

        <div class="record-track-page__controls">
            <button type="button" class="sp-app-button sp-app-button--secondary" @onclick="ExitPage" disabled="@(DisableButtons(requireNotes: false))">Back</button>
            <button type="button" class="sp-app-button sp-app-button--secondary" @onclick="ClearNotesAsync" disabled="@(DisableButtons(requireNotes: true))">Reset</button>
            <button type="button" class="sp-app-button" @onclick="StartRecordingWithCountInAsync" disabled="@(DisableButtons(requireNotes: false))">Record</button>
            <button type="button" class="sp-app-button sp-app-button--primary" @onclick="SaveTrack" disabled="@(DisableButtons(requireNotes: true))">Save</button>
        </div>
    </div>

    <MidiTrackVisualiser Mode="MidiTrackVisualiserMode.Edit"
                         PanLabel="@panType_.ToSpacedPascal()"
                         TrackLabel="@trackName_"
                         Notes="notes_"
                         SelectedNoteId="selectedNoteId_"
                         DurationSeconds="durationSeconds_"
                         ShowPlayhead="true"
                         PositionSeconds="recordingPositionSeconds_"
                         NoteSnapDivision="noteSnapDivision_"
                         MinSemitone="SelectedPanMinSemitone"
                         MaxSemitone="SelectedPanMaxSemitone"
                         TempoBpm="tempoBpm_"
                         BeatsPerBar="beatsPerBar_"
                         BeatUnit="beatUnit_"
                         SelectNote="SelectNoteAsync"
                         PreviewNote="PreviewNoteAsync"
                         PositionChanged="SetPlayheadPosition"
                         MoveSelected="MoveSelected"
                         ResizeSelected="ResizeSelected"
                         ChangeSelectedPitch="ChangeSelectedPitch"
                         SetSelectedPitch="SetSelectedPitch"
                         MoveAndPitchNote="MoveAndPitchNote"
                         DeleteSelected="DeleteNote" />
</section>


@{
    var displayOverlay = isRecordOverlayOpen_ && SelectedPan is not null;
    <div class="@($"record-track-page__overlay{(displayOverlay ? " record-track-page__overlay--show" : " record-track-page__overlay--hide")}")"
         role="dialog"
         aria-modal="true"
         aria-label="Record Track">

        <div class="record-track-page__overlay-shell">
            <div class="record-track-page__overlay-visualiser">
                <MidiTrackVisualiser @ref="recordVisualiser_"
                                     Mode="MidiTrackVisualiserMode.Record"
                                     PanLabel="@panType_.ToSpacedPascal()"
                                     TrackLabel="@trackName_"
                                     Notes="CurrentOverlayNotes"
                                     SelectedNoteId="selectedNoteId_"
                                     DurationSeconds="durationSeconds_"
                                     ShowPlayhead="true"
                                     PositionSeconds="recordingPositionSeconds_"
                                     NoteSnapDivision="noteSnapDivision_"
                                     MinSemitone="SelectedPanMinSemitone"
                                     MaxSemitone="SelectedPanMaxSemitone"
                                     TempoBpm="tempoBpm_"
                                     BeatsPerBar="beatsPerBar_"
                                     BeatUnit="beatUnit_"
                                     SelectNote="SelectNoteAsync"
                                     PreviewNote="PreviewNoteAsync"
                                     PositionChanged="SetPlayheadPosition"
                                     MoveSelected="MoveSelected"
                                     ResizeSelected="ResizeSelected"
                                     ChangeSelectedPitch="ChangeSelectedPitch"
                                     SetSelectedPitch="SetSelectedPitch"
                                     MoveAndPitchNote="MoveAndPitchNote"
                                     DeleteSelected="DeleteNote" />

            </div>

            <div class="sp-app-card record-track-page__overlay-pan-card">
                <SteelPanView @ref="overlayPan_"
                              Pan="SelectedPan"
                              Class="record-track-page__overlay-pan"
                              OnNotePlayed="OnPanNotePlayedAsync"
                              Disabled="@isCountingIn_" />

                <div class="record-track-page__overlay-actions">
                    <button type="button" class="sp-app-button sp-app-button--danger" @onclick="CancelRecordingOverlay">Cancel</button>
                    <button type="button" class="sp-app-button sp-app-button--primary" @onclick="SaveRecordingOverlay" disabled="@isCountingIn_">Save</button>
                </div>

                <div class="@($"record-track-page__count-in{(isCountingIn_ ? " record-track-page__count-in--show" : " record-track-page__count-in--hide")}")"
                     style="--count-in-progress:@countInProgress_.ToString(System.Globalization.CultureInfo.InvariantCulture)">
                    <div class="record-track-page__count-in-ring">
                        <span>@countInNumber_</span>
                    </div>
                </div>
            </div>
        </div>
    </div>
}

@code {
    [Parameter]
    public Guid? TrackId { get; set; }

    [SupplyParameterFromQuery(Name = "file")]
    public Guid? SourceFileId { get; set; }

    [SupplyParameterFromQuery(Name = "returnTo")]
    public string? ReturnTo { get; set; }

    private Toolbar? toolbar_;

    private string? error_;
    private Guid? editingTrackId_;
    private bool loadedExistingTrack_;

    private string trackName_ = string.Empty;

    private PanType panType_ = PanType.None;

    private int tempoBpm_ = 120;
    private double beatsPerSecond_ => 60.0 / tempoBpm_;

    private int beatsPerBar_ = 4;
    private int beatUnit_ = 4;
    private double beatRatio_ => 4.0 / beatUnit_;

    private int durationBars_ = 20;
    private double durationSeconds_ => durationBars_ * (beatsPerBar_ * beatsPerSecond_ * beatRatio_);

    private int defaultNoteDivision_ = 4;
    private NoteSnapDivision noteSnapDivision_;
    private bool clickTrackDuringRecording_ = true;

    private enum RecordingMode
    {
        Overdub,
        Overwrite,
    }

    private RecordingMode recordingMode_ = RecordingMode.Overdub;
    private bool isRecordOverlayOpen_;
    private bool isCountingIn_;
    private bool isRecording_;
    private bool isPlayingBack_;
    private DateTimeOffset recordStartedAt_;
    private double? recordStartedAtAudioTimeSeconds_;
    private double recordingStartSeconds_;
    private double recordingPositionSeconds_;
    private int countInNumber_;
    private double countInProgress_;
    private CancellationTokenSource? recordingPositionCts_;
    private CancellationTokenSource? countInCts_;
    private CancellationTokenSource? metronomeCts_;
    private CancellationTokenSource? overdubPlaybackCts_;
    private Guid? selectedNoteId_;
    private int? editablePlaybackHash_;
    private SteelPanView? overlayPan_;
    private MidiTrackVisualiser? recordVisualiser_;
    private readonly List<MidiPanEvent> notes_ = [];
    private List<MidiPanEvent>? recordingNotes_;
    private IReadOnlyList<MidiPanEvent> CurrentOverlayNotes => recordingNotes_ ?? notes_;
    private bool hasUnsavedTrackChanges_;
    private bool DiagnosticsEnabled => string.Equals(Env.EnvironmentName, "Development", StringComparison.OrdinalIgnoreCase);

    private IReadOnlyList<SteelPan> AvailablePans => PanLoader.Pans.Where(x => x.Type != PanType.None).ToList();
    private SteelPan? SelectedPan => AvailablePans.FirstOrDefault(x => x.Type == panType_) ?? AvailablePans.FirstOrDefault();
    private int? SelectedPanMinSemitone => SelectedPan?.Notes.Select(x => x.Note.SemitoneNumber).DefaultIfEmpty().Min();
    private int? SelectedPanMaxSemitone => SelectedPan?.Notes.Select(x => x.Note.SemitoneNumber).DefaultIfEmpty().Max();
    private string StatusText => isCountingIn_ ? "Count in" : isRecording_ ? "Recording" : isPlayingBack_ ? "Playing" : "Ready";
    private string PageTitleText => editingTrackId_ is null ? "Create Track" : "Edit Track";

    private bool DisableButtons(bool requireNotes) => isRecording_ || isCountingIn_ || isPlayingBack_ || (requireNotes && !notes_.Any());

    protected override void OnInitialized()
    {
        MidiService.Playback.PlaybackStarted += OnEditPlaybackStartedAsync;
        MidiService.Playback.PlaybackPaused += OnEditPlaybackPausedAsync;
        MidiService.Playback.PlaybackStopped += OnEditPlaybackStoppedAsync;
        MidiService.Playback.PositionChanged += OnEditPlaybackPositionChangedAsync;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender)
            return;

        try
        {
            await JS.InvokeVoidAsync("panPlayback.setDiagnosticsEnabled", DiagnosticsEnabled);
        }
        catch (JSException)
        {
        }
    }

    protected override async Task OnParametersSetAsync()
    {
        if (TrackId is Guid trackId && (!loadedExistingTrack_ || editingTrackId_ != trackId))
        {
            await LoadTrackAsync(trackId);
            return;
        }

        if (AvailablePans.Count > 0 && panType_ == PanType.None)
            panType_ = AvailablePans[0].Type;

        if (TrackId is null)
            MidiService.Edit.BeginCreateFile();
    }

    private async Task LoadTrackAsync(Guid trackId)
    {
        var track = MidiService.Edit.GetTrack(trackId);

        if (track is null && SourceFileId is Guid fileId)
            track = await LoadFileTrackAsync(fileId, trackId);

        if (track is null)
        {
            error_ = "That track could not be found.";
            if (AvailablePans.Count > 0 && panType_ == PanType.None)
                panType_ = AvailablePans[0].Type;
            return;
        }

        loadedExistingTrack_ = true;
        editingTrackId_ = trackId;

        LoadTrack(track);
    }

    private async Task<MidiTrackInfo?> LoadFileTrackAsync(Guid fileId, Guid trackId)
    {
        var details = await Db.MidiFiles.GetMidiFileDetailsAsync(fileId);
        var trackDetails = details?.Tracks.FirstOrDefault(x => x.Id == trackId);
        if (details is null || trackDetails is null || details.OwnerId != UserState.Id)
            return null;

        var download = await Db.MidiFiles.OpenMidiFileAsync(fileId);
        if (download is null)
            return null;

        await using var stream = download.Stream;
        using var midiFileStream = await MidiService.Files.OpenMidiFileAsync(stream);
        var midiFile = MidiFile.Read(midiFileStream);
        var playbackInfo = MidiService.Files.GetPlaybackInfo(midiFile);
        var assignment = details.Assignments.FirstOrDefault(x => x.TrackId == trackDetails.Id);
        var playableTracks = MidiService.Files.LoadPlayableTracks(
            midiFile,
            details.Tracks
                .OrderBy(x => x.TrackIndex)
                .Select(x => new MidiTrackSummary
                {
                    Id = x.Id,
                    Index = x.TrackIndex - 1,
                    Name = details.Assignments.FirstOrDefault(a => a.TrackId == x.Id)?.Label
                        ?? x.TrackName
                        ?? $"Track {x.TrackIndex}",
                    PanType = details.Assignments.FirstOrDefault(a => a.TrackId == x.Id)?.PanType
                        ?? x.SuggestedPanType
                        ?? PanType.None
                })
                .ToList());

        UserState.SetActiveMidiFile(fileId, details.OriginalFileName, playableTracks, playbackInfo);

        var track = playableTracks.FirstOrDefault(x => x.Id == trackDetails.Id);
        if (track is null)
            return null;

        return new MidiTrackInfo
        {
            Id = trackDetails.Id,
            Index = track.Index,
            Name = assignment?.Label ?? trackDetails.TrackName ?? track.Name ?? $"Track {trackDetails.TrackIndex}",
            PanType = assignment?.PanType ?? trackDetails.SuggestedPanType ?? track.PanType,
            TempoBpm = playbackInfo.InitialBpm,
            BeatsPerBar = playbackInfo.InitialBeatsPerBar,
            BeatUnit = playbackInfo.InitialBeatUnit,
            DurationSeconds = Math.Max(track.DurationSeconds, track.Events.Count == 0 ? 0 : track.Events.Max(x => x.End).TotalSeconds),
            NoteCount = track.Events.Count,
            Events = track.Events.Select(CloneEvent).ToList()
        };
    }

    private void LoadTrack(MidiTrackInfo track)
    {
        trackName_ = track.Name ?? $"Track {track.Index + 1}";
        panType_ = track.PanType;
        tempoBpm_ = track.TempoBpm;
        beatsPerBar_ = track.BeatsPerBar;
        beatUnit_ = track.BeatUnit;
        durationBars_ = Math.Max(1, (int)Math.Ceiling(track.DurationSeconds / Math.Max(0.001, beatsPerBar_ * beatsPerSecond_ * beatRatio_)));
        notes_.Clear();
        notes_.AddRange(track.Events.Select(CloneEvent));
        selectedNoteId_ = null;
        recordingPositionSeconds_ = 0;
        editablePlaybackHash_ = null;
        hasUnsavedTrackChanges_ = false;
    }

    private static MidiPanEvent CloneEvent(MidiPanEvent source)
    {
        return new MidiPanEvent
        {
            Id = source.Id == Guid.Empty ? Guid.NewGuid() : source.Id,
            Note = source.Note,
            Start = source.Start,
            Duration = source.Duration
        };
    }

    private void LogRecordingDiagnostic(string message, params object?[] args)
    {
        if (!DiagnosticsEnabled)
            return;

        Logger.LogInformation("[RecordDiagnostics] " + message, args);
    }

    private void LogRecordingSlowDiagnostic(long elapsedMilliseconds, string message, params object?[] args)
    {
        if (!DiagnosticsEnabled || elapsedMilliseconds < 16)
            return;

        Logger.LogWarning("[RecordDiagnostics] {ElapsedMilliseconds} ms - " + message, new[] { (object?)elapsedMilliseconds }.Concat(args).ToArray());
    }

    private async Task StartRecordingWithCountInAsync()
    {
        error_ = null;
        if (isRecording_ || isCountingIn_ || isPlayingBack_)
            return;

        await StopPlaybackAsync();

        if (recordingMode_ == RecordingMode.Overwrite)
        {
            var opts = new ModalOptions
            {
                OnSuccess = StartRecordingAsync
            };
            await Modals.OpenAsync("OverwriteWarning", opts);
            return;
        }

        await StartRecordingAsync();
    }

    private async Task StartRecordingAsync()
    {
        recordingNotes_ = notes_.Select(CloneEvent).ToList();

        if (recordingMode_ == RecordingMode.Overwrite)
        {
            recordingNotes_.Clear();
            selectedNoteId_ = null;
            recordingPositionSeconds_ = 0;
        }

        await toolbar_!.RequestCloseAsync();

        recordingPositionSeconds_ = Math.Clamp(recordingPositionSeconds_, 0, Math.Max(0, durationSeconds_));
        isRecordOverlayOpen_ = true;
        isCountingIn_ = true;
        countInNumber_ = Math.Max(1, beatsPerBar_);
        countInProgress_ = 0;
        StateHasChanged();

        countInCts_?.Cancel();
        countInCts_?.Dispose();
        countInCts_ = new CancellationTokenSource();

        try
        {
            await RunCountInAsync(countInCts_.Token);
        }
        catch (OperationCanceledException)
        {
            isCountingIn_ = false;
            isRecordOverlayOpen_ = false;
            countInProgress_ = 0;
            return;
        }

        isCountingIn_ = false;
        await BeginRecordingAtCurrentPositionAsync();
    }

    private async Task RunCountInAsync(CancellationToken cancellationToken)
    {
        var beats = Math.Max(1, beatsPerBar_);
        var secondsPerBeat = GetSecondsPerBeat(beatUnit_);
        var tickInterval = TimeSpan.FromMilliseconds(33);

        for (var beat = beats; beat >= 1; beat--)
        {
            countInNumber_ = beat;
            var beatStartedAt = DateTimeOffset.UtcNow;
            await PlayMetronomeTickAsync(beat == beats, cancellationToken);
            await InvokeAsync(StateHasChanged);

            while ((DateTimeOffset.UtcNow - beatStartedAt).TotalSeconds < secondsPerBeat)
            {
                cancellationToken.ThrowIfCancellationRequested();
                countInProgress_ = Math.Clamp((DateTimeOffset.UtcNow - beatStartedAt).TotalSeconds / secondsPerBeat, 0, 1);
                await InvokeAsync(StateHasChanged);
                await Task.Delay(tickInterval, cancellationToken);
            }

            countInProgress_ = 1;
        }
    }

    private async Task BeginRecordingAtCurrentPositionAsync()
    {
        recordingStartSeconds_ = Math.Clamp(recordingPositionSeconds_, 0, Math.Max(0, durationSeconds_));
        recordStartedAt_ = DateTimeOffset.UtcNow;
        recordStartedAtAudioTimeSeconds_ = await TryGetAudioTimeAsync();
        LogRecordingDiagnostic(
            "Begin recording mode={RecordingMode}, startSeconds={StartSeconds:F3}, audioStart={AudioStart}, existingNotes={ExistingNoteCount}, overlayNotes={OverlayNoteCount}, clickTrack={ClickTrack}",
            recordingMode_,
            recordingStartSeconds_,
            recordStartedAtAudioTimeSeconds_,
            notes_.Count,
            recordingNotes_?.Count ?? 0,
            clickTrackDuringRecording_);
        isRecording_ = true;
        await StartRecordingVisualiserPlayheadAsync();
        StartRecordingPositionLoop();

        if (clickTrackDuringRecording_)
            StartMetronomeClickLoop();

        if (recordingMode_ == RecordingMode.Overdub)
            StartOverdubPlaybackLoop();
    }

    private Task OnPanNotePlayedAsync(SteelPanView.PlayedNote playedNote)
    {
        if (!isRecording_)
            return Task.CompletedTask;

        var stopwatch = System.Diagnostics.Stopwatch.StartNew();
        var targetNotes = recordingNotes_ ?? notes_;
        var countBefore = targetNotes.Count;
        var start = GetCurrentRecordingPositionSeconds(playedNote.AudioTimeSeconds);
        var defaultDuration = GetDefaultNoteDurationSeconds();
        var draft = new MidiPanEvent
        {
            Id = Guid.NewGuid(),
            Note = playedNote.Note,
            Start = TimeSpan.FromSeconds(start),
            Duration = TimeSpan.FromSeconds(Math.Min(defaultDuration, Math.Max(0.05, durationSeconds_ - start)))
        };

        targetNotes.Add(draft);
        selectedNoteId_ = draft.Id;

        if (recordVisualiser_ is not null)
            _ = recordVisualiser_.AddOrUpdateNoteAsync(draft, select: true);

        stopwatch.Stop();

        LogRecordingDiagnostic(
            "Note input note={Note}, audioTime={AudioTime}, recordedStart={RecordedStart:F3}, position={Position:F3}, targetCountBefore={TargetCountBefore}, targetCountAfter={TargetCountAfter}, elapsedMs={ElapsedMs}",
            playedNote.Note,
            playedNote.AudioTimeSeconds,
            start,
            recordingPositionSeconds_,
            countBefore,
            targetNotes.Count,
            stopwatch.ElapsedMilliseconds);
        LogRecordingSlowDiagnostic(
            stopwatch.ElapsedMilliseconds,
            "Slow note input handling for note={Note}, targetCount={TargetCount}",
            playedNote.Note,
            targetNotes.Count);

        return Task.CompletedTask;
    }

    private Task SelectNoteAsync(Guid id)
    {
        selectedNoteId_ = id;
        return Task.CompletedTask;
    }

    private async Task PreviewNoteAsync(Note note)
    {
        var stopwatch = System.Diagnostics.Stopwatch.StartNew();

        if (overlayPan_ is not null)
            await overlayPan_.PlayNoteAsync(note);
        else
            await MidiService.Playback.PlayPreviewNoteAsync(note, panType_);

        stopwatch.Stop();

        LogRecordingSlowDiagnostic(
            stopwatch.ElapsedMilliseconds,
            "Slow preview note playback note={Note}, overlayNoteCount={OverlayNoteCount}, isRecording={IsRecording}",
            note,
            CurrentOverlayNotes.Count,
            isRecording_);
    }

    private async Task SetPlayheadPosition(double seconds)
    {
        if (isRecording_ || isCountingIn_)
            return;

        recordingPositionSeconds_ = Math.Clamp(seconds, 0, Math.Max(0, durationSeconds_));

        if (!isPlayingBack_)
        {
            await EnsureEditablePlaybackTrackSyncedAsync();
            await MidiService.Playback.CommitSeekAsync(TimeSpan.FromSeconds(recordingPositionSeconds_));
        }
    }

    private List<MidiPanEvent> GetEditNotes() => recordingNotes_ ?? notes_;

    private void MarkTrackChanged()
    {
        hasUnsavedTrackChanges_ = true;
    }

    private void MoveSelected(double delta)
    {
        var note = GetEditNotes().FirstOrDefault(x => x.Id == selectedNoteId_);
        if (note is null)
            return;

        note.Start = TimeSpan.FromSeconds(Math.Clamp(note.Start.TotalSeconds + delta, 0, Math.Max(0, durationSeconds_ - note.Duration.TotalSeconds)));
        MarkTrackChanged();
    }
    private void MoveAndPitchNote(MidiTrackVisualiser.RecordNoteMovePitchChange change)
    {
        var note = GetEditNotes().FirstOrDefault(x => x.Id == change.Id);
        if (note is null)
            return;

        selectedNoteId_ = change.Id;
        note.Start = TimeSpan.FromSeconds(Math.Clamp(
            note.Start.TotalSeconds + change.DeltaSeconds,
            0,
            Math.Max(0, durationSeconds_ - note.Duration.TotalSeconds)));

        var min = SelectedPanMinSemitone ?? change.Semitone;
        var max = SelectedPanMaxSemitone ?? change.Semitone;
        note.Note = Note.FromSemitoneNumber(Math.Clamp(change.Semitone, Math.Min(min, max), Math.Max(min, max)));
        MarkTrackChanged();
    }


    private void ResizeSelected(double delta)
    {
        var note = GetEditNotes().FirstOrDefault(x => x.Id == selectedNoteId_);
        if (note is null)
            return;

        note.Duration = TimeSpan.FromSeconds(Math.Clamp(note.Duration.TotalSeconds + delta, 0.05, Math.Max(0.05, durationSeconds_ - note.Start.TotalSeconds)));
        MarkTrackChanged();
    }

    private void ChangeSelectedPitch(int semitoneDelta)
    {
        var note = GetEditNotes().FirstOrDefault(x => x.Id == selectedNoteId_);
        if (note is null || semitoneDelta == 0)
            return;

        SetSelectedPitch(note.Note.SemitoneNumber + semitoneDelta);
    }

    private void SetSelectedPitch(int semitone)
    {
        var note = GetEditNotes().FirstOrDefault(x => x.Id == selectedNoteId_);
        if (note is null)
            return;

        var min = SelectedPanMinSemitone ?? semitone;
        var max = SelectedPanMaxSemitone ?? semitone;
        note.Note = Note.FromSemitoneNumber(Math.Clamp(semitone, Math.Min(min, max), Math.Max(min, max)));
        MarkTrackChanged();
    }

    private void DeleteNote(Guid id)
    {
        if (GetEditNotes().RemoveAll(x => x.Id == id) > 0)
            hasUnsavedTrackChanges_ = true;
        if (selectedNoteId_ == id)
            selectedNoteId_ = null;
    }

    private async Task ClearNotesAsync()
    {
        var options = new ModalOptions
        {
            OnComplete = () =>
            {
                notes_.Clear();
                selectedNoteId_ = null;
                recordingPositionSeconds_ = 0;
                MarkTrackChanged();
                return InvokeAsync(StateHasChanged);
            }
        };

        await Modals.OpenAsync("ClearNotes", options);
    }


    private double GetCurrentRecordingPositionSeconds(double? audioTimeSeconds = null)
    {
        if (audioTimeSeconds is double audioTime && recordStartedAtAudioTimeSeconds_ is double startedAudioTime)
        {
            return Math.Clamp(
                recordingStartSeconds_ + audioTime - startedAudioTime,
                0,
                Math.Max(1, durationSeconds_));
        }

        return Math.Clamp(
            recordingStartSeconds_ + (DateTimeOffset.UtcNow - recordStartedAt_).TotalSeconds,
            0,
            Math.Max(1, durationSeconds_));
    }

    private async Task<double?> TryGetAudioTimeAsync()
    {
        try
        {
            return await MidiService.Playback.GetAudioTimeAsync();
        }
        catch (JSException)
        {
            return null;
        }
    }

    private async Task StartRecordingVisualiserPlayheadAsync()
    {
        if (recordVisualiser_ is null)
            return;

        await recordVisualiser_.StartPlayheadAsync(recordingStartSeconds_, recordStartedAtAudioTimeSeconds_);
    }

    private async Task StopRecordingVisualiserPlayheadAsync(double positionSeconds, bool resetViewport)
    {
        if (recordVisualiser_ is null)
            return;

        try
        {
            await recordVisualiser_.StopPlayheadAsync(positionSeconds, resetViewport);
        }
        catch (JSDisconnectedException)
        {
        }
    }

    private void StartRecordingPositionLoop()
    {
        recordingPositionCts_?.Cancel();
        recordingPositionCts_?.Dispose();
        recordingPositionCts_ = new CancellationTokenSource();
        _ = UpdateRecordingPositionAsync(recordingPositionCts_.Token);
    }

    private async Task UpdateRecordingPositionAsync(CancellationToken cancellationToken)
    {
        using var timer = new PeriodicTimer(TimeSpan.FromMilliseconds(33));

        try
        {
            while (await timer.WaitForNextTickAsync(cancellationToken))
            {
                if (!isRecording_)
                    return;

                recordingPositionSeconds_ = GetCurrentRecordingPositionSeconds();

                if (recordingPositionSeconds_ >= durationSeconds_)
                {
                    StopRecording(keepOverlayOpen: true, resetPosition: false);
                }
            }
        }
        catch (OperationCanceledException)
        {
        }
    }

    private void CancelRecordingOverlay()
    {
        countInCts_?.Cancel();
        StopRecording(keepOverlayOpen: false, resetPosition: true);
        isCountingIn_ = false;
        recordingNotes_ = null;
    }

    private void SaveRecordingOverlay()
    {
        countInCts_?.Cancel();
        StopRecording(keepOverlayOpen: false, resetPosition: true);
        isCountingIn_ = false;

        if (recordingNotes_ is not null)
        {
            notes_.Clear();
            notes_.AddRange(recordingNotes_.Select(CloneEvent));
            recordingNotes_ = null;
            MarkTrackChanged();
        }
    }

    private void StopRecording(bool keepOverlayOpen = false, bool resetPosition = true)
    {
        if (isRecording_)
        {
            recordingPositionSeconds_ = GetCurrentRecordingPositionSeconds();
        }

        isRecording_ = false;
        isRecordOverlayOpen_ = keepOverlayOpen;
        recordingPositionCts_?.Cancel();
        metronomeCts_?.Cancel();
        overdubPlaybackCts_?.Cancel();

        if (resetPosition)
            recordingPositionSeconds_ = 0;

        _ = StopRecordingVisualiserPlayheadAsync(recordingPositionSeconds_, resetPosition);
    }

    private void StartMetronomeClickLoop()
    {
        metronomeCts_?.Cancel();
        metronomeCts_?.Dispose();
        metronomeCts_ = new CancellationTokenSource();
        _ = RunMetronomeClickLoopAsync(metronomeCts_.Token);
    }

    private async Task RunMetronomeClickLoopAsync(CancellationToken cancellationToken)
    {
        var secondsPerBeat = GetSecondsPerBeat(beatUnit_);
        var nextBeatIndex = (int)Math.Ceiling(Math.Max(0, recordingStartSeconds_ - 0.0001) / Math.Max(secondsPerBeat, 0.001));

        try
        {
            while (!cancellationToken.IsCancellationRequested && isRecording_)
            {
                var nextBeatSeconds = nextBeatIndex * secondsPerBeat;
                var delaySeconds = nextBeatSeconds - recordingPositionSeconds_;

                if (delaySeconds > 0)
                    await Task.Delay(TimeSpan.FromSeconds(delaySeconds), cancellationToken);

                if (!isRecording_ || cancellationToken.IsCancellationRequested)
                    return;

                var isAccent = nextBeatIndex % Math.Max(1, beatsPerBar_) == 0;
                await PlayMetronomeTickAsync(isAccent, cancellationToken);
                nextBeatIndex++;
            }
        }
        catch (OperationCanceledException)
        {
        }
    }

    private async Task PlayMetronomeTickAsync(bool isAccent, CancellationToken cancellationToken)
    {
        try
        {
            await MidiService.Playback.PlayMetronomeTickAsync(isAccent, cancellationToken);
        }
        catch (JSException)
        {
        }
    }

    private void StartOverdubPlaybackLoop()
    {
        overdubPlaybackCts_?.Cancel();
        overdubPlaybackCts_?.Dispose();
        overdubPlaybackCts_ = new CancellationTokenSource();

        var stopwatch = System.Diagnostics.Stopwatch.StartNew();
        var start = recordingStartSeconds_;
        var notesToPlay = notes_
            .Where(x => x.Start.TotalSeconds >= start && x.Start.TotalSeconds < durationSeconds_)
            .OrderBy(x => x.Start.TotalSeconds)
            .ThenBy(x => x.Note.SemitoneNumber)
            .Select(CloneEvent)
            .ToList();
        stopwatch.Stop();

        LogRecordingDiagnostic(
            "Prepared overdub playback start={Start:F3}, sourceNotes={SourceNoteCount}, notesToPlay={NotesToPlay}, elapsedMs={ElapsedMs}",
            start,
            notes_.Count,
            notesToPlay.Count,
            stopwatch.ElapsedMilliseconds);
        LogRecordingSlowDiagnostic(
            stopwatch.ElapsedMilliseconds,
            "Slow overdub note preparation sourceNotes={SourceNoteCount}, notesToPlay={NotesToPlay}",
            notes_.Count,
            notesToPlay.Count);

        _ = PlayOverdubNotesAsync(start, notesToPlay, overdubPlaybackCts_.Token);
    }

    private async Task PlayOverdubNotesAsync(double startSeconds, IReadOnlyList<MidiPanEvent> notesToPlay, CancellationToken cancellationToken)
    {
        if (notesToPlay.Count == 0)
            return;

        LogRecordingDiagnostic(
            "Started overdub playback loop start={Start:F3}, notesToPlay={NotesToPlay}",
            startSeconds,
            notesToPlay.Count);

        try
        {
            foreach (var note in notesToPlay)
            {
                var delaySeconds = note.Start.TotalSeconds - GetCurrentRecordingPositionSeconds();

                if (delaySeconds > 0)
                    await Task.Delay(TimeSpan.FromSeconds(delaySeconds), cancellationToken);

                if (!isRecording_ || cancellationToken.IsCancellationRequested)
                    return;

                if (GetCurrentRecordingPositionSeconds() + 0.05 < note.Start.TotalSeconds)
                    continue;

                var previewStopwatch = System.Diagnostics.Stopwatch.StartNew();
                await PreviewNoteAsync(note.Note);
                previewStopwatch.Stop();

                LogRecordingSlowDiagnostic(
                    previewStopwatch.ElapsedMilliseconds,
                    "Slow overdub preview note={Note}, noteStart={NoteStart:F3}, position={Position:F3}, notesToPlay={NotesToPlay}",
                    note.Note,
                    note.Start.TotalSeconds,
                    recordingPositionSeconds_,
                    notesToPlay.Count);
            }
        }
        catch (OperationCanceledException)
        {
        }
    }

    private MidiTrackInfo BuildEditablePlaybackTrack()
    {
        return new MidiTrackInfo
        {
            Id = editingTrackId_ ?? Guid.NewGuid(),
            Index = 0,
            Name = string.IsNullOrWhiteSpace(trackName_) ? "Edited Track" : trackName_.Trim(),
            PanType = panType_,
            TempoBpm = Math.Clamp(tempoBpm_, 1, 300),
            BeatsPerBar = Math.Clamp(beatsPerBar_, 1, 32),
            BeatUnit = Math.Clamp(beatUnit_, 1, 64),
            DurationSeconds = Math.Clamp(durationSeconds_, 0.01, 1800),
            NoteCount = notes_.Count,
            Events = notes_.Select(CloneEvent).ToList()
        };
    }

    private int GetEditablePlaybackHash()
    {
        var hash = new HashCode();
        hash.Add(editingTrackId_);
        hash.Add(trackName_);
        hash.Add(panType_);
        hash.Add(tempoBpm_);
        hash.Add(beatsPerBar_);
        hash.Add(beatUnit_);
        hash.Add(durationSeconds_);
        hash.Add(notes_.Count);

        foreach (var note in notes_)
        {
            hash.Add(note.Id);
            hash.Add(note.Note.SemitoneNumber);
            hash.Add(note.Start.Ticks);
            hash.Add(note.Duration.Ticks);
        }

        return hash.ToHashCode();
    }

    private async Task StopPlaybackAsync()
    {
        if (!isPlayingBack_ && !MidiService.Playback.IsPlaying)
            return;

        await MidiService.Playback.StopAsync(resetPosition: false);
        isPlayingBack_ = false;
        recordingPositionSeconds_ = Math.Clamp(MidiService.Playback.Position.TotalSeconds, 0, Math.Max(0, durationSeconds_));
        await InvokeAsync(StateHasChanged);
    }

    private async Task SyncEditablePlaybackTrackAsync()
    {
        await MidiService.Playback.LoadEditableTrackPlaybackAsync(BuildEditablePlaybackTrack());
        editablePlaybackHash_ = GetEditablePlaybackHash();
        recordingPositionSeconds_ = Math.Clamp(recordingPositionSeconds_, 0, Math.Max(0, durationSeconds_));

        if (recordingPositionSeconds_ > 0)
            await MidiService.Playback.CommitSeekAsync(TimeSpan.FromSeconds(recordingPositionSeconds_));
    }

    private async Task EnsureEditablePlaybackTrackSyncedAsync()
    {
        if (editablePlaybackHash_ != GetEditablePlaybackHash())
            await SyncEditablePlaybackTrackAsync();
    }

    private async Task OnPlaybackToggledAsync()
    {
        await EnsureEditablePlaybackTrackSyncedAsync();

        if (!isPlayingBack_)
            await Task.Delay(500);
    }

    private Task OnEditPlaybackStartedAsync(MidiEventArgs.PlaybackStarted args)
    {
        isPlayingBack_ = true;
        recordingPositionSeconds_ = Math.Clamp(args.StartOffset.TotalSeconds, 0, Math.Max(0, durationSeconds_));
        return InvokeAsync(StateHasChanged);
    }

    private Task OnEditPlaybackPausedAsync(MidiEventArgs.PlaybackPaused args)
    {
        isPlayingBack_ = false;
        recordingPositionSeconds_ = Math.Clamp(args.Position.TotalSeconds, 0, Math.Max(0, durationSeconds_));
        return InvokeAsync(StateHasChanged);
    }

    private Task OnEditPlaybackStoppedAsync(MidiEventArgs.PlaybackStopped args)
    {
        isPlayingBack_ = false;
        recordingPositionSeconds_ = Math.Clamp(args.Position.TotalSeconds, 0, Math.Max(0, durationSeconds_));
        return InvokeAsync(StateHasChanged);
    }

    private Task OnEditPlaybackPositionChangedAsync(MidiEventArgs.PlaybackPositionChanged args)
    {
        if (isRecording_ || isCountingIn_)
            return Task.CompletedTask;

        isPlayingBack_ = args.IsPlaying;
        recordingPositionSeconds_ = Math.Clamp(args.Position.TotalSeconds, 0, Math.Max(0, durationSeconds_));
        return InvokeAsync(StateHasChanged);
    }

    private double GetDefaultNoteDurationSeconds()
    {
        var noteDivision = Math.Max(1, defaultNoteDivision_);
        return Math.Max(0.05, GetSecondsPerBeat(noteDivision));
    }

    private double GetSecondsPerBeat(int noteDivision)
    {
        var safeBpm = Math.Clamp(tempoBpm_, 1, 300);
        var safeDivision = Math.Max(1, noteDivision);
        return (60.0 / safeBpm) * (4.0 / safeDivision);
    }

    public async ValueTask DisposeAsync()
    {
        MidiService.Playback.PlaybackStarted -= OnEditPlaybackStartedAsync;
        MidiService.Playback.PlaybackPaused -= OnEditPlaybackPausedAsync;
        MidiService.Playback.PlaybackStopped -= OnEditPlaybackStoppedAsync;
        MidiService.Playback.PositionChanged -= OnEditPlaybackPositionChangedAsync;

        await MidiService.Playback.StopAsync(resetPosition: true);

        countInCts_?.Cancel();
        countInCts_?.Dispose();
        countInCts_ = null;
        recordingPositionCts_?.Cancel();
        recordingPositionCts_?.Dispose();
        recordingPositionCts_ = null;
        metronomeCts_?.Cancel();
        metronomeCts_?.Dispose();
        metronomeCts_ = null;
        overdubPlaybackCts_?.Cancel();
        overdubPlaybackCts_?.Dispose();
        overdubPlaybackCts_ = null;
        await Task.CompletedTask;
    }

    private async Task SaveTrack()
    {
        await StopPlaybackAsync();
        StopRecording();
        error_ = null;
        if (notes_.Count == 0)
        {
            error_ = "Record at least one note before adding the track.";
            return;
        }

        if (string.IsNullOrWhiteSpace(trackName_))
        {
            error_ = "Please give your track a name.";
            return;
        }

        var track = new MidiTrackInfo
        {
            Id = editingTrackId_ ?? Guid.NewGuid(),
            Index = editingTrackId_ is Guid existingId && MidiService.Edit.GetTrack(existingId) is { } existingTrack ? existingTrack.Index : MidiService.Edit.Tracks.Count,
            Name = trackName_.Trim(),
            PanType = panType_,
            TempoBpm = Math.Clamp(tempoBpm_, 1, 300),
            BeatsPerBar = Math.Clamp(beatsPerBar_, 1, 32),
            BeatUnit = Math.Clamp(beatUnit_, 1, 64),
            DurationSeconds = Math.Clamp(durationSeconds_, 1, 1800),
            NoteCount = notes_.Count,
            Events = notes_.Select(x => new MidiPanEvent
            {
                Id = x.Id == Guid.Empty ? Guid.NewGuid() : x.Id,
                Note = x.Note,
                Start = x.Start,
                Duration = x.Duration
            }).ToList()
        };

        MidiService.Edit.CommitEditableTrack(track);
        hasUnsavedTrackChanges_ = false;

        await ExitPage();
    }

    private async Task ExitPage()
    {
        if (!hasUnsavedTrackChanges_)
        {
            Nav.NavigateTo(GetSaveReturnUrl());
            return;
        }

        await Modals.OpenAsync("UnsavedChanges", new ModalOptions
        {
            OnSuccess = () =>
            {
                Nav.NavigateTo(GetSaveReturnUrl());
                return Task.CompletedTask;
            }
        });
    }

    private string GetSaveReturnUrl()
    {
        return string.Equals(ReturnTo, "manage", StringComparison.OrdinalIgnoreCase) && SourceFileId is Guid fileId
            ? $"/arrangements/{fileId}"
            : "/arrangements/create";
    }
}
