@page "/arrangements/tracks/create"
@page "/arrangements/tracks/edit/{TrackId:guid}"
@attribute [Authorize]
@inject RecordDraftService Draft
@inject SteelPanLoaderService PanLoader
@inject MidiPlaybackService Playback
@inject NavigationManager Nav
@inject ModalPopupService Modals
@implements IAsyncDisposable


<PageTitle>@PageTitleText</PageTitle>

<section class="sp-app-page record-track-page">
    <div class="sp-app-page__header record-track-page__header">
        <p class="sp-app-page__eyebrow">Record</p>
        <h1>@PageTitleText</h1>
        <p>Set up the track, then press record to open the recording view.</p>
        <p class="sp-app-alert sp-app-alert--error @(!string.IsNullOrWhiteSpace(error_) ? "sp-app-alert--visible" : "sp-app-alert--hidden")">@error_</p>
    </div>

    <div class="sp-app-card record-track-page__setup">
        <Toolbar @ref="toolbar_"
                 ClosedIconClass="bi-sliders"
                 MenuButtonLabel="Open Controls"
                 MenuLabel="Controls"
                 Side="Toolbar.ToolbarSide.Left">
            <ToolbarElement Text="Edit"
                            IconClass="bi-gear-fill">
                <ChildContent>
                    <div class="record-track-page__settings">

                        <div class="record-track-page__settings-control">
                            <label>
                                <span>Pan</span>
                                <select @bind="panType_">
                                    @foreach (var pan in AvailablePans)
                                    {
                                        <option value="@pan.Type">@pan.Type.ToSpacedPascal()</option>
                                    }
                                </select>
                            </label>

                            <label>
                                <span>Mode</span>
                                <select @bind="recordingMode_">
                                    @foreach (var option in Enum.GetValues<RecordingMode>())
                                    {
                                        <option value="@option">@option.ToString()</option>
                                    }
                                </select>
                            </label>

                            <label>
                                <span>Snapping</span>
                                <select @bind="noteSnapDivision_">
                                    @foreach (var option in Enum.GetValues<NoteSnapDivision>())
                                    {
                                        <option value="@option">@option.ToSpacedPascal()</option>
                                    }
                                </select>
                            </label>
                        </div>
                        <div class="record-track-page__settings-beat">
                            <label>
                                <span>Bars</span>
                                <NumericInput Min="1"
                                              Max="1800"
                                              CanRepeat="true"
                                              @bind-Value="durationBars_" />
                            </label>

                            <label>
                                <span>Tempo</span>
                                <NumericInput Min="1"
                                              Max="200"
                                              CanRepeat="true"
                                              @bind-Value="tempoBpm_" />
                            </label>

                            <label>
                                <span>Time Signature</span>
                                <span class="record-track-page__signature">
                                    <NumericInput Min=" 1"
                                                  Max="32"
                                                  @bind-Value="beatsPerBar_" />
                                    <span>/</span>
                                    <NoteDivisionDropdown @bind-Value="beatUnit_"
                                                          NoteDivisions="@([2, 4, 8, 16])" />
                                </span>
                            </label>

                            <label>
                                <span>Note Length</span>
                                <NoteDivisionDropdown @bind-Value="defaultNoteDivision_"
                                                      NoteDivisions="@([1, 2, 4, 8, 16])" />
                            </label>
                        </div>
                    </div>
                </ChildContent>
            </ToolbarElement>
        </Toolbar>

        <input @bind="trackName_" placeholder="Track Name..." />

        <div class="record-track-page__controls">
            <button type="button" class="sp-app-button sp-app-button--secondary" @onclick="ClearNotesAsync" disabled="@(DisableButtons(requireNotes: true))">Reset</button>
            <button type="button" class="sp-app-button sp-app-button--secondary" @onclick="TogglePlaybackAsync" disabled="@(DisableButtons(requireNotes: true))">@(isPlayingBack_ ? "Stop" : "Play")</button>
            <button type="button" class="sp-app-button" @onclick="StartRecordingWithCountInAsync" disabled="@(DisableButtons(requireNotes: false))">Record</button>
            <button type="button" class="sp-app-button sp-app-button--primary" @onclick="SaveTrack" disabled="@(DisableButtons(requireNotes: true))">Save</button>
        </div>
    </div>

    <MidiTrackVisualiser Mode="MidiTrackVisualiserMode.Edit"
                         PanLabel="@panType_.ToSpacedPascal()"
                         TrackLabel="@trackName_"
                         RecordNotes="notes_"
                         SelectedNoteId="selectedNoteId_"
                         DurationSeconds="durationSeconds_"
                         ShowPlayhead="true"
                         PositionSeconds="recordingPositionSeconds_"
                         NoteSnapDivision="noteSnapDivision_"
                         MinSemitone="SelectedPanMinSemitone"
                         MaxSemitone="SelectedPanMaxSemitone"
                         TempoBpm="tempoBpm_"
                         BeatsPerBar="beatsPerBar_"
                         BeatUnit="beatUnit_"
                         SelectNote="SelectNoteAsync"
                         PreviewNote="PreviewNoteAsync"
                         PositionChanged="SetPlayheadPosition"
                         MoveSelected="MoveSelected"
                         ResizeSelected="ResizeSelected"
                         ChangeSelectedPitch="ChangeSelectedPitch"
                         SetSelectedPitch="SetSelectedPitch"
                         MoveAndPitchNote="MoveAndPitchNote"
                         DeleteSelected="DeleteNote" />
</section>


@{
    var displayOverlay = isRecordOverlayOpen_ && SelectedPan is not null;
    <div class="@($"record-track-page__overlay{(displayOverlay ? " record-track-page__overlay--show" : " record-track-page__overlay--hide")}")"
         role="dialog"
         aria-modal="true"
         aria-label="Record Track">

        <div class="record-track-page__overlay-shell">
            <div class="record-track-page__overlay-visualiser">
                <MidiTrackVisualiser Mode="MidiTrackVisualiserMode.Record"
                                     PanLabel="@panType_.ToSpacedPascal()"
                                     TrackLabel="@trackName_"
                                     RecordNotes="notes_"
                                     SelectedNoteId="selectedNoteId_"
                                     DurationSeconds="durationSeconds_"
                                     ShowPlayhead="true"
                                     PositionSeconds="recordingPositionSeconds_"
                                     NoteSnapDivision="noteSnapDivision_"
                                     MinSemitone="SelectedPanMinSemitone"
                                     MaxSemitone="SelectedPanMaxSemitone"
                                     TempoBpm="tempoBpm_"
                                     BeatsPerBar="beatsPerBar_"
                                     BeatUnit="beatUnit_"
                                     SelectNote="SelectNoteAsync"
                                     PreviewNote="PreviewNoteAsync"
                                     PositionChanged="SetPlayheadPosition"
                                     MoveSelected="MoveSelected"
                                     ResizeSelected="ResizeSelected"
                                     ChangeSelectedPitch="ChangeSelectedPitch"
                                     SetSelectedPitch="SetSelectedPitch"
                                     MoveAndPitchNote="MoveAndPitchNote"
                                     DeleteSelected="DeleteNote" />

            </div>

            <div class="sp-app-card record-track-page__overlay-pan-card">
                <SteelPanView @ref="overlayPan_"
                              Pan="SelectedPan"
                              Class="record-track-page__overlay-pan"
                              OnNotePlayed="OnPanNotePlayedAsync"
                              Disabled="@isCountingIn_" />

                <button type="button" class="sp-app-button sp-app-button--danger" @onclick="StopRecordingOverlay">@(isCountingIn_ ? "Cancel" : "Stop")</button>

                <div class="@($"record-track-page__count-in{(isCountingIn_ ? " record-track-page__count-in--show" : " record-track-page__count-in--hide")}")"
                     style="--count-in-progress:@countInProgress_.ToString(System.Globalization.CultureInfo.InvariantCulture)">
                    <div class="record-track-page__count-in-ring">
                        <span>@countInNumber_</span>
                    </div>
                </div>
            </div>
        </div>
    </div>
}

@code {
    [Parameter]
    public Guid? TrackId { get; set; }

    private Toolbar? toolbar_;

    private string? error_;
    private Guid? editingTrackId_;
    private bool loadedExistingTrack_;

    private string trackName_ = string.Empty;

    private PanType panType_ = PanType.None;

    private int tempoBpm_ = 120;
    private double beatsPerSecond_ => 60.0 / tempoBpm_;

    private int beatsPerBar_ = 4;
    private int beatUnit_ = 4;
    private double beatRatio_ => 4.0 / beatUnit_;

    private int durationBars_ = 20;
    private double durationSeconds_ => durationBars_ * (beatsPerBar_ * beatsPerSecond_ * beatRatio_);

    private int defaultNoteDivision_ = 4;
    private NoteSnapDivision noteSnapDivision_;

    private enum RecordingMode
    {
        Overwrite,
        Overdub,
    }

    private RecordingMode recordingMode_ = RecordingMode.Overwrite;
    private bool isRecordOverlayOpen_;
    private bool isCountingIn_;
    private bool isRecording_;
    private bool isPlayingBack_;
    private DateTimeOffset recordStartedAt_;
    private double? recordStartedAtAudioTimeSeconds_;
    private double recordingStartSeconds_;
    private double recordingPositionSeconds_;
    private int countInNumber_;
    private double countInProgress_;
    private CancellationTokenSource? recordingPositionCts_;
    private CancellationTokenSource? playbackCts_;
    private CancellationTokenSource? countInCts_;
    private CancellationTokenSource? metronomeCts_;
    private Guid? selectedNoteId_;
    private SteelPanView? overlayPan_;
    private readonly List<MidiPanEvent> notes_ = [];

    private IReadOnlyList<SteelPan> AvailablePans => PanLoader.Pans.Where(x => x.Type != PanType.None).ToList();
    private SteelPan? SelectedPan => AvailablePans.FirstOrDefault(x => x.Type == panType_) ?? AvailablePans.FirstOrDefault();
    private int? SelectedPanMinSemitone => SelectedPan?.Notes.Select(x => x.Note.SemitoneNumber).DefaultIfEmpty().Min();
    private int? SelectedPanMaxSemitone => SelectedPan?.Notes.Select(x => x.Note.SemitoneNumber).DefaultIfEmpty().Max();
    private string StatusText => isCountingIn_ ? "Count in" : isRecording_ ? "Recording" : isPlayingBack_ ? "Playing" : "Ready";
    private string PageTitleText => editingTrackId_ is null ? "Create Track" : "Edit Track";

    private bool DisableButtons(bool requireNotes) => isRecording_ || isCountingIn_ || isPlayingBack_ || (requireNotes && !notes_.Any());

    protected override void OnParametersSet()
    {
        if (TrackId is Guid trackId && (!loadedExistingTrack_ || editingTrackId_ != trackId))
        {
            LoadDraftTrack(trackId);
            return;
        }

        if (AvailablePans.Count > 0 && panType_ == PanType.None)
            panType_ = AvailablePans[0].Type;
    }

    private void LoadDraftTrack(Guid trackId)
    {
        loadedExistingTrack_ = true;
        editingTrackId_ = trackId;

        var track = Draft.Tracks.FirstOrDefault(x => x.Id == trackId);
        if (track is null)
        {
            error_ = "That draft track could not be found.";
            if (AvailablePans.Count > 0 && panType_ == PanType.None)
                panType_ = AvailablePans[0].Type;
            return;
        }

        trackName_ = track.Name;
        panType_ = track.PanType;
        tempoBpm_ = track.TempoBpm;
        beatsPerBar_ = track.BeatsPerBar;
        beatUnit_ = track.BeatUnit;
        durationBars_ = Math.Max(1, (int)Math.Ceiling(track.DurationSeconds / Math.Max(0.001, beatsPerBar_ * beatsPerSecond_ * beatRatio_)));
        notes_.Clear();
        notes_.AddRange(track.Events.Select(x => new MidiPanEvent
        {
            Id = x.Id == Guid.Empty ? Guid.NewGuid() : x.Id,
            Note = x.Note,
            Start = x.Start,
            Duration = x.Duration
        }));
        selectedNoteId_ = null;
        recordingPositionSeconds_ = 0;
    }

    private async Task StartRecordingWithCountInAsync()
    {
        error_ = null;
        if (isRecording_ || isCountingIn_ || isPlayingBack_)
            return;

        await StopPlaybackAsync();

        if (recordingMode_ == RecordingMode.Overwrite)
        {
            notes_.Clear();
            selectedNoteId_ = null;
            recordingPositionSeconds_ = 0;
        }

        await toolbar_!.RequestCloseAsync();

        recordingPositionSeconds_ = Math.Clamp(recordingPositionSeconds_, 0, Math.Max(0, durationSeconds_));
        isRecordOverlayOpen_ = true;
        isCountingIn_ = true;
        countInNumber_ = Math.Max(1, beatsPerBar_);
        countInProgress_ = 0;
        StateHasChanged();

        countInCts_?.Cancel();
        countInCts_?.Dispose();
        countInCts_ = new CancellationTokenSource();

        try
        {
            await RunCountInAsync(countInCts_.Token);
        }
        catch (OperationCanceledException)
        {
            isCountingIn_ = false;
            isRecordOverlayOpen_ = false;
            countInProgress_ = 0;
            return;
        }

        isCountingIn_ = false;
        await BeginRecordingAtCurrentPositionAsync();
    }

    private async Task RunCountInAsync(CancellationToken cancellationToken)
    {
        var beats = Math.Max(1, beatsPerBar_);
        var secondsPerBeat = GetSecondsPerBeat(beatUnit_);
        var tickInterval = TimeSpan.FromMilliseconds(33);

        for (var beat = beats; beat >= 1; beat--)
        {
            countInNumber_ = beat;
            var beatStartedAt = DateTimeOffset.UtcNow;
            await PlayMetronomeTickAsync(beat == beats, cancellationToken);
            await InvokeAsync(StateHasChanged);

            while ((DateTimeOffset.UtcNow - beatStartedAt).TotalSeconds < secondsPerBeat)
            {
                cancellationToken.ThrowIfCancellationRequested();
                countInProgress_ = Math.Clamp((DateTimeOffset.UtcNow - beatStartedAt).TotalSeconds / secondsPerBeat, 0, 1);
                await InvokeAsync(StateHasChanged);
                await Task.Delay(tickInterval, cancellationToken);
            }

            countInProgress_ = 1;
        }
    }

    private async Task BeginRecordingAtCurrentPositionAsync()
    {
        recordingStartSeconds_ = Math.Clamp(recordingPositionSeconds_, 0, Math.Max(0, durationSeconds_));
        recordStartedAt_ = DateTimeOffset.UtcNow;
        recordStartedAtAudioTimeSeconds_ = await TryGetAudioTimeAsync();
        isRecording_ = true;
        StartRecordingPositionLoop();
        StartMetronomeClickLoop();
    }

    private Task OnPanNotePlayedAsync(SteelPanView.PlayedNote playedNote)
    {
        if (!isRecording_)
            return Task.CompletedTask;

        var start = GetCurrentRecordingPositionSeconds(playedNote.AudioTimeSeconds);
        var defaultDuration = GetDefaultNoteDurationSeconds();
        var draft = new MidiPanEvent
        {
            Note = playedNote.Note,
            Start = TimeSpan.FromSeconds(start),
            Duration = TimeSpan.FromSeconds(Math.Min(defaultDuration, Math.Max(0.05, durationSeconds_ - start)))
        };

        notes_.Add(draft);
        selectedNoteId_ = draft.Id;
        StateHasChanged();
        return Task.CompletedTask;
    }

    private Task SelectNoteAsync(Guid id)
    {
        selectedNoteId_ = id;
        return Task.CompletedTask;
    }

    private async Task PreviewNoteAsync(Note note)
    {
        if (overlayPan_ is null)
            return;

        await overlayPan_.PlayNoteAsync(note);
    }

    private void SetPlayheadPosition(double seconds)
    {
        if (isRecording_ || isCountingIn_)
            return;

        recordingPositionSeconds_ = Math.Clamp(seconds, 0, Math.Max(0, durationSeconds_));
    }

    private void MoveSelected(double delta)
    {
        var note = notes_.FirstOrDefault(x => x.Id == selectedNoteId_);
        if (note is null)
            return;

        note.Start = TimeSpan.FromSeconds(Math.Clamp(note.Start.TotalSeconds + delta, 0, Math.Max(0, durationSeconds_ - note.Duration.TotalSeconds)));
    }
    private void MoveAndPitchNote(MidiTrackVisualiser.RecordNoteMovePitchChange change)
    {
        var note = notes_.FirstOrDefault(x => x.Id == change.Id);
        if (note is null)
            return;

        selectedNoteId_ = change.Id;
        note.Start = TimeSpan.FromSeconds(Math.Clamp(
            note.Start.TotalSeconds + change.DeltaSeconds,
            0,
            Math.Max(0, durationSeconds_ - note.Duration.TotalSeconds)));

        var min = SelectedPanMinSemitone ?? change.Semitone;
        var max = SelectedPanMaxSemitone ?? change.Semitone;
        note.Note = Note.FromSemitoneNumber(Math.Clamp(change.Semitone, Math.Min(min, max), Math.Max(min, max)));
    }


    private void ResizeSelected(double delta)
    {
        var note = notes_.FirstOrDefault(x => x.Id == selectedNoteId_);
        if (note is null)
            return;

        note.Duration = TimeSpan.FromSeconds(Math.Clamp(note.Duration.TotalSeconds + delta, 0.05, Math.Max(0.05, durationSeconds_ - note.Start.TotalSeconds)));
    }

    private void ChangeSelectedPitch(int semitoneDelta)
    {
        var note = notes_.FirstOrDefault(x => x.Id == selectedNoteId_);
        if (note is null || semitoneDelta == 0)
            return;

        SetSelectedPitch(note.Note.SemitoneNumber + semitoneDelta);
    }

    private void SetSelectedPitch(int semitone)
    {
        var note = notes_.FirstOrDefault(x => x.Id == selectedNoteId_);
        if (note is null)
            return;

        var min = SelectedPanMinSemitone ?? semitone;
        var max = SelectedPanMaxSemitone ?? semitone;
        note.Note = Note.FromSemitoneNumber(Math.Clamp(semitone, Math.Min(min, max), Math.Max(min, max)));
    }

    private void DeleteNote(Guid id)
    {
        notes_.RemoveAll(x => x.Id == id);
        if (selectedNoteId_ == id)
            selectedNoteId_ = null;
    }

    private async Task ClearNotesAsync()
    {
        var options = new ModalOptions
        {
            OnComplete = async () =>
            {
                notes_.Clear();
                selectedNoteId_ = null;
                recordingPositionSeconds_ = 0;
            }
        };

        await Modals.OpenAsync("ClearNotes", options);
    }


    private double GetCurrentRecordingPositionSeconds(double? audioTimeSeconds = null)
    {
        if (audioTimeSeconds is double audioTime && recordStartedAtAudioTimeSeconds_ is double startedAudioTime)
        {
            return Math.Clamp(
                recordingStartSeconds_ + audioTime - startedAudioTime,
                0,
                Math.Max(1, durationSeconds_));
        }

        return Math.Clamp(
            recordingStartSeconds_ + (DateTimeOffset.UtcNow - recordStartedAt_).TotalSeconds,
            0,
            Math.Max(1, durationSeconds_));
    }

    private async Task<double?> TryGetAudioTimeAsync()
    {
        try
        {
            return await Playback.GetAudioTimeAsync();
        }
        catch (JSException)
        {
            return null;
        }
    }

    private void StartRecordingPositionLoop()
    {
        recordingPositionCts_?.Cancel();
        recordingPositionCts_?.Dispose();
        recordingPositionCts_ = new CancellationTokenSource();
        _ = UpdateRecordingPositionAsync(recordingPositionCts_.Token);
    }

    private async Task UpdateRecordingPositionAsync(CancellationToken cancellationToken)
    {
        using var timer = new PeriodicTimer(TimeSpan.FromMilliseconds(33));

        try
        {
            while (await timer.WaitForNextTickAsync(cancellationToken))
            {
                if (!isRecording_)
                    return;

                recordingPositionSeconds_ = GetCurrentRecordingPositionSeconds();

                if (recordingPositionSeconds_ >= durationSeconds_)
                {
                    StopRecording();
                }

                await InvokeAsync(StateHasChanged);
            }
        }
        catch (OperationCanceledException)
        {
        }
    }

    private void StopRecordingOverlay()
    {
        countInCts_?.Cancel();
        StopRecording();
        isCountingIn_ = false;
        isRecordOverlayOpen_ = false;
    }

    private void StopRecording()
    {
        if (isRecording_)
        {
            recordingPositionSeconds_ = GetCurrentRecordingPositionSeconds();
        }

        isRecording_ = false;
        isRecordOverlayOpen_ = false;
        recordingPositionCts_?.Cancel();
        metronomeCts_?.Cancel();
        recordingPositionSeconds_ = 0;
    }

    private void StartMetronomeClickLoop()
    {
        metronomeCts_?.Cancel();
        metronomeCts_?.Dispose();
        metronomeCts_ = new CancellationTokenSource();
        _ = RunMetronomeClickLoopAsync(metronomeCts_.Token);
    }

    private async Task RunMetronomeClickLoopAsync(CancellationToken cancellationToken)
    {
        var secondsPerBeat = GetSecondsPerBeat(beatUnit_);
        var nextBeatIndex = (int)Math.Ceiling(Math.Max(0, recordingStartSeconds_ - 0.0001) / Math.Max(secondsPerBeat, 0.001));

        try
        {
            while (!cancellationToken.IsCancellationRequested && isRecording_)
            {
                var nextBeatSeconds = nextBeatIndex * secondsPerBeat;
                var delaySeconds = nextBeatSeconds - recordingPositionSeconds_;

                if (delaySeconds > 0)
                    await Task.Delay(TimeSpan.FromSeconds(delaySeconds), cancellationToken);

                if (!isRecording_ || cancellationToken.IsCancellationRequested)
                    return;

                var isAccent = nextBeatIndex % Math.Max(1, beatsPerBar_) == 0;
                await PlayMetronomeTickAsync(isAccent, cancellationToken);
                nextBeatIndex++;
            }
        }
        catch (OperationCanceledException)
        {
        }
    }

    private async Task PlayMetronomeTickAsync(bool isAccent, CancellationToken cancellationToken)
    {
        try
        {
            await Playback.PlayMetronomeTickAsync(isAccent, cancellationToken);
        }
        catch (JSException)
        {
        }
    }

    private async Task TogglePlaybackAsync()
    {
        if (isPlayingBack_)
        {
            await StopPlaybackAsync();
            return;
        }

        if (notes_.Count == 0 || isRecording_ || isCountingIn_)
            return;

        playbackCts_?.Cancel();
        playbackCts_?.Dispose();
        playbackCts_ = new CancellationTokenSource();
        isPlayingBack_ = true;
        _ = PlayRecordedNotesAsync(playbackCts_.Token);
        await Task.CompletedTask;
    }

    private async Task StopPlaybackAsync()
    {
        if (!isPlayingBack_)
            return;

        isPlayingBack_ = false;
        playbackCts_?.Cancel();
        await InvokeAsync(StateHasChanged);
    }

    private async Task PlayRecordedNotesAsync(CancellationToken cancellationToken)
    {
        var start = Math.Clamp(recordingPositionSeconds_, 0, Math.Max(0, durationSeconds_));
        var startedAt = DateTimeOffset.UtcNow;
        var pending = notes_
            .Where(x => x.Start.TotalSeconds + x.Duration.TotalSeconds >= start)
            .OrderBy(x => x.Start.TotalSeconds)
            .ThenBy(x => x.Note.SemitoneNumber)
            .ToList();
        var index = 0;

        try
        {
            using var timer = new PeriodicTimer(TimeSpan.FromMilliseconds(20));
            while (await timer.WaitForNextTickAsync(cancellationToken))
            {
                var position = Math.Clamp(start + (DateTimeOffset.UtcNow - startedAt).TotalSeconds, 0, Math.Max(0, durationSeconds_));
                recordingPositionSeconds_ = position;

                while (index < pending.Count && pending[index].Start.TotalSeconds <= position + 0.01)
                {
                    await PreviewNoteAsync(pending[index].Note);
                    index++;
                }

                if (position >= durationSeconds_)
                    break;

                await InvokeAsync(StateHasChanged);
            }
        }
        catch (OperationCanceledException)
        {
        }
        finally
        {
            isPlayingBack_ = false;
            await InvokeAsync(StateHasChanged);
        }
    }

    private double GetDefaultNoteDurationSeconds()
    {
        var noteDivision = Math.Max(1, defaultNoteDivision_);
        return Math.Max(0.05, GetSecondsPerBeat(noteDivision));
    }

    private double GetSecondsPerBeat(int noteDivision)
    {
        var safeBpm = Math.Clamp(tempoBpm_, 1, 300);
        var safeDivision = Math.Max(1, noteDivision);
        return (60.0 / safeBpm) * (4.0 / safeDivision);
    }

    public async ValueTask DisposeAsync()
    {
        countInCts_?.Cancel();
        countInCts_?.Dispose();
        countInCts_ = null;
        recordingPositionCts_?.Cancel();
        recordingPositionCts_?.Dispose();
        recordingPositionCts_ = null;
        playbackCts_?.Cancel();
        playbackCts_?.Dispose();
        playbackCts_ = null;
        metronomeCts_?.Cancel();
        metronomeCts_?.Dispose();
        metronomeCts_ = null;
        await Task.CompletedTask;
    }

    private void SaveTrack()
    {
        StopRecording();
        error_ = null;
        if (notes_.Count == 0)
        {
            error_ = "Record at least one note before adding the track.";
            return;
        }

        if (string.IsNullOrWhiteSpace(trackName_))
        {
            error_ = "Please give your track a name.";
            return;
        }

        var track = new RecordTrackDraft
        {
            Id = editingTrackId_ ?? Guid.NewGuid(),
            Name = trackName_.Trim(),
            PanType = panType_,
            TempoBpm = Math.Clamp(tempoBpm_, 1, 300),
            BeatsPerBar = Math.Clamp(beatsPerBar_, 1, 32),
            BeatUnit = Math.Clamp(beatUnit_, 1, 64),
            DurationSeconds = Math.Clamp(durationSeconds_, 1, 1800),
            Events = notes_.Select(x => new MidiPanEvent
            {
                Id = x.Id == Guid.Empty ? Guid.NewGuid() : x.Id,
                Note = x.Note,
                Start = x.Start,
                Duration = x.Duration
            }).ToList()
        };

        if (editingTrackId_ is Guid existingTrackId)
            Draft.UpdateTrack(existingTrackId, track);
        else
            Draft.CreateTrack(track);

        Nav.NavigateTo("/record/files/create");
    }
}
