@page "/arrangements/create"
@attribute [Authorize]
@inject TaskRunnerService Tasks
@inject MidiManagerService MidiService
@inject SteelPanLoaderService PanLoader
@inject DbService Db
@inject NavigationManager Nav
@inject UserStateService UserState
@inject ModalPopupService Modals

<PageTitle>Create Recorded File</PageTitle>

<section class="sp-app-page record-file-page">
    <div class="sp-app-page__header record-file-page__header">
        <p class="sp-app-page__eyebrow">Record</p>
        <h1>Create File</h1>
        <p>Review your recorded tracks and save them as a MIDI file.</p>
        <p class="sp-app-alert sp-app-alert--error @(string.IsNullOrWhiteSpace(Tasks.Error) ? "sp-app-alert--hidden" : "")">@Tasks.Error</p>
        <p class="sp-app-alert sp-app-alert--success @(string.IsNullOrWhiteSpace(Tasks.Message) ? "sp-app-alert--hidden" : "")">@Tasks.Message</p>
    </div>

    <div class="sp-app-card record-file-page__form">
        <label>
            Title
            <input @bind="title_" @bind:after="OnTitleChanged" placeholder="Enter arrangement name here..." />
        </label>

        <div class="record-file-page__actions">
            <button type="button" class="sp-app-button sp-app-button--secondary" @onclick="BackAsync">Back</button>
            <a class="sp-app-button sp-app-button--secondary" href="/arrangements/tracks/create">Add Track</a>
            <button type="button" class="sp-app-button sp-app-button--secondary" disabled="@(Tasks.Busy || MidiService.Edit.Tracks.Count == 0)" @onclick="SaveDraftAsync">Save Draft</button>
            <button type="button" class="sp-app-button" disabled="@(Tasks.Busy || MidiService.Edit.Tracks.Count == 0)" @onclick="SaveFileAsync">Save</button>
        </div>
    </div>

    @if (MidiService.Edit.Tracks.Count == 0)
    {
        <div class="sp-app-card record-file-page__empty">
            <h2>No recorded tracks</h2>
            <p>Add at least one track.</p>
        </div>
    }
    else
    {
        <div class="record-file-page__tracks">
            @foreach (var track in MidiService.Edit.Tracks)
            {
                <article class="sp-app-card record-file-page__track">
                    <div>
                        <h2>@(track.Name ?? $"Track {track.Index + 1}")</h2>
                        <p>@track.PanType · @track.TempoBpm BPM · @track.BeatsPerBar/@track.BeatUnit · @track.DurationSeconds.ToString("0.#")s</p>
                        <small>@track.Events.Count note@(track.Events.Count == 1 ? "" : "s")</small>
                    </div>
                    <div class="record-file-page__track-actions">
                        <a class="sp-app-button sp-app-button--secondary" href="/arrangements/tracks/edit/@track.Id">Edit</a>
                        <button type="button" class="sp-app-button sp-app-button--danger" @onclick="() => RemoveTrack(track.Id)">Remove</button>
                    </div>
                    <MidiTrackVisualiser Mode="MidiTrackVisualiserMode.Edit"
                                         ShowEditTools="false"
                                         PanLabel="@track.PanType.ToSpacedPascal()"
                                         TrackLabel="@(track.Name ?? $"Track {track.Index + 1}")"
                                         Notes="track.Events"
                                         DurationSeconds="track.DurationSeconds"
                                         MinSemitone="GetPanMinSemitone(track.PanType)"
                                         MaxSemitone="GetPanMaxSemitone(track.PanType)"
                                         TempoBpm="track.TempoBpm"
                                         BeatsPerBar="track.BeatsPerBar"
                                         BeatUnit="track.BeatUnit" />
                </article>
            }
        </div>
    }
</section>

@code {
    private string title_ = string.Empty;

    protected override void OnInitialized()
    {
        MidiService.Edit.BeginCreateFile();
        title_ = MidiService.Edit.Title;
    }

    private void OnTitleChanged() => MidiService.Edit.SetTitle(title_);

    private void RemoveTrack(Guid id) => MidiService.Edit.RemoveTrack(id);

    private SteelPan? GetPan(PanType panType) => PanLoader.Pans.FirstOrDefault(x => x.Type == panType);
    private int? GetPanMinSemitone(PanType panType) => GetPan(panType)?.Notes.Select(x => x.Note.SemitoneNumber).DefaultIfEmpty().Min();
    private int? GetPanMaxSemitone(PanType panType) => GetPan(panType)?.Notes.Select(x => x.Note.SemitoneNumber).DefaultIfEmpty().Max();

    private async Task SaveDraftAsync()
    {
        GroupFileDto? newFile = null;

        var success = await Tasks.RunSafe(async () =>
        {
            if (string.IsNullOrWhiteSpace(title_))
                throw new Exception("Please enter a title for the draft");

            if (MidiService.Edit.Tracks.Count == 0)
                throw new Exception("Add at least one track before saving a MidiService.Edit.");

            newFile = await SaveCurrentFileAsync(isIncomplete: true);
            MidiService.Edit.MarkSaved();
            await UserState.RefreshAsync();
            return $"Saved draft {newFile.Title}.";
        });
    }

    private async Task<GroupFileDto> SaveCurrentFileAsync(bool isIncomplete)
    {
        MidiService.Edit.SetTitle(title_);
        var first = MidiService.Edit.Tracks[0];
        return await Db.MidiFiles.CreateRecordedMidiFileAsync(
            new DbService.MidiDbService.CreateRecordedMidiFileRequest(
                MidiService.Edit.FileId,
                title_,
                first.TempoBpm,
                first.BeatsPerBar,
                first.BeatUnit,
                MidiService.Edit.Tracks.Select(track => new DbService.MidiDbService.CreateRecordedMidiTrackRequest(
                    (track.Name ?? $"Track {track.Index + 1}"),
                    track.PanType,
                    track.DurationSeconds,
                    track.Events.Select(note => new DbService.MidiDbService.CreateRecordedMidiNoteRequest(
                        note.Note,
                        note.Start.TotalSeconds,
                        note.Duration.TotalSeconds)).ToList())).ToList(),
                isIncomplete));
    }

    private async Task BackAsync()
    {
        if (!MidiService.Edit.HasUnsavedChanges)
        {
            Nav.NavigateTo("/arrangements");
            return;
        }

        await Modals.OpenAsync("UnsavedChanges", new ModalOptions
        {
            OnSuccess = () =>
            {
                MidiService.Edit.Clear();
                Nav.NavigateTo("/arrangements");
                return Task.CompletedTask;
            }
        });
    }

    private async Task SaveFileAsync()
    {
        GroupFileDto? newFile = null;

        var success = await Tasks.RunSafe(async () =>
        {
            if (string.IsNullOrWhiteSpace(title_))
                throw new Exception("Please enter a title for the file");

            if (MidiService.Edit.Tracks.Count == 0)
                throw new Exception("Add at least one track before saving.");

            newFile = await SaveCurrentFileAsync(isIncomplete: false);

            MidiService.Edit.Clear();
            await UserState.RefreshAsync();
            return $"Saved {newFile.Title}. Redirecting...";
        });

        if (success && newFile is not null)
        {
            _ = Task.Delay(1500).ContinueWith(_ => Nav.NavigateTo($"/arrangements/{newFile.Id}"));
        }
    }
}
