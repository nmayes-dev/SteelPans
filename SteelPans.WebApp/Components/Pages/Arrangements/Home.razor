@page "/arrangements"
@attribute [Authorize]
@inject TaskRunnerService Tasks
@inject UserStateService UserState
@implements IDisposable

<PageTitle>MIDI Files</PageTitle>

<section class="sp-app-page midi-files midi-files-home">
    <div class="sp-app-page__header midi-files-home__header">
        <p class="sp-app-page__eyebrow">Steel Pans</p>
        <h1>MIDI Files</h1>
        <p>Manage uploaded MIDI files, track assignments, and group sharing.</p>

        <p class="sp-app-alert sp-app-alert--error @(!string.IsNullOrWhiteSpace(Tasks.Error) ? "sp-app-alert--visible" : "sp-app-alert--hidden")">@Tasks.Error</p>
        <p class="sp-app-alert sp-app-alert--success @(!string.IsNullOrWhiteSpace(Tasks.Message) ? "sp-app-alert--visible" : "sp-app-alert--hidden")">@Tasks.Message</p>
    </div>

    <div class="midi-files-home__actions">
        <a class="sp-app-button" href="/">Home</a>
        <a class="sp-app-button sp-app-button--primary" href="/arrangements/upload">Upload</a>
        <a class="sp-app-button sp-app-button--primary" href="/arrangements/create">Create</a>
    </div>

    <div class="sp-app-card midi-files-home__card">
        <div class="midi-files-home__card-header">
            <h2>Your MIDI Files</h2>
            <small>@(UserState.Files?.Count ?? 0) file@((UserState.Files?.Count ?? 0) == 1 ? "" : "s")</small>
        </div>

        @if (UserState.Files is null)
        {
            <p>Loading files...</p>
        }
        else if (UserState.Files.Count == 0)
        {
            <p>You have not uploaded any MIDI files yet. Upload a file to start editing assignments and sharing with groups.</p>
        }
        else
        {
            <div class="sp-app-list midi-files-home__list">
                @foreach (var file in UserState.Files)
                {
                    <article class="sp-app-list-item midi-files-home__file">
                        <div class="midi-files-home__copy">
                            <strong>@file.Title</strong>
                            <small>@file.OriginalFileName · @FormatSize(file.SizeBytes) · @GetFileAccessLabel(file)</small>
                        </div>

                        <div class="sp-app-list-item__actions">
                            <a class="sp-app-button sp-app-button--primary" href="/arrangements/@file.Id">View / Edit</a>
                            <a class="sp-app-button" href="/play/ensemble?file=@file.Id">Band</a>
                            <a class="sp-app-button" href="/play/solo?file=@file.Id">Practice</a>
                        </div>
                    </article>
                }
            </div>
        }
    </div>
</section>

@code {
    protected override void OnInitialized()
    {
        UserState.OnRefresh += OnRefreshAsync;
    }

    private Task OnRefreshAsync(StateUpdate updateFlag)
    {
        if (!updateFlag.HasAny(StateUpdate.Files))
            return Task.CompletedTask;

        return InvokeAsync(StateHasChanged);
    }

    public void Dispose()
    {
        UserState.OnRefresh -= OnRefreshAsync;
    }

    private string GetFileAccessLabel(GroupFileDto file)
    {
        if (file.SharedGroupIds.Count == 0)
            return "Private";

        var groupNames = (UserState.Groups ?? [])
            .Where(x => file.SharedGroupIds.Contains(x.Summary.Id))
            .Select(x => x.Summary.Name)
            .ToList();

        return groupNames.Count switch
        {
            0 => $"Shared with {file.SharedGroupIds.Count} group(s)",
            1 => $"Shared with {groupNames[0]}",
            _ => $"Shared with {string.Join(", ", groupNames)}"
        };
    }

    private static string FormatSize(long bytes)
    {
        if (bytes < 1024) return $"{bytes} B";
        if (bytes < 1024 * 1024) return $"{bytes / 1024d:0.#} KB";
        return $"{bytes / 1024d / 1024d:0.#} MB";
    }
}
