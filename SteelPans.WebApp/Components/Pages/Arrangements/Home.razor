@page "/arrangements"
@attribute [Authorize]
@inject TaskRunnerService Tasks
@inject DbService Db
@inject UserStateService UserState
@inject NavigationManager Nav
@implements IDisposable

<PageTitle>Arrangements</PageTitle>

<section class="sp-app-page midi-files midi-files-home">
    <div class="sp-app-page__header midi-files-home__header">
        <h1>Arrangements</h1>
        <p>Manage uploaded arrangements, track assignments, and group sharing.</p>
    </div>

    <div class="midi-files-home__actions">
        <a class="sp-app-button sp-app-button--primary" href="/arrangements/upload">Upload</a>
        <a class="sp-app-button sp-app-button--primary" href="/arrangements/create">Create</a>
    </div>

    <div class="sp-app-card midi-files-home__card">
        <div class="midi-files-home__card-header">
            <h2>Your Arrangements</h2>
            <small>@(UserState.Files?.Count ?? 0) file@((UserState.Files?.Count ?? 0) == 1 ? "" : "s")</small>
        </div>
        @if (UserState.Files is null)
        {
            <p>Loading files...</p>
        }
        else if (UserState.Files.Count == 0)
        {
            <p>You have not uploaded any MIDI files yet. Upload a file to start editing assignments and sharing with groups.</p>
        }
        else
        {
            <div class="sp-app-list midi-files-home__list">
                @foreach (var file in UserState.Files)
                {
                    <button type="button"
                            class="sp-app-list-item midi-files-home__file"
                            @onclick="() => OnFileSelected(file.Id)">
                        <span class="midi-files-home__copy">
                            <strong>@file.Title</strong>
                            <small>@file.OriginalFileName · @file.SizeBytes.ToFileSize() · @GetTrackCountLabel(file.Id)</small>
                        </span>
                    </button>
                }
            </div>
        }
    </div>
</section>

@code {
    private Dictionary<Guid, string> trackCounts_ = new();

    protected override async Task OnInitializedAsync()
    {
        UserState.OnRefresh += OnRefreshAsync;
        await UpdateTrackCountLabelsAsync();
    }

    private async Task OnRefreshAsync(StateUpdate updateFlag)
    {
        if (!updateFlag.HasAny(StateUpdate.Files))
            return;

        await UpdateTrackCountLabelsAsync();
        await InvokeAsync(StateHasChanged);
    }

    private async Task UpdateTrackCountLabelsAsync()
    {
        Func<GroupFileDto, Task<KeyValuePair<Guid, string>>> getTrackCount = async (f) => KeyValuePair.Create(f.Id, await GetTrackCountLabelAsync(f.Id));
        var details = await Task.WhenAll(UserState.Files.Select(getTrackCount));
        trackCounts_ = details.ToDictionary();
    }

    public void Dispose()
    {
        UserState.OnRefresh -= OnRefreshAsync;
    }

    private void OnFileSelected(Guid id)
    {
        Nav.NavigateTo($"/arrangements/{id}");
    }

    private string GetTrackCountLabel(Guid id)
    {
        if (trackCounts_.TryGetValue(id, out var label))
            return label;

        return "Loading...";
    }

    private async Task<string> GetTrackCountLabelAsync(Guid id)
    {
        var preview = await Db.MidiFiles.GetMidiFileDetailsAsync(id);
        if (preview is null)
            return "0 Tracks";

        var trackCount = preview.Tracks.Count;
        return $"{trackCount} Track{(trackCount == 1 ? "" : "s")}";
    }
}
