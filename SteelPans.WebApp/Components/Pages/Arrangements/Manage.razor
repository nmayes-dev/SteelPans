@page "/arrangements/{FileId:guid}"
@attribute [Authorize]
@inject DbService Db
@inject TaskRunnerService Tasks
@inject UserStateService UserState
@inject ModalPopupService Modals
@inject NavigationManager Nav
@implements IDisposable

<PageTitle>@title_</PageTitle>

<section class="sp-app-page midi-files midi-file-page">
    <div class="sp-app-page__header midi-file-page__header">
        <p class="sp-app-page__eyebrow">Steel Pans</p>
        <h1>@title_</h1>
        <p>@subtitle_</p>

        <p class="sp-app-alert sp-app-alert--error @(!string.IsNullOrWhiteSpace(Tasks.Error) ? "sp-app-alert--visible" : "sp-app-alert--hidden")">@Tasks.Error</p>
        <p class="sp-app-alert sp-app-alert--success @(!string.IsNullOrWhiteSpace(Tasks.Message) ? "sp-app-alert--visible" : "sp-app-alert--hidden")">@Tasks.Message</p>
    </div>

    <div class="midi-file-page__actions">
        <a class="sp-app-button" href="/arrangements">Back</a>
        @if (File is not null)
        {
            <a class="sp-app-button" href="/play/ensemble?file=@File.Id">Play</a>
            <button class="sp-app-button"
                    type="button"
                    @onclick="TogglePreviewAsync">
                Tracks
            </button>
            <button class="sp-app-button sp-app-button--danger"
                    type="button"
                    @onclick="() => OpenDeleteFileModal(File)">
                Delete
            </button>
        }
    </div>

    @if (File is not null)
    {
        <div class="sp-app-grid sp-app-grid--two midi-file-page__grid">
            <div class="sp-app-card midi-file-page__card">
                <div class="midi-files__section-header">
                    <h2>Share</h2>
                </div>

                @if (UserState.Groups is null)
                {
                    <p>Loading groups...</p>
                }
                else
                {
                    var groups = UserState.Groups
                        .Where(x => x.CanManage())
                        .Where(g => !File.SharedGroupIds.Contains(g.Summary.Id))
                        .ToList();

                    <div class="sp-app-field midi-file-page__group-select">
                        <select class="sp-app-select @(targetShareGroup_ is null ? "sp-app-select--placeholder" : "")"
                                @bind="targetShareGroup_"
                                disabled="@(groups.Count == 0)">
                            <option disabled hidden value="">Choose a group...</option>
                            @foreach (var group in groups)
                            {
                                <option value="@group.Summary.Id">@group.Summary.Name</option>
                            }
                        </select>
                        <button class="sp-app-button sp-app-button--primary"
                                type="button"
                                disabled="@(targetShareGroup_ is null || Tasks.Busy)"
                                @onclick="ShareFileAsync">
                            Share
                        </button>
                    </div>


                }
            </div>

            <div class="sp-app-card midi-file-page__card">
                <div class="midi-files__section-header">
                    <h2>Groups</h2>
                </div>
                @if (UserState.Groups is null || File.SharedGroupIds.Count == 0)
                {
                    <p>This file is currently private.</p>
                }
                else
                {
                    <div class="sp-app-list midi-file-page__shares">
                        @foreach (var groupId in File.SharedGroupIds)
                        {
                            var group = UserState.Groups.FirstOrDefault(x => x.Summary.Id == groupId);
                            <article class="sp-app-list-item midi-file-page__share">
                                <div class="midi-file-page__copy">
                                    <strong>@(group?.Summary.Name ?? groupId.ToString())</strong>
                                </div>

                                @if (group?.CanManage() == true)
                                {
                                    <div class="sp-app-list-item__actions">
                                        <button class="sp-app-button sp-app-button--danger"
                                                type="button"
                                                @onclick="() => UnshareFileAsync(groupId)">
                                            Unshare
                                        </button>
                                    </div>
                                }
                            </article>
                        }
                    </div>
                }
            </div>
        </div>

        <MidiFilePreview @ref="filePreview_"
                         AllowEdit="true"
                         AllowPractice="true"
                         EditReturnTo="manage" />
    }
</section>

@code {
    [Parameter]
    public Guid FileId { get; set; }

    private GroupFileDto? File => UserState.Files?.FirstOrDefault(x => x.Id == FileId);

    private string title_ => File?.Title ?? "MIDI File";

    private const string LoadingFileSubtitle = "Loading file...";
    private const string NoFileSubtitle = "File not found.";
    private string noFileSubtitle_ = LoadingFileSubtitle;

    private string subtitle_ => File is null ? noFileSubtitle_ : $"{File.OriginalFileName} · {File.SizeBytes.ToFileSize()} · {File.UploadedAt.ToLocalTime().ToString("g")}";

    private Guid? targetShareGroup_;
    private MidiFilePreview? filePreview_;

    protected override void OnInitialized()
    {
        UserState.OnRefresh += OnRefreshAsync;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender)
            return;

        await UpdateNotFoundSubtitleAsync();

        if (filePreview_ is not null && FileId != Guid.Empty)
            await filePreview_.OpenPreviewAsync(FileId);
    }

    private async Task UpdateNotFoundSubtitleAsync()
    {
        if (File is not null)
            return;

        await Task.Delay(1000).ContinueWith(async _ =>
        {
            noFileSubtitle_ = NoFileSubtitle;
            await InvokeAsync(StateHasChanged);
        });
    }

    private Task OnRefreshAsync(StateUpdate updateFlag)
    {
        if (!updateFlag.HasAny(StateUpdate.Groups | StateUpdate.Files))
            return Task.CompletedTask;

        return InvokeAsync(StateHasChanged);
    }

    public void Dispose()
    {
        UserState.OnRefresh -= OnRefreshAsync;
    }


    private async Task TogglePreviewAsync()
    {
        if (filePreview_ is null)
            return;

        await filePreview_.TogglePreviewAsync(FileId);
        await InvokeAsync(StateHasChanged);
    }

    private async Task OpenDeleteFileModal(GroupFileDto file)
    {
        await Modals.OpenAsync("DeleteMidi", file, new ModalOptions { OnSuccess = async () => Nav.NavigateTo("/arrangements") });
    }

    private async Task ShareFileAsync()
    {
        if (targetShareGroup_ is null)
            return;

        await Tasks.RunSafe(async () =>
        {
            await Db.MidiFiles.ShareMidiFileWithGroupAsync(FileId, targetShareGroup_.Value);
            await UserState.RefreshAsync();

            targetShareGroup_ = null;
            return "MIDI file shared with group.";
        });
    }

    private async Task UnshareFileAsync(Guid groupId)
    {
        await Tasks.RunSafe(async () =>
        {
            await Db.MidiFiles.UnshareMidiFileWithGroupAsync(FileId, groupId);
            await UserState.RefreshAsync();

            return "MIDI file unshared from group.";
        });
    }
}
