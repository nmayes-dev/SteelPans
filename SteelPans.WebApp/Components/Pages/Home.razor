@page "/"
@inject NavigationManager Nav
@inject AuthenticationStateProvider AuthStateProvider

<PageTitle>Steel Pans</PageTitle>

<section class="leader-page leader-page--home">
    <div class="leader-home-shell">
        <div class="leader-hero">
            <h1>Steel Pans</h1>
            <p>Practice on interactive pans, share and create groups, and manage MIDI files for ensemble practice.</p>
        </div>

        <div class="leader-actions">
            <a class="leader-action-card" href="/pans">
                <span class="leader-action-card__icon bi bi-grid-1x2"></span>
                <strong>Practice</strong>
                <small>Interactive practice tool with MIDI playback.</small>
            </a>

            <a class="leader-action-card" href="/groups">
                <span class="leader-action-card__icon bi bi-people"></span>
                <strong>Groups</strong>
                <small>Create groups and copy invite links.</small>
            </a>

            <a class="leader-action-card" href="/midi-files">
                <span class="leader-action-card__icon bi bi-music-note-list"></span>
                <strong>Files</strong>
                <small>Preview tracks, upload files, and assign group access.</small>
            </a>
        </div>
    </div>
</section>