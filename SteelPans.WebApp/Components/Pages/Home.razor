@page "/"
@inject NavigationManager Nav
@inject AuthenticationStateProvider AuthStateProvider

<PageTitle>Steel Pans</PageTitle>

<section class="sp-app-page home-page">
    <div class="home-page__shell">
        <div class="home-page__hero">
            <h1>Steel Pans</h1>
            <p>Play ensemble demos, practise individual tracks, share groups, and manage MIDI files.</p>
        </div>

        <div class="home-page__actions">
            <a class="home-action-card" href="/play">
                <span class="home-action-card__icon bi bi-play-circle"></span>
                <strong>Play</strong>
                <small>Ensemble playback and individual track practice.</small>
            </a>

            <AuthorizeView>
                <Authorized Context="auth">
                    <a class="home-action-card" href="/arrangements">
                        <span class="home-action-card__icon bi bi-sliders"></span>
                        <strong>Arrangements</strong>
                        <small>Upload, record, and manage steel pan arragements.</small>
                    </a>

                    <a class="home-action-card" href="/groups">
                        <span class="home-action-card__icon bi bi-people"></span>
                        <strong>Groups</strong>
                        <small>Manage steel pan ensembles.</small>
                    </a>

                    <a class="home-action-card" href="/account">
                        <span class="home-action-card__icon bi bi-person-circle"></span>
                        <strong>Account</strong>
                        <small>View your account details.</small>
                    </a>
                </Authorized>
            </AuthorizeView>
        </div>
    </div>
    <footer>
        This app is made by one person for free. If you find any bugs or have any feature requests, please consider adding them
        <a href="https://github.com/nmayes-dev/SteelPans/issues/new/choose" target="_blank">here</a>
        or
        <a href="mailto:nmayes.dev@gmail.com" target="_blank">email me directly</a>.
        It would help out greatly!
    </footer>
</section>