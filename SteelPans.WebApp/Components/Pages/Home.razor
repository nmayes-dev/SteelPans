@page "/"
@inject NavigationManager Nav
@inject AuthenticationStateProvider AuthStateProvider

<PageTitle>Steel Pans</PageTitle>

<section class="sp-app-page home-page">
    <div class="home-page__shell">
        <div class="home-page__hero">
            <h1>Steel Pans</h1>
            <p>Play ensemble demos, practise individual tracks, share groups, and manage MIDI files.</p>
        </div>

        <div class="home-page__actions">
            <a class="home-action-card" href="/play">
                <span class="home-action-card__icon bi bi-play-circle"></span>
                <strong>Play</strong>
                <small>Ensemble playback and individual track practice.</small>
            </a>

            <a class="home-action-card" href="/record">
                <span class="home-action-card__icon bi bi-record-circle"></span>
                <strong>Record</strong>
                <small>Create new midi files by recording pan parts.</small>
            </a>

            <a class="home-action-card" href="/manage">
                <span class="home-action-card__icon bi bi-sliders"></span>
                <strong>Manage</strong>
                <small>Manage groups and midi files.</small>
            </a>

            <a class="home-action-card" href="/account">
                <span class="home-action-card__icon bi bi-person-circle"></span>
                <strong>Account</strong>
                <small>View your account details.</small>
            </a>
        </div>
    </div>
</section>