@page "/"
@inject NavigationManager Nav
@inject AuthenticationStateProvider AuthStateProvider

<PageTitle>Steel Pans</PageTitle>

<section class="sp-app-page home-page">
    <div class="home-page__shell">
        <div class="home-page__hero">
            <h1>Steel Pans</h1>
            <p>Practice on interactive pans, share and create groups, and manage MIDI files for ensemble practice.</p>
        </div>

        <div class="home-page__actions">
            <a class="home-action-card" href="/practice/play">
                <span class="home-action-card__icon bi bi-grid-1x2"></span>
                <strong>Practice</strong>
                <small>Interactive practice tool with MIDI playback.</small>
            </a>

            <a class="home-action-card" href="/manage">
                <span class="home-action-card__icon bi bi-sliders"></span>
                <strong>Manage</strong>
                <small>Manage groups and midi files.</small>
            </a>

            <a class="home-action-card" href="/account">
                <span class="home-action-card__icon bi bi-person-circle"></span>
                <strong>Account</strong>
                <small>View your account details.</small>
            </a>
        </div>
    </div>
</section>