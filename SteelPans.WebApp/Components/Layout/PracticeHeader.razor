@implements IDisposable
@inject MidiManagerService MidiService

<section class="sp-app-section practice-header__controls">
    <ControlToolbar />

    <div class="practice-header__midi-controls @(MidiService.Playback.IsMidiLoaded ? "practice-header__midi-controls--visible" : "practice-header__midi-controls--empty")">
        @if (MidiService.Playback.IsMidiLoaded)
        {
            var hasMidiControls = MidiService.Playback.ActivePans.Any(x => x.Events.Count > 0);
            <MidiPlaybackControl Enabled="@hasMidiControls" />
        }
        else
        {
            <div class="practice-header__midi-message">
                @if (MidiService.Playback.ActivePans.Any())
                {
                    <span>Click the cog to load a MIDI file and enable ensemble playback controls.</span>
                }
                else
                {
                    <span>Click the cog to load a MIDI file or add pans to begin ensemble MidiService.Playback.</span>
                }
            </div>
        }
    </div>

    @if (MidiService.Playback.IsMidiLoaded)
    {
        <CountInControl />
    }
</section>

@code {
    protected override void OnInitialized()
    {
        MidiService.Playback.MidiFileLoaded += PlaybackStateUpdate;
        MidiService.Playback.MidiFileUnloaded += PlaybackStateUpdate;
    }

    public void Dispose()
    {
        MidiService.Playback.MidiFileLoaded -= PlaybackStateUpdate;
        MidiService.Playback.MidiFileUnloaded -= PlaybackStateUpdate;
    }

    private Task PlaybackStateUpdate<TArgs>(TArgs _)
    {
        return InvokeAsync(StateHasChanged);
    }
}