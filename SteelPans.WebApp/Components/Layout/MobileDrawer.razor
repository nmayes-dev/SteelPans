@implements IAsyncDisposable
@inherits OverlayComponentBase
@inject SafeJSInteropService JS

<div @ref="drawer_"
     class="@DrawerClass"
     style="--drawer-position: @Position;">
    <div class="mobile-drawer__lip">
        <div class="mobile-drawer__handle"></div>
    </div>

    <div class="mobile-drawer__content">
        @ChildContent
    </div>
</div>

@code {
    public enum Edge
    {
        Bottom,
        Top,
        Left,
        Right
    }

    [Parameter, EditorRequired]
    public RenderFragment ChildContent { get; set; } = default!;

    [Parameter]
    public Edge Side { get; set; } = Edge.Bottom;

    [Parameter]
    public Edge? ResponsiveSide { get; set; }

    [Parameter]
    public int? ResponsiveThreshold { get; set; }

    [Parameter]
    public string Position { get; set; } = "50%";

    [Parameter]
    public bool InitiallyOpen { get; set; }

    private ElementReference drawer_;
    private DotNetObjectReference<MobileDrawer>? dotNetRef_;
    private IJSObjectReference? module_;

    private bool initialized_;
    private bool disposed_;

    private string SideClass =>
        $"mobile-drawer--{Side.ToString().ToLowerInvariant()}";

    private string DrawerClass =>
        $"mobile-drawer mobile-drawer--pending mobile-drawer--no-transition mobile-drawer--closed {SideClass}";

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender || disposed_)
            return;

        dotNetRef_ = DotNetObjectReference.Create(this);

        var module = await JS.ImportModuleAsync<MobileDrawer>();
        if (disposed_)
        {
            await module.DisposeAsync();
            return;
        }

        module_ = module;
        await module_.InvokeVoidAsync(
            "initialize",
            drawer_,
            Side.ToString().ToLowerInvariant(),
            InitiallyOpen,
            dotNetRef_,
            ResponsiveSide?.ToString().ToLowerInvariant(),
            ResponsiveThreshold);

        initialized_ = true;
    }

    protected override async Task OnCloseAsync()
    {
        if (!initialized_ || disposed_ || module_ is null)
            return;

        try
        {
            await module_.InvokeVoidAsync("close", drawer_);
        }
        catch (JSDisconnectedException)
        {
        }
    }

    [JSInvokable]
    public Task NotifyOpenedFromJsAsync()
    {
        return NotifyOpenedAsync();
    }

    [JSInvokable]
    public Task NotifyClosedFromJsAsync()
    {
        return RequestCloseAsync();
    }

    public override void Dispose()
    {
        if (disposed_)
            return;

        disposed_ = true;

        dotNetRef_?.Dispose();
        dotNetRef_ = null;

        base.Dispose();
    }

    public async ValueTask DisposeAsync()
    {
        if (disposed_)
            return;

        try
        {
            if (module_ is not null)
            {
                if (initialized_)
                    await module_.InvokeVoidAsync("dispose", drawer_);

                await module_.DisposeAsync();
            }
        }
        catch (JSDisconnectedException)
        {
            // A Blazor Server circuit can disconnect before disposal completes.
        }
        finally
        {
            Dispose();
        }
    }
}
