@inject ModalPopupService Modals
@inject NavigationManager Navigation
@inject NavigationHistoryService NavigationHistory
@implements IDisposable

<div class="navbar-full-display">
    <div class="top-row navbar navbar-dark">
        <div class="container-fluid">
            <button type="button"
                    class="navbar-back-button"
                    title="Back"
                    disabled="@DisableBackButton"
                    aria-label="Back"
                    @onclick="GoBack">
                <span class="bi bi-arrow-left" aria-hidden="true"></span>
            </button>
            <a class="navbar-brand" href="">Steel Pans</a>
        </div>
    </div>
    @NavigationOptionsFragment(backButton: false)
</div>

<div class="navbar-mobile-display">
    <MobileDrawer @ref="mobileLayout_"
                  Side="MobileDrawer.Edge.Top"
                  Position="100%">
        @NavigationOptionsFragment(backButton: true)
    </MobileDrawer>
</div>

@code {
    private MobileDrawer? mobileLayout_;

    private bool DisableBackButton
    {
        get
        {
            var path = Navigation.ToBaseRelativePath(Navigation.Uri)
                .Split('?', '#')[0]
                .TrimEnd('/');

            return string.IsNullOrWhiteSpace(path);
        }
    }

    protected override void OnInitialized()
    {
        Navigation.LocationChanged += OnLocationChanged;
    }

    private void GoBack() => NavigationHistory.Back("/");

    private async Task GoBackInOverlay()
    {
        await OnNavigationItemClicked();
        GoBack();
    }

    private void OnLocationChanged(object? sender, LocationChangedEventArgs args)
    {
        _ = InvokeAsync(StateHasChanged);
    }

    private async Task OpenLogoutAsync()
    {
        await Modals.OpenAsync("Logout");
    }

    public void Dispose()
    {
        Navigation.LocationChanged -= OnLocationChanged;
    }

    private async Task OnNavigationItemClicked(string? targetLocation = null)
    {
        if (mobileLayout_ is not null && targetLocation != Navigation.ToBaseRelativePath(Navigation.Uri))
        {
            await mobileLayout_.RequestCloseAsync();
        }
    }

    private RenderFragment NavigationOptionsFragment(bool backButton) => @<nav class="nav flex-column">
        @if (backButton && !DisableBackButton)
        {
            <div class="nav-item">
                <button class="nav-link" @onclick="GoBackInOverlay">
                    <span class="bi bi-arrow-left" aria-hidden="true" /> Back
                </button>
            </div>
        }
        <div class="nav-item">
            <NavLink class="nav-link" href="" Match="NavLinkMatch.All" @onclick="() => OnNavigationItemClicked(string.Empty)">
                <span class="bi bi-house-door-fill" aria-hidden="true" /> Home
            </NavLink>
        </div>

        <div class="nav-item">
            <NavLink class="nav-link" href="play" @onclick='() => OnNavigationItemClicked("play")'>
                <span class="bi bi-play-circle" aria-hidden="true" /> Play
            </NavLink>
        </div>

        <AuthorizeView>
            <Authorized Context="auth">

                <div class="nav-item">
                    <NavLink class="nav-link" href="arrangements" @onclick='() => OnNavigationItemClicked("arrangements")'>
                        <span class="bi bi-sliders" aria-hidden="true" /> Arrangements
                    </NavLink>
                </div>

                <div class="nav-item">
                    <NavLink class="nav-link" href="groups" @onclick='() => OnNavigationItemClicked("groups")'>
                        <span class="bi bi-people" aria-hidden="true" /> Groups
                    </NavLink>
                </div>

                <div class="nav-item">
                    <NavLink class="nav-link" href="account" @onclick='() => OnNavigationItemClicked("account")'>
                        <span class="bi bi-person-circle" aria-hidden="true" /> Account
                    </NavLink>
                </div>

                <div class="nav-item">
                    <button class="nav-link" @onclick="OpenLogoutAsync">
                        <span class="bi bi-box-arrow-right" aria-hidden="true" /> Logout
                    </button>
                </div>
            </Authorized>

            <NotAuthorized>
                <div class="nav-item">
                    <a class="nav-link" href="/account/login" @onclick='() => OnNavigationItemClicked("login")'>
                        <span class="bi bi-box-arrow-in-right" aria-hidden="true" /> Login
                    </a>
                </div>
            </NotAuthorized>
        </AuthorizeView>
    </nav>;
}