<div class="top-row ps-3 navbar navbar-dark">
    <div class="container-fluid">
        <a class="navbar-brand" href="">Steel Pans</a>
    </div>
</div>

<input type="checkbox" title="Navigation menu" class="navbar-toggler" />

<div class="nav-scrollable" onclick="document.querySelector('.navbar-toggler').click()">
    <nav class="nav flex-column">
        <div class="nav-item px-3">
            <NavLink class="nav-link" href="" Match="NavLinkMatch.All">
                <span class="bi bi-house-door-fill-nav-menu" aria-hidden="true"></span> Home
            </NavLink>
        </div>

        <div class="nav-item px-3">
            <NavLink class="nav-link" href="pans">
                <span class="bi bi-grid-1x2-nav-menu" aria-hidden="true"></span> Practice
            </NavLink>
        </div>

        <div class="nav-item px-3">
            <NavLink class="nav-link" href="groups">
                <span class="bi bi-people-fill-nav-menu" aria-hidden="true"></span> Groups
            </NavLink>
        </div>

        <div class="nav-item px-3">
            <NavLink class="nav-link" href="midi-files">
                <span class="bi bi-music-note-list-nav-menu" aria-hidden="true"></span> MIDI Files
            </NavLink>
        </div>
        
        <AuthorizeView>
            <Authorized Context="auth">
                <div class="nav-item px-3">
                    <button class="nav-link" @onclick="() => logoutModal_!.OpenAsync()">
                        <span class="bi bi-box-arrow-right-nav-menu" aria-hidden="true"></span> Logout
                    </button>
                    <Logout @ref="logoutModal_" />
                </div>
            </Authorized>

            <NotAuthorized>
                <div class="nav-item px-3">
                    <a class="nav-link" href="/account/login">
                        <span class="bi bi-box-arrow-left-nav-menu" aria-hidden="true"></span> Login
                    </a>
                </div>
            </NotAuthorized>
        </AuthorizeView>
    </nav>
</div>

@code {
    Logout? logoutModal_;
}