@implements IAsyncDisposable

@inject MidiManagerService MidiService
@inject ModalPopupService Modals
@inject UserStateService UserState
@inject SafeJSInteropService JS
@inject IHostEnvironment Environment

<div class="pans-display">
    <div class="pans-display__items"
         @ref="assignedPansElement_"
         data-pan-count="@Pans.Count">
        @foreach (var assignedPan in Pans)
        {
            <section class="sp-app-section pans-display__item">
                <div class="pans-display__item-container"
                     @key="assignedPan.InstanceId"
                     data-pan-id="@assignedPan.InstanceId">
                    <SteelPanView Pan="@assignedPan.Pan"
                                  PlaybackInstanceId="@assignedPan.InstanceId" />
                </div>

                <div class="pans-display__item-overlay">
                    <div class="pan-display__item-overlay-top">
                        <div class="pans-display__item-overlay-left">
                            @if (TopLeftContent is not null)
                            {
                                @TopLeftContent(assignedPan)
                            }
                        </div>

                        <div class="pans-display__item-overlay-right">
                            @if (TopRightContent is not null)
                            {
                                @TopRightContent(assignedPan)
                            }
                        </div>
                    </div>

                    <div class="pan-display__item-overlay-bottom">
                        <div class="pans-display__item-copy-group pans-display__item-copy-group--left">
                            <div class="pans-display__item-type">
                                @assignedPan.Assignment.AssignedPanType.ToSpacedPascal()
                            </div>
                        </div>

                        <div class="pans-display__item-copy-group pans-display__item-copy-group--right">
                            <div class="pans-display__item-track">
                                @MidiService.Playback.GetTrackForAssignment(assignedPan.Assignment)?.Name
                            </div>
                        </div>
                    </div>
                </div>
            </section>
        }
    </div>
</div>

@code {
    [Parameter, EditorRequired]
    public IReadOnlyList<MidiAssignedPan> Pans { get; set; } = [];

    [Parameter]
    public EventCallback<IReadOnlyList<Guid>> OnPansReordered { get; set; }

    [Parameter]
    public RenderFragment<MidiAssignedPan>? TopLeftContent { get; set; }

    [Parameter]
    public RenderFragment<MidiAssignedPan>? TopRightContent { get; set; }

    [Parameter]
    public bool Locked { get; set; }

    private ElementReference assignedPansElement_;

    private IJSObjectReference? module_;
    private DotNetObjectReference<PansLayout>? dotNetReference_;

    private bool startingUp_;
    private bool panLayoutObserved_;
    private bool disposed_;

    protected override void OnInitialized()
    {
        MidiService.Playback.AssignmentsChanged += OnAssignmentsChangedAsync;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (disposed_)
            return;

        if (firstRender)
        {
            dotNetReference_ = DotNetObjectReference.Create(this);

            var module = await JS.ImportModuleAsync<PansLayout>();

            if (disposed_)
            {
                await module.DisposeAsync();
                return;
            }

            module_ = module;
        }

        await SynchronizeLayoutAsync();
    }

    private async Task SynchronizeLayoutAsync()
    {
        if (disposed_ || module_ is null)
            return;

        var hasPans = Pans.Count > 0;

        if (hasPans)
        {
            await InitialiseLayoutAsync();
        }
        else
        {
            await RemoveLayoutAsync();
        }
    }

    private async Task InitialiseLayoutAsync()
    {
        if (disposed_ ||
            startingUp_ ||
            panLayoutObserved_ ||
            module_ is null ||
            Pans.Count == 0)
        {
            return;
        }

        startingUp_ = true;

        try
        {
            await module_.InvokeVoidAsync(
                "observe",
                assignedPansElement_,
                dotNetReference_,
                Environment.IsDevelopment());

            panLayoutObserved_ = true;
        }
        catch
        {
            startingUp_ = false;
            throw;
        }
    }

    private async Task RemoveLayoutAsync()
    {
        if (disposed_ ||
            !panLayoutObserved_ ||
            module_ is null)
        {
            return;
        }

        await module_.InvokeVoidAsync(
            "disconnect",
            assignedPansElement_);

        panLayoutObserved_ = false;
        startingUp_ = false;
    }

    [JSInvokable]
    public async Task NotifyPansReordered(IReadOnlyList<string> panIds)
    {
        if (disposed_ || !OnPansReordered.HasDelegate)
            return;

        var orderedIds = panIds
            .Select(id => Guid.TryParse(id, out var guid)
                ? guid
                : (Guid?)null)
            .Where(id => id.HasValue)
            .Select(id => id!.Value)
            .ToArray();

        await InvokeAsync(async () =>
        {
            if (!disposed_)
                await OnPansReordered.InvokeAsync(orderedIds);
        });
    }

    [JSInvokable]
    public Task NotifyStartupComplete()
    {
        return InvokeAsync(() =>
        {
            if (disposed_)
                return;

            startingUp_ = false;
        });
    }

    private Task OnAssignmentsChangedAsync(
        MidiEventArgs.AssignmentsChanged args)
    {
        return InvokeAsync(StateHasChanged);
    }

    public async ValueTask DisposeAsync()
    {
        if (disposed_)
            return;

        disposed_ = true;

        MidiService.Playback.AssignmentsChanged -= OnAssignmentsChangedAsync;

        try
        {
            if (module_ is not null)
            {
                if (panLayoutObserved_)
                {
                    await module_.InvokeVoidAsync(
                        "disconnect",
                        assignedPansElement_);
                }

                await module_.DisposeAsync();
            }
        }
        catch (JSDisconnectedException)
        {
            // The Blazor Server circuit has disconnected.
        }
        finally
        {
            panLayoutObserved_ = false;
            startingUp_ = false;

            dotNetReference_?.Dispose();
            dotNetReference_ = null;

            module_ = null;
        }
    }
}
