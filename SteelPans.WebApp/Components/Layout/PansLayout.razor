@implements IAsyncDisposable
@inject MidiPlaybackService Playback
@inject ModalPopupService Modals
@inject UserStateService UserState
@inject SafeJSInteropService JS
@inject IHostEnvironment Environment

<div class="pans-display">
    <div class="pans-display__items"
         @ref="assignedPansElement_"
         data-pan-count="@Pans.Count">
        @foreach (var assignedPan in Pans)
        {
            <section class="sp-app-section pans-display__item"
                     @key="assignedPan.InstanceId"
                     data-pan-id="@assignedPan.InstanceId">
                <div class="pans-display__item-container">
                    <SteelPanView Pan="@assignedPan.Pan"
                                  PlaybackInstanceId="@assignedPan.InstanceId" />
                </div>

                <div class="pans-display__item-header">
                    <div class="pans-display__item-copy">
                        <div class="pans-display__item-copy-group pans-display__item-copy-group--left">
                            <div class="pans-display__item-copy-label">Pan</div>
                            <div class="pans-display__item-type">
                                @assignedPan.Assignment.AssignedPanType.ToSpacedPascal()
                            </div>
                        </div>

                        <div class="pans-display__item-copy-group pans-display__item-copy-group--right">
                            <div class="pans-display__item-copy-label">Track</div>
                            <div class="pans-display__item-track">
                                @assignedPan.Assignment.Track?.Name
                            </div>
                        </div>
                    </div>

                    @if (!Locked)
                    {
                        <button type="button"
                                class="pans-display__remove-button"
                                title="Remove"
                                aria-label="Remove"
                                data-pan-layout-no-drag
                                @onclick="() => OnRemovePan(assignedPan)">
                            <span class="bi bi-trash3"></span>
                        </button>
                    }
                </div>
            </section>
        }
    </div>
</div>

@code {   
    [Parameter, EditorRequired]
    public IReadOnlyList<MidiAssignedPan> Pans { get; set; } = [];

    [Parameter]
    public EventCallback<IReadOnlyList<Guid>> OnPansReordered { get; set; }

    [Parameter]
    public bool Locked { get; set; }

    private bool startingUp_;
    private ElementReference assignedPansElement_;
    private DotNetObjectReference<PansLayout>? dotNetReference_;
    private bool panLayoutObserved_;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender)
            return;

        Playback.AssignmentsChanged += OnPlaybackStateChangedAsync;
        await InitialiseLayoutAsync();
    }

    private async Task OnRemovePan(MidiAssignedPan pan)
    {
        await Modals.OpenAsync("RemovePan", pan);
    }

    private async Task InitialiseLayoutAsync()
    {
        if (startingUp_ || !Playback.ActivePans.Any())
            return;

        startingUp_ = true;
        dotNetReference_?.Dispose();
        dotNetReference_ = DotNetObjectReference.Create(this);

        await JS.InvokeVoidAsync(
            "panLayout.observe",
            assignedPansElement_,
            dotNetReference_,
            Environment.IsDevelopment());

        panLayoutObserved_ = true;
    }

    [JSInvokable]
    public async Task NotifyPansReordered(IReadOnlyList<string> panIds)
    {
        if (!OnPansReordered.HasDelegate)
            return;

        var orderedIds = panIds
            .Select(id => Guid.TryParse(id, out var guid) ? guid : (Guid?)null)
            .Where(id => id.HasValue)
            .Select(id => id!.Value)
            .ToArray();

        await OnPansReordered.InvokeAsync(orderedIds);
    }


    [JSInvokable]
    public async Task NotifyStartupComplete()
    {
        startingUp_ = false;
    }

    private async Task OnPlaybackStateChangedAsync<TArgs>(TArgs _)
    {
        await InitialiseLayoutAsync();
    }

    public async ValueTask DisposeAsync()
    {
        if (panLayoutObserved_)
            await JS.InvokeVoidAsync("panLayout.disconnect", assignedPansElement_);
        
        Playback.MidiFileLoaded -= OnPlaybackStateChangedAsync;
        Playback.MidiFileUnloaded -= OnPlaybackStateChangedAsync;
        dotNetReference_?.Dispose();
    }
}
