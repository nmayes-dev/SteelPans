@using SteelPans.WebApp.Extensions
@using SteelPans.WebApp.Model
@implements IAsyncDisposable
@inject IJSRuntime JS

<div class="pans-page__pan-stage">
    <div class="pans-page__assigned-pans"
         @ref="assignedPansElement_"
         data-pan-count="@Pans.Count">
        @foreach (var assignedPan in Pans)
        {
            <section class="sp-section pans-page__assigned-pan"
                     @key="assignedPan.InstanceId"
                     data-pan-id="@assignedPan.InstanceId">
                <div class="pans-page__assigned-pan-container">
                    <SteelPanView Pan="@assignedPan.Pan"
                                  PlaybackInstanceId="@assignedPan.InstanceId" />
                </div>

                <div class="pans-page__assigned-pan-header">
                    <div class="pans-page__assigned-pan-copy">
                        <div class="pans-page__assigned-pan-copy-group pans-page__assigned-pan-copy-group--left">
                            <div class="pans-page__assigned-pan-copy-label">Pan</div>
                            <div class="pans-page__assigned-pan-type">
                                @assignedPan.Assignment.AssignedPanType.ToSpacedPascal()
                            </div>
                        </div>

                        <div class="pans-page__assigned-pan-copy-group pans-page__assigned-pan-copy-group--right">
                            <div class="pans-page__assigned-pan-copy-label">Track</div>
                            <div class="pans-page__assigned-pan-track">
                                @assignedPan.Assignment.Track?.Name
                            </div>
                        </div>
                    </div>

                    <button type="button"
                            class="pans-page__remove-pan-button"
                            title="Remove pan"
                            aria-label="Remove pan"
                            data-pan-layout-no-drag
                            @onclick="() => OnRemovePan.InvokeAsync(assignedPan)">
                        <span class="bi bi-trash3"></span>
                    </button>
                </div>
            </section>
        }
    </div>
</div>

@code {
    [Parameter, EditorRequired]
    public IReadOnlyList<MidiAssignedPan> Pans { get; set; } = [];

    [Parameter]
    public EventCallback<MidiAssignedPan> OnRemovePan { get; set; }

    [Parameter]
    public EventCallback<IReadOnlyList<Guid>> OnPansReordered { get; set; }

    private ElementReference assignedPansElement_;
    private DotNetObjectReference<PansDisplay>? dotNetReference_;
    private bool panLayoutObserved_;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender)
            return;

        dotNetReference_ = DotNetObjectReference.Create(this);
        await JS.InvokeVoidAsync("panLayout.observe", assignedPansElement_, dotNetReference_);
        panLayoutObserved_ = true;
    }

    [JSInvokable]
    public async Task NotifyPansReordered(IReadOnlyList<string> panIds)
    {
        if (!OnPansReordered.HasDelegate)
            return;

        var orderedIds = panIds
            .Select(id => Guid.TryParse(id, out var guid) ? guid : (Guid?)null)
            .Where(id => id.HasValue)
            .Select(id => id!.Value)
            .ToArray();

        await OnPansReordered.InvokeAsync(orderedIds);
    }

    public async ValueTask DisposeAsync()
    {
        if (panLayoutObserved_)
        {
            try
            {
                await JS.InvokeVoidAsync("panLayout.disconnect", assignedPansElement_);
            }
            catch (InvalidOperationException)
            {
                // JS interop is not available during prerender/static disposal.
            }
            catch (JSDisconnectedException)
            {
                // Circuit/browser already disconnected.
            }
        }

        dotNetReference_?.Dispose();
    }
}
