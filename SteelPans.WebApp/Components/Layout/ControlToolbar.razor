@inject MidiManagerService MidiService
@inject NavigationManager Nav
@inject ModalPopupService Modals
@inject DbService Db
@inject UserStateService UserState
@inject IJSRuntime JS
@implements IDisposable

<Toolbar @ref="toolbar_"
         ClosedIconClass="bi-gear-fill"
         MenuButtonLabel="Open Tools"
         MenuLabel="Pan Tools"
         ToolbarSide="Toolbar.Side.Left">

    <ToolbarElement Order="1"
                    Text="Import">
        <SubMenu>
            <AuthorizeView>
                <Authorized>
                    @if (UserState.Groups.Any(x => x.Files.Any()))
                    {
                        <ToolbarElement Order="1"
                                        Text="From Group"
                                        IconClass="bi-collection">
                            <SubMenu>
                                @foreach (var group in UserState.Groups.Where(x => x.Files.Any()))
                                {
                                    <ToolbarElement Text="@group.Summary.Name"
                                                    IconClass="bi-people">
                                        <ChildContent>
                                            <MidiTrackList Files="@group.Files" />
                                        </ChildContent>
                                    </ToolbarElement>
                                }
                            </SubMenu>
                        </ToolbarElement>
                    }
                </Authorized>
            </AuthorizeView>

            <ToolbarElement Order="2"
                            Text="MIDI File"
                            IconClass="bi-file-earmark-music"
                            CloseOnAction="true"
                            LabelFor="midi-file-input" />

            <FileInput Id="midi-file-input"
                       OnSingleFileLoad="OnSingleMidiSelectedAsync"
                       OnMultipleFileLoad="OnMultipleMidiSelectedAsync"
                       Extensions="Midi.Extensions" />
        </SubMenu>
    </ToolbarElement>

    <ToolbarElement Order="2"
                    Text="Pans">
        <SubMenu>
            <ToolbarElement Order="1"
                            Text="Add"
                            IconClass="bi-plus-lg"
                            OnClick="OpenAddPanAsync" />

                            
            @if (MidiService.Playback.IsMidiLoaded)
            {
                <ToolbarElement Order="2"
                                Text="Tracks"
                                IconClass="bi-music-note-list"
                                Disabled="@(!MidiService.Playback.Tracks.Any())"
                                CanExpand="true">
                    <ChildContent>
                        <MidiTrackList Tracks="@MidiService.Playback.Tracks"/>
                    </ChildContent>
                </ToolbarElement>
            }
        </SubMenu>
    </ToolbarElement>

    @if (MidiService.Playback.ActivePans.Any())
    {
        <ToolbarElement Order="3"
                        Text="Music">
            <SubMenu>
                <ToolbarElement Order="1"
                                Text="Mixer"
                                IconClass="bi-sliders2-vertical"
                                Disabled="@(!MidiService.Playback.ActivePans.Any())"
                                CanExpand="true"
                                CanMoveExpanded="true">
                    <ChildContent>
                        <VolumeMixer />
                    </ChildContent>
                </ToolbarElement>
                <ToolbarElement Order="2"
                                Text="Metronome"
                                IconClass="bi-clock">
                    <HeaderActions>
                        <ToggleSwitch Value="@MidiService.Playback.ClickTrackEnabled"
                                      ValueChanged="OnClickTrackEnabledShellChangedAsync"
                                      AriaLabel="Enable Metronome" />
                    </HeaderActions>
                    <ChildContent>
                        <Metronome />
                    </ChildContent>
                </ToolbarElement>

                <ToolbarElement Order="3"
                                Text="Chords"
                                IconClass="bi-music-note-beamed">
                    <ChildContent>
                        <ChordBuilder />
                    </ChildContent>
                </ToolbarElement>
            </SubMenu>
        </ToolbarElement>
    }
</Toolbar>

    @code {
    private Toolbar? toolbar_;

    private bool anyPans_;

    protected override async Task OnInitializedAsync()
    {
        MidiService.Playback.AssignmentsChanged += OnAssignmentsChangedAsync;
        anyPans_ = MidiService.Playback.ActivePans.Any();
    }

    private async Task OnAssignmentsChangedAsync(MidiEventArgs.AssignmentsChanged args)
    {
        if (anyPans_ && !MidiService.Playback.ActivePans.Any())
        {
            anyPans_ = false;
            await InvokeAsync(StateHasChanged);
        }
        else if (!anyPans_ && MidiService.Playback.ActivePans.Any())
        {
            anyPans_ = true;
            await InvokeAsync(StateHasChanged);
        }
    }

    private async Task OpenLogoutAsync()
    {
        await Modals.OpenAsync("Logout");
    }

    private async Task OpenAddPanAsync()
    {
        await Modals.OpenAsync("AddPan");
    }

    private async Task OpenSaveLayoutAsync()
    {
        await Modals.OpenAsync("SaveLayout");
    }




    private void NavigateToLogin()
    {
        Nav.NavigateTo("/account/login", forceLoad: true);
    }
    private void NavigateToRegister()
    {
        Nav.NavigateTo("/account/register", forceLoad: true);
    }
    private void NavigateToProfile()
    {
        Nav.NavigateTo("/account/profile");
    }




    private async Task OnMultipleMidiSelectedAsync(IReadOnlyList<IBrowserFile> files)
    {
        await toolbar_!.RequestCloseAsync();
        await Modals.OpenAsync("MergeMidiFiles", files);
    }

    private async Task OnSingleMidiSelectedAsync(IBrowserFile file)
    {
        await toolbar_!.RequestCloseAsync();
        await MidiService.Playback.OnLoadMidiAsync(async () =>
        {
            await using var stream = file.OpenReadStream(UserState.MaxMidiFileSize);
            using var midiStream = await MidiService.Files.OpenMidiFileAsync(stream);
            return (Guid.NewGuid(), file.Name, MidiFile.Read(midiStream));
        });
    }



    private async Task OnClickTrackEnabledShellChangedAsync(bool enabled)
    {
        if (MidiService.Playback.ClickTrackEnabled == enabled)
            return;

        await MidiService.Playback.SetClickTrackEnabledAsync(enabled);
    }



    public void Dispose()
    {
        MidiService.Playback.AssignmentsChanged -= OnAssignmentsChangedAsync;
    }
}