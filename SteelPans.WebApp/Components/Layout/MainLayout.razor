@inherits LayoutComponentBase
@inject SteelPanLoaderService PanLoader
@inject SteelPanSvgService PanSvgs
@inject MidiPlaybackService Playback

<div class="page">
    <div class="sidebar">
        <NavMenu />
    </div>

    <main>
        <article class="content">
            @Body
        </article>
    </main>

    <aside>
        <ModalLayout />
